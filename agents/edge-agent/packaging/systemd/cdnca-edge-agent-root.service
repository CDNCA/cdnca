[Unit]
Description=CDNCA edge control agent (native root runtime)
Documentation=file:///usr/share/doc/cdnca-edge-agent/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
# Soft Go heap limit: past it the runtime collects harder
# instead of letting the heap double (GOGC=100), so a memory growth bug in the
# Agent meets GC pressure before it can take the node's RAM. 4GiB is far above
# normal use (130-200 MiB idle; 0.77-1.12 GiB RSS at 100k dynamic-routing
# sites; a full event spool costs ~500 B RSS per pending record, ~700 MiB at
# the 2 GiB disk limit with 1.6 KB access events), so normal operation never
# reaches it; on the 8 GB
# recommended node it keeps the Agent under half the RAM. It is a soft limit:
# it never kills the Agent. agent.env (EnvironmentFile, read later) overrides it.
# No MemoryHigh here: the OpenResty master the Agent starts lives in this
# unit's cgroup and its page cache (cached responses) is charged to it, so a
# cgroup memory limit would throttle and reclaim OpenResty in normal operation.
Environment=GOMEMLIMIT=4GiB
EnvironmentFile=/etc/cdnca-edge-agent/agent.env
ExecStartPre=/usr/libexec/cdnca-edge-agent/preflight.sh
ExecStart=/usr/lib/cdnca-edge-agent/current/edge-agent -config ${CDNCA_EDGE_CONFIG}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
# Stop/restart signal only the Agent itself. The L4 OpenResty master it
# starts must survive Agent restarts and upgrades without dropping
# established TCP/UDP sessions; the next Agent adopts it by its pid file and
# kernel identity. uninstall.sh stops what remains in this unit's cgroup.
KillMode=process
# The auto defense decision loop raises its own thread to nice -5 (ADR 0010
# section 10.4, user 10-26 fix-adload): a flood takes the node's CPU through
# the OpenResty workers, and the loop deciding the defence must not starve.
# The OpenResty masters the Agent starts come from other threads and keep the
# default nice. RLIMIT_NICE allows it without CAP_SYS_NICE (non-root unit).
LimitNICE=-5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
BindPaths=/var/lib/cdnca-edge-agent-backups/active-state:/var/lib/cdnca-edge-agent:norbind
ReadWritePaths=/etc/cdnca-edge-agent
ReadOnlyPaths=/etc/cdnca-edge-agent/package-signing.pem -/etc/cdnca-edge-agent/helper-receipt-public.json

[Install]
WantedBy=multi-user.target
