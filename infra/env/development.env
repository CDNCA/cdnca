# Local development only. Never reuse these values in staging or production.
POSTGRES_DB=cdnca
POSTGRES_USER=cdnca
POSTGRES_PASSWORD=cdnca-local-only
POSTGRES_PORT=5432

REDIS_PASSWORD=cdnca-local-only
REDIS_PORT=6379

CLICKHOUSE_DB=cdnca
CLICKHOUSE_USER=cdnca
CLICKHOUSE_PASSWORD=cdnca-local-only
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# The legacy pair is retained for smoke scripts that publish analytics data.
NATS_USERNAME=cdnca-publisher
NATS_PASSWORD=cdnca-publisher-local-only
NATS_PREPROVISION_USERNAME=cdnca-preprovision
NATS_PREPROVISION_PASSWORD=cdnca-preprovision-local-only
NATS_RUNTIME_USERNAME=cdnca-runtime
NATS_RUNTIME_PASSWORD=cdnca-runtime-local-only
NATS_PUBLISHER_USERNAME=cdnca-publisher
NATS_PUBLISHER_PASSWORD=cdnca-publisher-local-only
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# License service (external; its code is not part of the community edition).
# Leave LICENSE_SERVICE_URL empty to run without entitlement sync. Until a
# community lease is imported, control-api feature gates deny requests; this
# is expected. To use a license locally:
#   1. Activate a community edition license for this installation on the
#      official license service (installation ID below; the installation key is
#      generated by scripts/local-stack.sh at <state>/secrets/control-installation-key.pem).
#   2. Import the signed bundle and the published trusted keys:
#        scripts/local-stack.sh install-entitlement BUNDLE.json TRUSTED-KEYS.json
#      (runs `control-api install-entitlement` and points
#      ENTITLEMENT_TRUSTED_KEYS_FILE at the imported keys), then `make up`.
#   3. Optionally set LICENSE_SERVICE_URL (HTTPS origin) for lease sync.
LICENSE_SERVICE_URL=
# Container path; set automatically by `local-stack.sh install-entitlement`.
ENTITLEMENT_TRUSTED_KEYS_FILE=
CONTROL_INSTALLATION_ID=70000000-0000-4000-8000-000000000001
CONTROL_INSTALLATION_NAME=cdnca-local-control
