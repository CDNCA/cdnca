{
 "schema": "cdnca.rule-pack/v1",
 "pack_id": "system/bot-ai-crawler",
 "version": "1.0.0",
 "layer": "system",
 "engine": "waf_v2",
 "engine_min_version": 1,
 "name": "AI 爬虫",
 "description": "UA 含 AI 训练/检索爬虫标识（不区分大小写）即记录，可改为拦截或挑战。来源 ai-robots-txt/ai.robots.txt（MIT）robots.json",
 "params_schema": {
  "action": {
   "type": "string",
   "enum": [
    "log",
    "block",
    "challenge"
   ],
   "bind": {
    "target": "waf.action",
    "rules": []
   }
  }
 },
 "exports": [
  "ai-crawler-00",
  "ai-crawler-01",
  "ai-crawler-02"
 ],
 "rules": [
