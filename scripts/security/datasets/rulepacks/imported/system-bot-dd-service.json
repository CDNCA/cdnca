{
 "schema": "cdnca.rule-pack/v1",
 "pack_id": "system/bot-dd-service",
 "version": "1.0.0",
 "layer": "system",
 "engine": "waf_v2",
 "engine_min_version": 1,
 "name": "搜索/监控/服务类 Bot（device-detector）",
 "description": "UA 含搜索引擎（已知良性爬虫已剔除）、站点监控、服务代理、订阅抓取、链接预览、校验器等 Bot 标识即记录；多为正常自动化访问，建议只记录或按需挑战。",
 "params_schema": {
  "action": {
   "type": "string",
   "enum": [
    "log",
    "block",
    "challenge"
   ],
   "bind": {
    "target": "waf.action",
    "rules": []
   }
  }
 },
 "exports": [
  "dd-service-00",
  "dd-service-01",
  "dd-service-02",
  "dd-service-r00",
  "dd-service-r01",
  "dd-service-r02",
  "dd-service-r03"
 ],
