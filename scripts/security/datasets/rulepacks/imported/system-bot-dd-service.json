  },
  {
   "id": "dd-service-r00",
   "name": "搜索/监控/服务类 Bot 正则第 1 组",
   "waf": {
    "match": {
     "inspect": [
      {
       "target": "user_agent",
       "operator": "regex",
       "values": [
        "(?i)(?:^|[^A-Z0-9_-]|[^A-Z0-9-]_|sprd-|MZ-)(?:(360Spider(?:-Image|-Video)?)|Baidu.*spider|baidu Transcoder|Cloudflare-?Diagnostics|Datadog Agent|Datadog/?Synthetics|^Google$|vuhuv(?:Bot|RBT)|[A-z0-9]*-Lighthouse|Netcraft(?: Web Server Survey| SSL Server Survey|SurveyAgent)|NewsBlur .*(?:Fetcher|Finder)|Pocket(?:ImageCache|Parser)|Pingdom(?:\\.com|TMS)|Sogou[ -](?:head|inst|Orion|Pic|Test|web)[ -]spider|New-Sogou-Spider|Uptime(?:bot)?/|websitepulse[+ ]checker)"
       ]
      }
     ]
    },
    "action": "log",
    "flow": "continue"
   }
  },
  {
   "id": "dd-service-r01",
   "name": "搜索/监控/服务类 Bot 正则第 2 组",
   "waf": {
    "match": {
     "inspect": [
      {
       "target": "user_agent",
       "operator": "regex",
       "values": [
        "(?i)(?:^|[^A-Z0-9_-]|[^A-Z0-9-]_|sprd-|MZ-)(?:(Yandex(?:(?:\\.Gazeta |Accessibility|Com|Mobile|MobileScreenShot|RenderResources|Screenshot|Sprav)?Bot|(?:AdNet|Antivirus|Blogs|Calendar|Catalog|Dialogs|Direct(?:Dyn)?|Favicons|ForDomain|ImageResizer|Images|Market|Media(?:naBot)?|Metrika|News(?:links)?|OntoDB(?:API)?|Pagechecker|Partner|RCA|SearchShop|(?:News|Site)links|Tracker|Turbo|Userproxy|Verticals|Vertis|Video(?:Parser)?|Webmaster))|YaDirectFetcher)|.*Site24x7|.* HLB|Awario(?:Smart)?Bot)"
       ]
      }
     ]
    },
    "action": "log",
    "flow": "continue"
   }
  },
  {
   "id": "dd-service-r02",
   "name": "搜索/监控/服务类 Bot 正则第 3 组",
   "waf": {
    "match": {
     "inspect": [
      {
       "target": "user_agent",
       "operator": "regex",
       "values": [
        "(?i)(?:^|[^A-Z0-9_-]|[^A-Z0-9-]_|sprd-|MZ-)(?:presearch[._]com|ias-(?:va|sg).*admantx.*service-fetcher|admantx\\.com.*service-fetcher|notifyninja.+monitoring|rocketmonitor(?:bot)?|DMBrowser|DMBrowser-[UB]V)"
       ]
      }
     ]
    },
    "action": "log",
    "flow": "continue"
   }
  },
  {
   "id": "dd-service-r03",
   "name": "搜索/监控/服务类 Bot 正则第 4 组",
   "waf": {
    "match": {
     "inspect": [
      {
       "target": "user_agent",
       "operator": "regex",
       "values": [
        "(?i)(?:^|[^A-Z0-9_-]|[^A-Z0-9-]_|sprd-|MZ-)(?:Overcast/.+Podcast Sync|^Verity|Matomo/[\\d.]+|Grafana/(\\d+\\.[.\\d]+))"
       ]
      }
     ]
    },
    "action": "log",
    "flow": "continue"
   }
  }
 ],
 "defaults": {
  "action": "log"
 }
}