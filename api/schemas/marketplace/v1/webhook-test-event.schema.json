      "X-CDNCA-Webhook-Key-Id": "018cc251-f400-7def-8000-000000000011",
      "X-CDNCA-Webhook-Signature-Version": "v2",
      "X-CDNCA-Webhook-Signature": "v2=VgARCiCHvvwQHdzbKrvVyC5bP-6px3-tRz1z4rS2LQo",
      "X-CDNCA-Idempotency-Key": "plugin-webhook-v2-557dba69d2d1f24d0dc523fbde9c672431d21702e1428a9a53596df4bb90c911",
      "X-CDNCA-Webhook-Attempt": "1"
    },
    "signing_input": "cdnca.webhook.signature/v2\nPOST\n/cdnca/hooks\n1704067200\n018cc251-f400-7def-8000-000000000001\n018cc251-f400-7def-8000-000000000002\n018cc251-f400-7def-8000-000000000011\na151948885c16b99e9baf2836b61a9ad29ebf5bb3e993f2517cf8901120662a3"
  }
}
