#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly MANIFEST_SCHEMA="cdnca.control-backup/v3"
readonly REMOTE_COMMIT_SCHEMA="cdnca.control-backup.remote-commit/v1"
readonly TOOL_VERSION="3.0.0"
readonly PG_IMAGE="postgres:17.9-bookworm@sha256:47f917f7409eacd22fc5dfb1dee634e1b55cf0c01d1a7eb701be2227a03e0641"
readonly CLICKHOUSE_IMAGE="clickhouse/clickhouse-server:25.3.6.56-alpine@sha256:157423fca52f596b62a1bf301b037b9f74bfca38089aa57d1bd36c9025f7ecef"
readonly RESTORE_GUARD="__cdnca_control_restore_guard"
readonly MIN_FREE_BYTES=$((16 * 1024 * 1024))
readonly REMOTE_RETENTION_UPLOAD_SAFETY_SECONDS=300

WORK_DIR=""
BACKUP_TMP=""
BACKUP_OUTPUT_DIR=""
PUBLISHED_DIR=""
PG_SNAPSHOT_PID=""
PG_SNAPSHOT_FDS_OPEN="false"
PG_SNAPSHOT_ID=""
PG_SNAPSHOT_METRICS_FILE=""
PARENT_FSYNC_INJECTED="false"
CLIENT_MODE=""
VERIFIED_DUMP=""
MANIFEST_DATABASE=""
MANIFEST_SERVER_VERSION_NUM=""
MANIFEST_APP_VERSION=""
MANIFEST_MIGRATION_VERSIONS=""
MANIFEST_MIGRATION_FINGERPRINT=""
MANIFEST_BACKUP_ID=""
MANIFEST_SOURCE_CLUSTER_ID=""
MANIFEST_SHA256=""
MANIFEST_CLICKHOUSE_PRESENT="false"
VERIFIED_BUNDLE=""
CLICKHOUSE_CLIENT_MODE=""
CLICKHOUSE_COMPONENT_FILE=""
REMOTE_ENDPOINT=""
REMOTE_REGION=""
REMOTE_BUCKET=""
REMOTE_PREFIX=""
REMOTE_CREDENTIALS_FILE=""
REMOTE_RETENTION_MODE=""
REMOTE_RETENTION_DAYS=""
REMOTE_ENABLED="false"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  control-backup backup --output-dir ABSOLUTE_DIR --app-version VERSION \
    --migrations-dir ABSOLUTE_DIR --source-cluster-id ID \
    --age-recipient AGE_RECIPIENT --signing-private-key-file ABSOLUTE_FILE \
    --signing-key-id ID [--clickhouse-database NAME] \
    [--remote-endpoint URL --remote-region REGION --remote-bucket BUCKET \
     --remote-prefix PREFIX --remote-credentials-file ABSOLUTE_FILE \
     --remote-retention-mode COMPLIANCE --remote-retention-days DAYS]
  control-backup remote-fetch --output-dir ABSOLUTE_DIR \
    --remote-endpoint URL --remote-region REGION --remote-bucket BUCKET \
    --remote-prefix PREFIX --remote-credentials-file ABSOLUTE_FILE \
    --remote-retention-mode COMPLIANCE --remote-retention-days DAYS \
    --expected-app-version VERSION --migrations-dir ABSOLUTE_DIR \
    --expected-source-cluster-id ID --expected-backup-id ID \
    --expected-manifest-sha256 SHA256 --age-identity-file ABSOLUTE_FILE \
    --signing-public-key-file ABSOLUTE_FILE --expected-signing-key-id ID
  control-backup verify --bundle ABSOLUTE_DIR --expected-app-version VERSION \
    --migrations-dir ABSOLUTE_DIR --expected-source-cluster-id ID \
    --expected-backup-id ID --expected-manifest-sha256 SHA256 \
    --age-identity-file ABSOLUTE_FILE --signing-public-key-file ABSOLUTE_FILE \
    --expected-signing-key-id ID
  control-backup restore --bundle ABSOLUTE_DIR --target-database NAME \
    --confirm-empty-target NAME --expected-app-version VERSION \
    --migrations-dir ABSOLUTE_DIR --expected-source-cluster-id ID \
    --expected-backup-id ID --expected-manifest-sha256 SHA256 \
    --postgresql-target-free-bytes BYTES --age-identity-file ABSOLUTE_FILE \
    --signing-public-key-file ABSOLUTE_FILE --expected-signing-key-id ID \
    [--clickhouse-target-database NAME --confirm-empty-clickhouse-target NAME]

Database commands read PGHOST, PGPORT, PGUSER, PGDATABASE and PGSSLMODE.
Authentication must come from PGPASSFILE, PGPASSWORD_FILE, or PGPASSWORD.
CONTROL_BACKUP_CLIENT_MODE may be auto (default), native, or docker.
ClickHouse commands read CLICKHOUSE_HOST, CLICKHOUSE_PORT, CLICKHOUSE_USER,
CLICKHOUSE_SECURE and CLICKHOUSE_PASSWORD or CLICKHOUSE_PASSWORD_FILE.
CONTROL_BACKUP_CLICKHOUSE_CLIENT_MODE may be auto, native, or docker.
EOF
  exit 2
}

cleanup() {
  local status=$?
  trap - EXIT
  close_pg_snapshot abort >/dev/null 2>&1 || true
  if [[ -n "$PUBLISHED_DIR" && -d "$PUBLISHED_DIR" ]]; then
    rm -rf -- "$PUBLISHED_DIR" || status=1
    if [[ -n "$BACKUP_OUTPUT_DIR" && -d "$BACKUP_OUTPUT_DIR" ]]; then
      fsync_path "$BACKUP_OUTPUT_DIR" >/dev/null 2>&1 || status=1
    fi
  fi
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf -- "$WORK_DIR"
  fi
  if [[ -n "$BACKUP_TMP" && -d "$BACKUP_TMP" ]]; then
    rm -rf -- "$BACKUP_TMP" || status=1
    if [[ -n "$BACKUP_OUTPUT_DIR" && -d "$BACKUP_OUTPUT_DIR" ]]; then
      fsync_path "$BACKUP_OUTPUT_DIR" >/dev/null 2>&1 || status=1
    fi
  fi
  exit "$status"
}
trap cleanup EXIT

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

reject_symlink_components() {
  local path=$1 current="/" part
  local old_ifs=$IFS
  local -a parts
  IFS='/' read -r -a parts <<< "$path"
  IFS=$old_ifs
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    if [[ "$current" == "/" ]]; then
      current="/$part"
    else
      current="$current/$part"
    fi
    [[ ! -L "$current" ]] || die "symlink path component is not allowed: $current"
  done
}

validate_absolute_path() {
  local path=$1 label=$2
  [[ "$path" == /* ]] || die "$label must be an absolute path"
  [[ "$path" != *:* ]] || die "$label must not contain a colon"
  [[ "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *$'\t'* ]] ||
    die "$label contains control characters"
  [[ "/$path/" != *"/../"* && "/$path/" != *"/./"* ]] ||
    die "$label must not contain dot path components"
  reject_symlink_components "$path"
}

validate_directory() {
  local path=$1 label=$2
  validate_absolute_path "$path" "$label"
  [[ -d "$path" ]] || die "$label is not a directory: $path"
}

file_mode() {
  if stat -f '%OLp' "$1" >/dev/null 2>&1; then
    stat -f '%OLp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

file_owner_uid() {
  if stat -f '%u' "$1" >/dev/null 2>&1; then
    stat -f '%u' "$1"
  else
    stat -c '%u' "$1"
  fi
}

validate_secret_file() {
  local path=$1 label=$2 mode owner
  validate_absolute_path "$path" "$label"
  [[ -f "$path" && ! -L "$path" ]] || die "$label must be a regular non-symlink file"
  owner=$(file_owner_uid "$path")
  [[ "$owner" == "$(id -u)" || "$owner" == "0" ]] ||
    die "$label must be owned by the current user or root"
  mode=$(file_mode "$path")
  (( (8#$mode & 0077) == 0 )) ||
    die "$label must not be accessible by group/world (found mode $mode)"
  [[ -r "$path" ]] || die "$label is not readable"
}

validate_remote_credentials_file() {
  local path=$1 mode owner
  validate_absolute_path "$path" "remote credentials file"
  [[ -f "$path" && ! -L "$path" ]] ||
    die "remote credentials file must be a regular non-symlink file"
  owner=$(file_owner_uid "$path")
  [[ "$owner" == "$(id -u)" || "$owner" == "0" ]] ||
    die "remote credentials file must be owned by the current user or root"
  mode=$(file_mode "$path")
  [[ "$mode" == "400" ]] || die "remote credentials file must have mode 0400 (found mode $mode)"
  [[ -r "$path" ]] || die "remote credentials file is not readable"
}

validate_public_file() {
  local path=$1 label=$2
  validate_absolute_path "$path" "$label"
  [[ -f "$path" && ! -L "$path" && -r "$path" ]] ||
    die "$label must be a readable regular non-symlink file"
}

validate_version() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$ ]] || die "invalid app version"
}

validate_cluster_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]] || die "invalid source cluster ID"
}

validate_backup_id() {
  [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] ||
    die "invalid backup ID"
}

validate_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || die "invalid SHA256 digest"
}

validate_remote_config() {
  local required=$1 count=0 value component old_ifs
  local -a components
  for value in "$REMOTE_ENDPOINT" "$REMOTE_REGION" "$REMOTE_BUCKET" "$REMOTE_PREFIX" \
    "$REMOTE_CREDENTIALS_FILE" "$REMOTE_RETENTION_MODE" "$REMOTE_RETENTION_DAYS"; do
    [[ -z "$value" ]] || count=$((count + 1))
  done
  if ((count == 0)) && [[ "$required" == "false" ]]; then
    REMOTE_ENABLED="false"
    return
  fi
  ((count == 7)) || die "remote options must be supplied together"
  if [[ "$REMOTE_ENDPOINT" =~ ^http://[^/@?#[:space:]]+(:[0-9]{1,5})?$ ]]; then
    [[ "${CONTROL_BACKUP_ENABLE_TEST_HOOKS:-}" == "1" ]] ||
      die "remote endpoint must use HTTPS outside test hooks"
  elif [[ ! "$REMOTE_ENDPOINT" =~ ^https://[^/@?#[:space:]]+(:[0-9]{1,5})?$ ]]; then
    die "remote endpoint is invalid"
  fi
  [[ "$REMOTE_REGION" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] || die "remote region is invalid"
  [[ "$REMOTE_BUCKET" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ &&
    "$REMOTE_BUCKET" != *..* ]] || die "remote bucket is invalid"
  [[ "$REMOTE_PREFIX" =~ ^[A-Za-z0-9]([A-Za-z0-9._/-]{0,254}[A-Za-z0-9_])?$ &&
    "$REMOTE_PREFIX" != *//* ]] || die "remote prefix is invalid"
  old_ifs=$IFS
  IFS='/' read -r -a components <<< "$REMOTE_PREFIX"
  IFS=$old_ifs
  for component in "${components[@]}"; do
    [[ "$component" != "." && "$component" != ".." ]] || die "remote prefix contains a dot component"
  done
  validate_remote_credentials_file "$REMOTE_CREDENTIALS_FILE"
  [[ "$REMOTE_RETENTION_MODE" == "COMPLIANCE" ]] ||
    die "remote retention mode must be COMPLIANCE"
  [[ "$REMOTE_RETENTION_DAYS" =~ ^[1-9][0-9]{0,4}$ ]] || die "remote retention days is invalid"
  require_command aws
  REMOTE_ENABLED="true"
}

validate_database_name() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_-]{0,62}$ ]] || die "invalid database name"
}

validate_clickhouse_identifier() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]{0,62}$ ]] || die "invalid ClickHouse identifier"
}

validate_clickhouse_data_database() {
  validate_clickhouse_identifier "$1"
  case "$1" in
    system | information_schema | INFORMATION_SCHEMA | default)
      die "reserved ClickHouse database is not allowed" ;;
  esac
}

validate_age_recipient() {
  [[ "$1" =~ ^age1[023456789acdefghjklmnpqrstuvwxyz]{20,90}$ ]] ||
    die "only a standard age X25519 recipient is accepted"
}

validate_db_environment() {
  PGPORT=${PGPORT:-5432}
  PGSSLMODE=${PGSSLMODE:-prefer}
  export PGPORT PGSSLMODE

  [[ -n "${PGHOST:-}" && "$PGHOST" =~ ^[A-Za-z0-9._:/-]+$ ]] || die "PGHOST is missing or invalid"
  if [[ ! "$PGPORT" =~ ^[0-9]{1,5}$ ]] || ((PGPORT < 1 || PGPORT > 65535)); then
    die "PGPORT is invalid"
  fi
  [[ -n "${PGUSER:-}" && "$PGUSER" =~ ^[A-Za-z_][A-Za-z0-9_.-]{0,62}$ ]] || die "PGUSER is missing or invalid"
  [[ -n "${PGDATABASE:-}" ]] || die "PGDATABASE is required"
  validate_database_name "$PGDATABASE"
  case "$PGSSLMODE" in
    disable | allow | prefer | require | verify-ca | verify-full) ;;
    *) die "PGSSLMODE is invalid" ;;
  esac

  if [[ -n "${PGPASSFILE:-}" ]]; then
    validate_secret_file "$PGPASSFILE" "PGPASSFILE"
  elif [[ -n "${PGPASSWORD_FILE:-}" ]]; then
    validate_secret_file "$PGPASSWORD_FILE" "PGPASSWORD_FILE"
    PGPASSWORD=$(< "$PGPASSWORD_FILE")
    export PGPASSWORD
  elif [[ -z "${PGPASSWORD:-}" ]]; then
    die "set PGPASSFILE, PGPASSWORD_FILE, or PGPASSWORD for non-interactive authentication"
  fi
  [[ -z "${PGPASSWORD:-}" || (${#PGPASSWORD} -le 512 && "$PGPASSWORD" != *$'\n'* &&
    "$PGPASSWORD" != *$'\r'*) ]] || die "PostgreSQL password is invalid"

  unset PGOPTIONS PGSERVICE PGSERVICEFILE
  export PGCONNECT_TIMEOUT=10 PGAPPNAME=cdnca-control-backup
}

select_client_mode() {
  local need_dump=${1:-false}
  local requested=${CONTROL_BACKUP_CLIENT_MODE:-auto}
  case "$requested" in
    auto)
      if command -v psql >/dev/null 2>&1 && command -v pg_restore >/dev/null 2>&1 &&
        { [[ "$need_dump" == "false" ]] || command -v pg_dump >/dev/null 2>&1; }; then
        CLIENT_MODE=native
      else
        CLIENT_MODE=docker
      fi
      ;;
    native | docker) CLIENT_MODE=$requested ;;
    *) die "CONTROL_BACKUP_CLIENT_MODE must be auto, native, or docker" ;;
  esac

  if [[ "$CLIENT_MODE" == "native" ]]; then
    require_command psql
    require_command pg_restore
    [[ "$need_dump" == "false" ]] || require_command pg_dump
  else
    require_command docker
    docker image inspect "$PG_IMAGE" >/dev/null 2>&1 ||
      die "pinned PostgreSQL client image is unavailable: $PG_IMAGE"
  fi
}

docker_pg_args() {
  DOCKER_PG_ARGS=(run --rm -i
    -e PGHOST -e PGPORT -e PGUSER -e PGDATABASE -e PGSSLMODE
    -e PGCONNECT_TIMEOUT -e PGAPPNAME)
  if [[ -n "${CONTROL_BACKUP_DOCKER_NETWORK:-}" ]]; then
    [[ "$CONTROL_BACKUP_DOCKER_NETWORK" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$ ]] ||
      die "CONTROL_BACKUP_DOCKER_NETWORK is invalid"
    DOCKER_PG_ARGS+=(--network "$CONTROL_BACKUP_DOCKER_NETWORK")
  fi
  if [[ "$PGHOST" == /* ]]; then
    if [[ -n "${CONTROL_BACKUP_POSTGRES_SOCKET_VOLUME:-}" ]]; then
      [[ "$CONTROL_BACKUP_POSTGRES_SOCKET_VOLUME" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$ ]] ||
        die "CONTROL_BACKUP_POSTGRES_SOCKET_VOLUME is invalid"
      DOCKER_PG_ARGS+=(-v "$CONTROL_BACKUP_POSTGRES_SOCKET_VOLUME:$PGHOST")
    else
      validate_directory "$PGHOST" "PostgreSQL socket directory"
      DOCKER_PG_ARGS+=(-v "$PGHOST:$PGHOST")
    fi
  fi
  if [[ -n "${PGPASSFILE:-}" ]]; then
    DOCKER_PG_ARGS+=(-v "$PGPASSFILE:/run/secrets/pgpass:ro" -e PGPASSFILE=/run/secrets/pgpass)
  else
    DOCKER_PG_ARGS+=(-e PGPASSWORD)
  fi
}

run_psql() {
  if [[ "$CLIENT_MODE" == "native" ]]; then
    psql -X -w -v ON_ERROR_STOP=1 "$@"
  else
    local -a DOCKER_PG_ARGS
    docker_pg_args
    docker "${DOCKER_PG_ARGS[@]}" "$PG_IMAGE" psql -X -w -v ON_ERROR_STOP=1 "$@"
  fi
}

psql_value() {
  run_psql -Atq -c "$1"
}

run_pg_dump() {
  local output=$1 snapshot_id=$2 output_dir output_name
  output_dir=$(dirname "$output")
  output_name=$(basename "$output")
  if [[ "$CLIENT_MODE" == "native" ]]; then
    pg_dump -w --format=custom --compress=gzip:6 --snapshot="$snapshot_id" \
      --no-owner --no-privileges --file="$output"
  else
    local -a DOCKER_PG_ARGS
    docker_pg_args
    docker "${DOCKER_PG_ARGS[@]}" -v "$output_dir:/backup-output" "$PG_IMAGE" \
      pg_dump -w --format=custom --compress=gzip:6 --snapshot="$snapshot_id" \
      --no-owner --no-privileges --file="/backup-output/$output_name"
  fi
}

run_pg_restore_list() {
  local input=$1 input_dir input_name
  input_dir=$(dirname "$input")
  input_name=$(basename "$input")
  if [[ "$CLIENT_MODE" == "native" ]]; then
    pg_restore --list "$input"
  else
    docker run --rm -i -v "$input_dir:/backup-input:ro" "$PG_IMAGE" \
      pg_restore --list "/backup-input/$input_name"
  fi
}

run_pg_restore_database() {
  local input=$1 input_dir input_name
  input_dir=$(dirname "$input")
  input_name=$(basename "$input")
  if [[ "$CLIENT_MODE" == "native" ]]; then
    pg_restore -w --exit-on-error --single-transaction --no-owner --no-privileges \
      --dbname="$PGDATABASE" "$input"
  else
    local -a DOCKER_PG_ARGS
    docker_pg_args
    docker "${DOCKER_PG_ARGS[@]}" -v "$input_dir:/backup-input:ro" "$PG_IMAGE" \
      pg_restore -w --exit-on-error --single-transaction --no-owner --no-privileges \
      --dbname="$PGDATABASE" \
      "/backup-input/$input_name"
  fi
}

client_major() {
  local output
  if [[ "$CLIENT_MODE" == "native" ]]; then
    output=$(pg_restore --version)
  else
    output=$(docker run --rm "$PG_IMAGE" pg_restore --version)
  fi
  [[ "$output" =~ ([0-9]+)\.([0-9]+) ]] || die "cannot parse PostgreSQL client version"
  printf '%s\n' "${BASH_REMATCH[1]}"
}

validate_clickhouse_environment() {
  CLICKHOUSE_PORT=${CLICKHOUSE_PORT:-9000}
  CLICKHOUSE_SECURE=${CLICKHOUSE_SECURE:-false}
  export CLICKHOUSE_PORT CLICKHOUSE_SECURE

  [[ -n "${CLICKHOUSE_HOST:-}" && "$CLICKHOUSE_HOST" =~ ^[A-Za-z0-9._:-]+$ ]] ||
    die "CLICKHOUSE_HOST is missing or invalid"
  if [[ ! "$CLICKHOUSE_PORT" =~ ^[0-9]{1,5}$ ]] ||
    ((CLICKHOUSE_PORT < 1 || CLICKHOUSE_PORT > 65535)); then
    die "CLICKHOUSE_PORT is invalid"
  fi
  [[ -n "${CLICKHOUSE_USER:-}" && "$CLICKHOUSE_USER" =~ ^[A-Za-z_][A-Za-z0-9_.-]{0,62}$ ]] ||
    die "CLICKHOUSE_USER is missing or invalid"
  case "$CLICKHOUSE_SECURE" in
    true | false) ;;
    *) die "CLICKHOUSE_SECURE must be true or false" ;;
  esac

  if [[ -n "${CLICKHOUSE_PASSWORD_FILE:-}" ]]; then
    validate_secret_file "$CLICKHOUSE_PASSWORD_FILE" "CLICKHOUSE_PASSWORD_FILE"
    CLICKHOUSE_PASSWORD=$(< "$CLICKHOUSE_PASSWORD_FILE")
    export CLICKHOUSE_PASSWORD
  fi
  [[ -n "${CLICKHOUSE_PASSWORD:-}" ]] || die "set CLICKHOUSE_PASSWORD or CLICKHOUSE_PASSWORD_FILE"
  [[ ${#CLICKHOUSE_PASSWORD} -le 512 && "$CLICKHOUSE_PASSWORD" != *$'\n'* &&
    "$CLICKHOUSE_PASSWORD" != *$'\r'* ]] || die "ClickHouse password is invalid"
}

select_clickhouse_client_mode() {
  local requested=${CONTROL_BACKUP_CLICKHOUSE_CLIENT_MODE:-auto}
  case "$requested" in
    auto)
      if command -v clickhouse-client >/dev/null 2>&1; then
        CLICKHOUSE_CLIENT_MODE=native
      else
        CLICKHOUSE_CLIENT_MODE=docker
      fi
      ;;
    native | docker) CLICKHOUSE_CLIENT_MODE=$requested ;;
    *) die "CONTROL_BACKUP_CLICKHOUSE_CLIENT_MODE must be auto, native, or docker" ;;
  esac

  if [[ "$CLICKHOUSE_CLIENT_MODE" == "native" ]]; then
    require_command clickhouse-client
  else
    require_command docker
    docker image inspect "$CLICKHOUSE_IMAGE" >/dev/null 2>&1 ||
      die "pinned ClickHouse client image is unavailable: $CLICKHOUSE_IMAGE"
  fi
}

clickhouse_client_args() {
  local database=$1
  CLICKHOUSE_ARGS=(clickhouse-client --host "$CLICKHOUSE_HOST" --port "$CLICKHOUSE_PORT"
    --user "$CLICKHOUSE_USER" --database "$database" --no-warnings)
  [[ "$CLICKHOUSE_SECURE" == "false" ]] || CLICKHOUSE_ARGS+=(--secure)
}

docker_clickhouse_args() {
  DOCKER_CLICKHOUSE_ARGS=(run --rm)
  if [[ -n "${CONTROL_BACKUP_DOCKER_NETWORK:-}" ]]; then
    [[ "$CONTROL_BACKUP_DOCKER_NETWORK" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$ ]] ||
      die "CONTROL_BACKUP_DOCKER_NETWORK is invalid"
    DOCKER_CLICKHOUSE_ARGS+=(--network "$CONTROL_BACKUP_DOCKER_NETWORK")
  fi
  DOCKER_CLICKHOUSE_ARGS+=(-e CLICKHOUSE_PASSWORD)
}

run_clickhouse_query() {
  local database=$1 query=$2
  local -a CLICKHOUSE_ARGS DOCKER_CLICKHOUSE_ARGS
  clickhouse_client_args "$database"
  if [[ "$CLICKHOUSE_CLIENT_MODE" == "native" ]]; then
    "${CLICKHOUSE_ARGS[@]}" --query "$query"
  else
    docker_clickhouse_args
    docker "${DOCKER_CLICKHOUSE_ARGS[@]}" "$CLICKHOUSE_IMAGE" \
      "${CLICKHOUSE_ARGS[@]}" --query "$query"
  fi
}

run_clickhouse_query_input() {
  local database=$1 query=$2
  local -a CLICKHOUSE_ARGS DOCKER_CLICKHOUSE_ARGS
  clickhouse_client_args "$database"
  if [[ "$CLICKHOUSE_CLIENT_MODE" == "native" ]]; then
    "${CLICKHOUSE_ARGS[@]}" --query "$query"
  else
    docker_clickhouse_args
    DOCKER_CLICKHOUSE_ARGS+=(-i)
    docker "${DOCKER_CLICKHOUSE_ARGS[@]}" "$CLICKHOUSE_IMAGE" \
      "${CLICKHOUSE_ARGS[@]}" --query "$query"
  fi
}

run_clickhouse_input() {
  local database=$1
  local -a CLICKHOUSE_ARGS DOCKER_CLICKHOUSE_ARGS
  clickhouse_client_args "$database"
  if [[ "$CLICKHOUSE_CLIENT_MODE" == "native" ]]; then
    "${CLICKHOUSE_ARGS[@]}" --multiquery
  else
    docker_clickhouse_args
    DOCKER_CLICKHOUSE_ARGS+=(-i)
    docker "${DOCKER_CLICKHOUSE_ARGS[@]}" "$CLICKHOUSE_IMAGE" \
      "${CLICKHOUSE_ARGS[@]}" --multiquery
  fi
}

clickhouse_value() {
  run_clickhouse_query default "$1"
}

clickhouse_client_version() {
  local output
  if [[ "$CLICKHOUSE_CLIENT_MODE" == "native" ]]; then
    output=$(clickhouse-client --version)
  else
    output=$(docker run --rm "$CLICKHOUSE_IMAGE" clickhouse-client --version)
  fi
  [[ "$output" =~ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]] ||
    die "cannot parse ClickHouse client version"
  printf '%s\n' "${BASH_REMATCH[1]}"
}

clickhouse_version_line() {
  local value=$1
  [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid ClickHouse version"
  printf '%s.%s\n' "${value%%.*}" "$(cut -d. -f2 <<< "$value")"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    require_command shasum
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

file_size() {
  if stat -f '%z' "$1" >/dev/null 2>&1; then
    stat -f '%z' "$1"
  else
    stat -c '%s' "$1"
  fi
}

canonicalize_json() {
  local input=$1 output=$2
  jq -S -c '.' "$input" > "$output"
  [[ -s "$output" ]] || die "canonical JSON output is empty"
}

public_key_fingerprint() {
  local key=$1 mode=$2 output="$WORK_DIR/signing-public.der"
  if [[ "$mode" == "private" ]]; then
    openssl pkey -in "$key" -pubout -outform DER -out "$output" >/dev/null 2>&1 ||
      die "manifest signing private key is invalid"
  else
    openssl pkey -pubin -in "$key" -pubout -outform DER -out "$output" >/dev/null 2>&1 ||
      die "manifest signing public key is invalid"
  fi
  openssl pkey -pubin -inform DER -in "$output" -text_pub -noout 2>/dev/null |
    grep -Fq 'ED25519' || die "manifest signing key must be Ed25519"
  sha256_file "$output"
}

sign_manifest() {
  local manifest=$1 private_key=$2 signature=$3
  openssl pkeyutl -sign -rawin -inkey "$private_key" -in "$manifest" -out "$signature" \
    >/dev/null 2>&1 || die "manifest signing failed"
  [[ $(file_size "$signature") == "64" ]] || die "manifest signature has an invalid size"
}

verify_manifest_signature() {
  local manifest=$1 public_key=$2 signature=$3
  openssl pkeyutl -verify -rawin -pubin -inkey "$public_key" -in "$manifest" \
    -sigfile "$signature" >/dev/null 2>&1 || die "manifest signature verification failed"
}

fsync_path() {
  if [[ "${CONTROL_BACKUP_ENABLE_TEST_HOOKS:-}" == "1" &&
    "${CONTROL_BACKUP_TEST_FAIL_PARENT_FSYNC_ONCE:-}" == "1" &&
    -n "$BACKUP_OUTPUT_DIR" && "$1" == "$BACKUP_OUTPUT_DIR" &&
    "$PARENT_FSYNC_INJECTED" == "false" ]]; then
    PARENT_FSYNC_INJECTED="true"
    return 70
  fi
  python3 - "$1" <<'PY'
import os
import sys

fd = os.open(sys.argv[1], os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
}

fsync_tree() {
  local root=$1 path
  while IFS= read -r -d '' path; do
    fsync_path "$path"
  done < <(find "$root" -type f -print0)
  while IFS= read -r -d '' path; do
    fsync_path "$path"
  done < <(find "$root" -depth -type d -print0)
}

remote_retention_deadline() {
  python3 - "$REMOTE_RETENTION_DAYS" "$REMOTE_RETENTION_UPLOAD_SAFETY_SECONDS" <<'PY'
from datetime import datetime, timedelta, timezone
import sys

deadline = datetime.now(timezone.utc) + timedelta(days=int(sys.argv[1]), seconds=int(sys.argv[2]))
print(deadline.strftime("%Y-%m-%dT%H:%M:%SZ"))
PY
}

remote_retention_is_valid() {
  local retain_until=$1 required_until=$2 last_modified=$3
  python3 - "$retain_until" "$required_until" "$last_modified" "$REMOTE_RETENTION_DAYS" <<'PY'
from datetime import datetime, timedelta, timezone
import sys

def parse(value):
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ValueError("timestamp is not timezone-aware")
    return parsed.astimezone(timezone.utc)

try:
    retain_until = parse(sys.argv[1])
    if sys.argv[2]:
        valid = retain_until >= parse(sys.argv[2])
    else:
        last_modified = parse(sys.argv[3])
        valid = (retain_until >= last_modified + timedelta(days=int(sys.argv[4])) and
                 retain_until > datetime.now(timezone.utc))
except (OverflowError, TypeError, ValueError):
    valid = False

raise SystemExit(0 if valid else 1)
PY
}

remote_json_version_id() {
  local document=$1 version_id
  version_id=$(jq -er '.VersionId | select(type == "string" and length > 0 and length <= 1024)' \
    <<< "$document" 2>/dev/null) || return 1
  [[ "$version_id" != *$'\n'* && "$version_id" != *$'\r'* && "$version_id" != *$'\t'* ]] || return 1
  printf '%s\n' "$version_id"
}

remote_head_metadata() {
  local key=$1 expected_size=$2 required_until=$3 purpose=$4 expected_version=${5:-}
  local head actual_size version_id retain_until last_modified
  local -a args=(s3api head-object --bucket "$REMOTE_BUCKET" --key "$key")
  [[ -z "$expected_version" ]] || args+=(--version-id "$expected_version")
  if ! head=$(run_aws "${args[@]}" 2>/dev/null); then
    return 1
  fi
  actual_size=$(jq -er '.ContentLength | select(type == "number" and . >= 0 and floor == .)' \
    <<< "$head" 2>/dev/null) || return 1
  [[ -z "$expected_size" || "$actual_size" == "$expected_size" ]] || return 1
  [[ $(jq -r '.ObjectLockMode // ""' <<< "$head" 2>/dev/null) == "COMPLIANCE" ]] || return 1
  version_id=$(remote_json_version_id "$head") || return 1
  [[ -z "$expected_version" || "$version_id" == "$expected_version" ]] || return 1
  retain_until=$(jq -er '.ObjectLockRetainUntilDate | select(type == "string" and length > 0)' \
    <<< "$head" 2>/dev/null) || return 1
  if [[ "$purpose" == "upload" ]]; then
    remote_retention_is_valid "$retain_until" "$required_until" "" || return 1
  elif [[ "$purpose" == "reconcile" || "$purpose" == "fetch" ]]; then
    last_modified=$(jq -er '.LastModified | select(type == "string" and length > 0)' \
      <<< "$head" 2>/dev/null) || return 1
    remote_retention_is_valid "$retain_until" "" "$last_modified" || return 1
  else
    return 1
  fi
  printf '%s\t%s\n' "$version_id" "$actual_size"
}

run_aws() {
  env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
    -u AWS_WEB_IDENTITY_TOKEN_FILE -u AWS_ROLE_ARN -u AWS_CONTAINER_CREDENTIALS_RELATIVE_URI \
    -u AWS_CONTAINER_CREDENTIALS_FULL_URI \
    AWS_SHARED_CREDENTIALS_FILE="$REMOTE_CREDENTIALS_FILE" AWS_PROFILE=default \
    AWS_CONFIG_FILE=/dev/null AWS_EC2_METADATA_DISABLED=true \
    aws --no-cli-pager --endpoint-url "$REMOTE_ENDPOINT" --region "$REMOTE_REGION" "$@"
}

remote_preflight() {
  local versioning lock retention_days
  if ! versioning=$(run_aws s3api get-bucket-versioning --bucket "$REMOTE_BUCKET" 2>/dev/null); then
    die "remote bucket versioning preflight failed"
  fi
  jq -e '.Status == "Enabled"' <<< "$versioning" >/dev/null ||
    die "remote bucket versioning must be Enabled"
  if ! lock=$(run_aws s3api get-object-lock-configuration --bucket "$REMOTE_BUCKET" 2>/dev/null); then
    die "remote Object Lock preflight failed"
  fi
  jq -e '.ObjectLockConfiguration.ObjectLockEnabled == "Enabled" and
    .ObjectLockConfiguration.Rule.DefaultRetention.Mode == "COMPLIANCE"' <<< "$lock" >/dev/null ||
    die "remote Object Lock with default COMPLIANCE retention must be Enabled"
  retention_days=$(jq -r '
    .ObjectLockConfiguration.Rule.DefaultRetention |
    if (.Days | type) == "number" then .Days
    elif (.Years | type) == "number" then (.Years * 365)
    else 0 end' <<< "$lock")
  [[ "$retention_days" =~ ^[0-9]+$ ]] || die "remote default retention is invalid"
  ((retention_days >= REMOTE_RETENTION_DAYS)) ||
    die "remote default COMPLIANCE retention is shorter than the configured minimum"
}

remote_object_matches() {
  local file=$1 key=$2 required_until=$3 expected_version=${4:-}
  local expected_size metadata purpose version_id actual_size readback get_result returned_version
  expected_size=$(file_size "$file")
  purpose=reconcile
  [[ -z "$expected_version" ]] || purpose=upload
  metadata=$(remote_head_metadata "$key" "$expected_size" "$required_until" "$purpose" \
    "$expected_version") || return 1
  IFS=$'\t' read -r version_id actual_size <<< "$metadata"
  readback=$(mktemp "$WORK_DIR/remote-readback.XXXXXX")
  if ! get_result=$(run_aws s3api get-object --bucket "$REMOTE_BUCKET" --key "$key" \
    --version-id "$version_id" "$readback" 2>/dev/null); then
    rm -f -- "$readback"
    return 1
  fi
  returned_version=$(remote_json_version_id "$get_result") || {
    rm -f -- "$readback"
    return 1
  }
  [[ "$returned_version" == "$version_id" ]] || {
    rm -f -- "$readback"
    return 1
  }
  actual_size=$(file_size "$readback")
  if [[ "$actual_size" != "$expected_size" ||
    "$(sha256_file "$readback")" != "$(sha256_file "$file")" ]]; then
    rm -f -- "$readback"
    return 1
  fi
  rm -f -- "$readback"
}

remote_put_immutable() {
  local file=$1 key=$2 retain_until put_result version_id
  retain_until=$(remote_retention_deadline) || die "cannot compute remote retention deadline"
  for _ in 1 2; do
    if put_result=$(run_aws s3api put-object --bucket "$REMOTE_BUCKET" --key "$key" --body "$file" \
      --if-none-match '*' --object-lock-mode COMPLIANCE \
      --object-lock-retain-until-date "$retain_until" 2>/dev/null); then
      version_id=$(remote_json_version_id "$put_result") ||
        die "remote put-object success response did not contain a VersionId: $key"
      remote_object_matches "$file" "$key" "$retain_until" "$version_id" ||
        die "remote object readback verification failed: $key"
      return
    fi
    if remote_object_matches "$file" "$key" "$retain_until"; then
      return
    fi
  done
  die "remote object conflict or uncertain upload outcome: $key"
}

validate_remote_filename() {
  local filename=$1
  case "$filename" in
    manifest.json | manifest.sig | database.dump.age) ;;
    clickhouse/*.schema.sql.age | clickhouse/*.native.age)
      [[ "$filename" =~ ^clickhouse/[A-Za-z_][A-Za-z0-9_]{0,62}\.(schema\.sql|native)\.age$ ]] ||
        die "remote bundle contains an invalid filename"
      ;;
    *) die "remote bundle contains an unexpected filename: $filename" ;;
  esac
}

remote_build_object_list() {
  local bundle=$1 output=$2 file filename
  local entries="$WORK_DIR/remote-objects.jsonl"
  : > "$entries"
  while IFS= read -r file; do
    [[ -f "$file" && ! -L "$file" ]] || die "remote bundle objects must be regular non-symlink files"
    filename=${file#"$bundle/"}
    validate_remote_filename "$filename"
    jq -n -c --arg filename "$filename" --arg sha256 "$(sha256_file "$file")" \
      --argjson size_bytes "$(file_size "$file")" \
      '{filename: $filename, sha256: $sha256, size_bytes: $size_bytes}' >> "$entries"
  done < <(find "$bundle" -type f | LC_ALL=C sort)
  jq -S -c -s 'sort_by(.filename)' "$entries" > "$output"
  jq -e 'length >= 3 and ([.[].filename] | unique | length) == length and
    any(.[]; .filename == "manifest.json") and
    any(.[]; .filename == "manifest.sig") and
    any(.[]; .filename == "database.dump.age")' "$output" >/dev/null ||
    die "remote bundle object list is incomplete or duplicated"
}

remote_publish_bundle() {
  local bundle=$1 backup_id=$2 manifest_sha256=$3 filename commit object_list
  local staging_root="$REMOTE_PREFIX/staging/$backup_id"
  local canonical_root="$REMOTE_PREFIX/bundles/$backup_id"
  object_list="$WORK_DIR/remote-objects.json"
  remote_build_object_list "$bundle" "$object_list"
  [[ $(jq -r '.[] | select(.filename == "manifest.json") | .sha256' "$object_list") == "$manifest_sha256" ]] ||
    die "local manifest digest changed before remote publication"
  commit="$WORK_DIR/commit.json"
  jq -n --arg schema "$REMOTE_COMMIT_SCHEMA" --arg backup_id "$backup_id" \
    --arg manifest_sha256 "$manifest_sha256" --arg mode "$REMOTE_RETENTION_MODE" \
    --argjson days "$REMOTE_RETENTION_DAYS" --slurpfile objects "$object_list" \
    '{schema: $schema, backup_id: $backup_id, manifest_sha256: $manifest_sha256,
      objects: $objects[0],
      storage: {layout: "staging-then-immutable-v1",
        retention: {mode: $mode, minimum_days: $days}}}' > "$WORK_DIR/commit.unsorted.json"
  canonicalize_json "$WORK_DIR/commit.unsorted.json" "$commit"

  remote_preflight
  while IFS= read -r filename; do
    remote_put_immutable "$bundle/$filename" "$staging_root/$filename"
  done < <(jq -r '.[].filename' "$object_list")
  while IFS= read -r filename; do
    remote_put_immutable "$bundle/$filename" "$canonical_root/$filename"
  done < <(jq -r '.[] | select(.filename != "manifest.sig" and .filename != "manifest.json") | .filename' "$object_list")
  remote_put_immutable "$bundle/manifest.sig" "$canonical_root/manifest.sig"
  remote_put_immutable "$bundle/manifest.json" "$canonical_root/manifest.json"
  remote_put_immutable "$commit" "$canonical_root/commit.json"
  printf 'control_backup_remote_last_success_timestamp_seconds=%s\n' "$(date -u '+%s')"
}

remote_download() {
  local key=$1 output=$2 expected_sha=${3:-} expected_size=${4:-}
  local metadata version_id actual_size get_result returned_version
  metadata=$(remote_head_metadata "$key" "$expected_size" "" fetch) || return 1
  IFS=$'\t' read -r version_id actual_size <<< "$metadata"
  if ! get_result=$(run_aws s3api get-object --bucket "$REMOTE_BUCKET" --key "$key" \
    --version-id "$version_id" "$output" 2>/dev/null); then
    return 1
  fi
  returned_version=$(remote_json_version_id "$get_result") || return 1
  [[ "$returned_version" == "$version_id" ]] || return 1
  [[ $(file_size "$output") == "$actual_size" ]] || return 1
  [[ -z "$expected_sha" || "$(sha256_file "$output")" == "$expected_sha" ]] || return 1
}

validate_remote_commit() {
  local commit=$1 expected_backup_id=$2 expected_manifest_sha256=$3
  if ! jq -S -c '.' "$commit" > "$WORK_DIR/commit.canonical.json"; then
    die "remote commit is invalid JSON"
  fi
  [[ -s "$WORK_DIR/commit.canonical.json" ]] || die "remote commit is empty"
  cmp -s "$commit" "$WORK_DIR/commit.canonical.json" || die "remote commit is not canonical JSON"
  jq -e --arg schema "$REMOTE_COMMIT_SCHEMA" --arg backup_id "$expected_backup_id" \
    --arg manifest_sha256 "$expected_manifest_sha256" --arg mode "$REMOTE_RETENTION_MODE" \
    --argjson days "$REMOTE_RETENTION_DAYS" '
      (keys == ["backup_id", "manifest_sha256", "objects", "schema", "storage"]) and
      .schema == $schema and .backup_id == $backup_id and
      .manifest_sha256 == $manifest_sha256 and
      .storage == {layout: "staging-then-immutable-v1",
        retention: {mode: $mode, minimum_days: $days}} and
      (.objects | type == "array" and length >= 3) and
      ([.objects[].filename] == ([.objects[].filename] | sort)) and
      ([.objects[].filename] | unique | length) == (.objects | length) and
      (all(.objects[];
        (.filename | type == "string" and
          test("^(manifest[.](json|sig)|database[.]dump[.]age|clickhouse/[A-Za-z_][A-Za-z0-9_]{0,62}[.](schema[.]sql|native)[.]age)$")) and
        (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
        (.size_bytes | type == "number" and . >= 0 and floor == .))) and
      (any(.objects[]; .filename == "manifest.json" and .sha256 == $manifest_sha256)) and
      (any(.objects[]; .filename == "manifest.sig" and .size_bytes == 64)) and
      (any(.objects[]; .filename == "database.dump.age" and .size_bytes > 0))
    ' "$commit" >/dev/null || {
      [[ $(jq -r '.manifest_sha256 // ""' "$commit" 2>/dev/null) != "$expected_manifest_sha256" ]] &&
        die "remote commit manifest digest does not match expected digest"
      die "remote commit contract validation failed"
    }
}

validate_migration_versions() {
  local csv=$1 expected=1 version
  local old_ifs=$IFS
  local -a versions
  [[ -n "$csv" ]] || die "migration ledger is empty"
  IFS=',' read -r -a versions <<< "$csv"
  IFS=$old_ifs
  for version in "${versions[@]}"; do
    [[ "$version" =~ ^[0-9]+$ ]] || die "migration ledger contains an invalid version"
    ((10#$version == expected)) || die "migration ledger is not contiguous at version $version"
    expected=$((expected + 1))
  done
}

migration_fingerprint() {
  local migrations_dir=$1 csv=$2 version padded file hash
  local old_ifs=$IFS
  local -a versions matches
  local fingerprint_input="$WORK_DIR/migration-fingerprint"
  : > "$fingerprint_input"
  IFS=',' read -r -a versions <<< "$csv"
  IFS=$old_ifs
  for version in "${versions[@]}"; do
    printf -v padded '%03d' "$version"
    matches=("$migrations_dir/$padded"_*.up.sql)
    [[ ${#matches[@]} -eq 1 && -f "${matches[0]}" && ! -L "${matches[0]}" ]] ||
      die "expected exactly one non-symlink up migration for version $version"
    file=${matches[0]}
    hash=$(sha256_file "$file")
    printf '%s %s\n' "$(basename "$file")" "$hash" >> "$fingerprint_input"
  done
  sha256_file "$fingerprint_input"
}

