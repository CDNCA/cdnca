backup_clickhouse() {
  local database=$1 output_dir=$2 age_recipient=$3 backup_id=$4
  local exists server_line server_version server_revision client_version source_bytes source_uncompressed_bytes size_line
  local available_kb scratch_available_kb required_kb snapshot_started snapshot_completed table engine watermark
  local schema_file schema_hash data_file before_metrics final_schema final_metrics final_partitions
  local schema_artifact data_artifact schema_relative data_relative data_hash data_size schema_artifact_hash schema_artifact_size
  local rows before_rows watermark_min watermark_max aggregate_checksum partitions_json partition_count schema_fingerprint
  local table_count=0
  local table_list="$WORK_DIR/clickhouse-tables.tsv"
  local final_table_list="$WORK_DIR/clickhouse-tables-final.tsv"
  local table_jsonl="$WORK_DIR/clickhouse-tables.jsonl"
  local schema_fingerprint_input="$WORK_DIR/clickhouse-schema-fingerprint"

  validate_clickhouse_data_database "$database"
  validate_clickhouse_environment
  select_clickhouse_client_mode
  require_command cmp
  snapshot_started=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

  exists=$(clickhouse_value "SELECT count() FROM system.databases WHERE name = '$database' FORMAT TSVRaw")
  [[ "$exists" == "1" ]] || die "ClickHouse source database does not exist"
  server_line=$(clickhouse_value "SELECT version(), revision() FORMAT TSVRaw")
  IFS=$'\t' read -r server_version server_revision <<< "$server_line"
  [[ "$server_revision" =~ ^[0-9]+$ ]] || die "invalid ClickHouse server revision"
  client_version=$(clickhouse_client_version)
  [[ $(clickhouse_version_line "$server_version") == "$(clickhouse_version_line "$client_version")" ]] ||
    die "ClickHouse client and server major.minor versions do not match"
  size_line=$(clickhouse_value "SELECT toString(ifNull(sum(bytes_on_disk), 0)), toString(ifNull(sum(data_uncompressed_bytes), 0)) FROM system.parts WHERE active AND database = '$database' FORMAT TSVRaw")
  IFS=$'\t' read -r source_bytes source_uncompressed_bytes <<< "$size_line"
  [[ "$source_bytes" =~ ^[0-9]+$ && "$source_uncompressed_bytes" =~ ^[0-9]+$ ]] ||
    die "invalid ClickHouse source size"
  available_kb=$(df -Pk "$output_dir" | awk 'END {print $4}')
  scratch_available_kb=$(df -Pk "$WORK_DIR" | awk 'END {print $4}')
  [[ "$available_kb" =~ ^[0-9]+$ && "$scratch_available_kb" =~ ^[0-9]+$ ]] ||
    die "cannot determine ClickHouse backup disk capacity"
  required_kb=$(((source_uncompressed_bytes + MIN_FREE_BYTES + 1023) / 1024))
  ((available_kb >= required_kb)) || die "insufficient output disk for ClickHouse snapshot"
  ((scratch_available_kb >= required_kb)) || die "insufficient ephemeral scratch disk for ClickHouse snapshot"

  clickhouse_table_list "$database" > "$table_list"
  [[ -s "$table_list" ]] || die "ClickHouse source database has no tables"
  mkdir "$BACKUP_TMP/clickhouse" "$WORK_DIR/clickhouse"
  : > "$table_jsonl"
  : > "$schema_fingerprint_input"

  while IFS=$'\t' read -r table engine; do
    validate_clickhouse_identifier "$table"
    case "$engine" in
      MergeTree | ReplacingMergeTree | SummingMergeTree | AggregatingMergeTree | CollapsingMergeTree | VersionedCollapsingMergeTree) ;;
      *) die "unsupported ClickHouse table engine for $table: $engine" ;;
    esac
    watermark=$(clickhouse_watermark_column "$database" "$table")
    validate_clickhouse_identifier "$watermark"

    schema_file="$WORK_DIR/clickhouse/$table.schema.sql"
    clickhouse_portable_schema "$database" "$table" > "$schema_file"
    printf ';\n' >> "$schema_file"
    [[ $(sed -n '1p' "$schema_file") == "CREATE TABLE $table "* ]] ||
      die "ClickHouse schema is not portable for table $table"
    schema_hash=$(sha256_file "$schema_file")
    printf '%s %s\n' "$table" "$schema_hash" >> "$schema_fingerprint_input"
    clickhouse_table_metrics "$database" "$table" "$watermark" > "$WORK_DIR/$table.before.tsv"
    clickhouse_partitions "$database" "$table" | jq -s 'map({id: .id, rows: (.rows | tonumber)})' > "$WORK_DIR/$table.partitions.json"

    data_file="$WORK_DIR/clickhouse/$table.native"
    run_clickhouse_query "$database" "SELECT * FROM $table FORMAT Native" > "$data_file"
    before_rows=$(cut -f1 "$WORK_DIR/$table.before.tsv")
    [[ "$before_rows" == "0" || -s "$data_file" ]] ||
      die "ClickHouse Native export is empty for non-empty table $table"
    table_count=$((table_count + 1))
  done < "$table_list"

  clickhouse_table_list "$database" > "$final_table_list"
  cmp -s "$table_list" "$final_table_list" || die "ClickHouse table set changed during snapshot"

  while IFS=$'\t' read -r table engine; do
    watermark=$(clickhouse_watermark_column "$database" "$table")
    final_schema="$WORK_DIR/$table.final-schema.sql"
    clickhouse_portable_schema "$database" "$table" > "$final_schema"
    printf ';\n' >> "$final_schema"
    cmp -s "$WORK_DIR/clickhouse/$table.schema.sql" "$final_schema" ||
      die "ClickHouse schema changed during snapshot for table $table"
    final_metrics=$(clickhouse_table_metrics "$database" "$table" "$watermark")
    before_metrics=$(< "$WORK_DIR/$table.before.tsv")
    [[ "$final_metrics" == "$before_metrics" ]] ||
      die "ClickHouse rows or watermark changed during snapshot for table $table"
    final_partitions="$WORK_DIR/$table.final-partitions.json"
    clickhouse_partitions "$database" "$table" | jq -s 'map({id: .id, rows: (.rows | tonumber)})' > "$final_partitions"
    cmp -s "$WORK_DIR/$table.partitions.json" "$final_partitions" ||
      die "ClickHouse partitions changed during snapshot for table $table"

    IFS=$'\t' read -r rows watermark_min watermark_max aggregate_checksum <<< "$before_metrics"
    [[ "$rows" =~ ^[0-9]+$ && "$aggregate_checksum" =~ ^[0-9]+$ ]] ||
      die "invalid ClickHouse aggregate metadata for table $table"
    partitions_json=$(jq -c '.' "$WORK_DIR/$table.partitions.json")
    partition_count=$(jq 'length' "$WORK_DIR/$table.partitions.json")
    schema_hash=$(sha256_file "$WORK_DIR/clickhouse/$table.schema.sql")
    schema_artifact=$(maybe_encrypt_file "$WORK_DIR/clickhouse/$table.schema.sql" "$age_recipient" \
      "$BACKUP_TMP/clickhouse/$table.schema.sql.age")
    data_artifact=$(maybe_encrypt_file "$WORK_DIR/clickhouse/$table.native" "$age_recipient" \
      "$BACKUP_TMP/clickhouse/$table.native.age")
    schema_relative=${schema_artifact#"$BACKUP_TMP/"}
    data_relative=${data_artifact#"$BACKUP_TMP/"}
    schema_artifact_hash=$(sha256_file "$schema_artifact")
    schema_artifact_size=$(file_size "$schema_artifact")
    data_hash=$(sha256_file "$data_artifact")
    data_size=$(file_size "$data_artifact")

    jq -n \
      --arg name "$table" --arg engine "$engine" --arg schema_sha "$schema_hash" \
      --arg schema_file "$schema_relative" --arg schema_artifact_sha "$schema_artifact_hash" \
      --argjson schema_size "$schema_artifact_size" --arg data_file "$data_relative" \
      --arg data_sha "$data_hash" --argjson data_size "$data_size" --argjson rows "$rows" \
      --arg watermark_column "$watermark" --arg watermark_min "$watermark_min" \
      --arg watermark_max "$watermark_max" --arg aggregate_checksum "$aggregate_checksum" \
      --argjson partitions "$partitions_json" --argjson partition_count "$partition_count" \
      '{name: $name, engine: $engine,
        schema: {sha256: $schema_sha, artifact: {filename: $schema_file, sha256: $schema_artifact_sha, size_bytes: $schema_size}},
        data: {format: "ClickHouse Native", filename: $data_file, sha256: $data_sha, size_bytes: $data_size},
        row_count: $rows, partition_count: $partition_count, partitions: $partitions,
        watermark: {column: $watermark_column, min: $watermark_min, max: $watermark_max},
        aggregate_checksum: {algorithm: "sum-cityHash64-tuple", value: $aggregate_checksum}}' >> "$table_jsonl"
  done < "$table_list"

  schema_fingerprint=$(sha256_file "$schema_fingerprint_input")
  snapshot_completed=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  jq -n \
    --arg database "$database" --arg server_version "$server_version" \
    --argjson server_revision "$server_revision" --arg client_version "$client_version" \
    --arg schema_fingerprint "$schema_fingerprint" --arg backup_id "$backup_id" \
    --arg started_at "$snapshot_started" --arg completed_at "$snapshot_completed" \
    --argjson source_bytes "$source_bytes" --argjson source_uncompressed_bytes "$source_uncompressed_bytes" \
    --argjson table_count "$table_count" \
    --slurpfile tables "$table_jsonl" \
    '{required: true,
      database: {name: $database, server_version: $server_version, server_revision: $server_revision, client_version: $client_version},
      schema_fingerprint_sha256: $schema_fingerprint,
      source_bytes_on_disk: $source_bytes,
      source_uncompressed_bytes: $source_uncompressed_bytes,
      table_count: $table_count,
      tables: $tables,
      snapshot: {identifier: $backup_id, started_at: $started_at, completed_at: $completed_at,
        method: "per-table-Native-export-with-stable-pre-post-watermarks"}}' > "$WORK_DIR/clickhouse-component.json"
  CLICKHOUSE_COMPONENT_FILE="$WORK_DIR/clickhouse-component.json"
}

backup_command() {
  local output_dir="" app_version="" migrations_dir="" age_recipient="" clickhouse_database=""
  local source_cluster_id="" signing_private_key="" signing_key_id=""
  local database server_version_num server_version db_size migration_versions migration_hash
  local client_pg_major server_major available_kb scratch_available_kb required_kb backup_id created_at stamp
  local plain_dump artifact artifact_name artifact_hash artifact_size final_dir manifest_sha256
  local snapshot_id_hash snapshot_id_file
  local signing_public_fingerprint public_table_count migration_row_count tenant_count user_count
  local audit_count audit_max_position audit_max_occurred_at transaction_count transaction_amount
  local posting_count posting_debit posting_credit
  local clickhouse_component='null'

  while (($#)); do
    case "$1" in
      --output-dir)
        [[ -z "$output_dir" && $# -ge 2 ]] || usage
        output_dir=$2; shift 2 ;;
      --app-version)
        [[ -z "$app_version" && $# -ge 2 ]] || usage
        app_version=$2; shift 2 ;;
      --migrations-dir)
        [[ -z "$migrations_dir" && $# -ge 2 ]] || usage
        migrations_dir=$2; shift 2 ;;
      --age-recipient)
        [[ -z "$age_recipient" && $# -ge 2 ]] || usage
        age_recipient=$2; shift 2 ;;
      --source-cluster-id)
        [[ -z "$source_cluster_id" && $# -ge 2 ]] || usage
        source_cluster_id=$2; shift 2 ;;
      --signing-private-key-file)
        [[ -z "$signing_private_key" && $# -ge 2 ]] || usage
        signing_private_key=$2; shift 2 ;;
      --signing-key-id)
        [[ -z "$signing_key_id" && $# -ge 2 ]] || usage
        signing_key_id=$2; shift 2 ;;
      --clickhouse-database)
        [[ -z "$clickhouse_database" && $# -ge 2 ]] || usage
        clickhouse_database=$2; shift 2 ;;
      --remote-endpoint)
        [[ -z "$REMOTE_ENDPOINT" && $# -ge 2 ]] || usage
        REMOTE_ENDPOINT=$2; shift 2 ;;
      --remote-region)
        [[ -z "$REMOTE_REGION" && $# -ge 2 ]] || usage
        REMOTE_REGION=$2; shift 2 ;;
      --remote-bucket)
        [[ -z "$REMOTE_BUCKET" && $# -ge 2 ]] || usage
        REMOTE_BUCKET=$2; shift 2 ;;
      --remote-prefix)
        [[ -z "$REMOTE_PREFIX" && $# -ge 2 ]] || usage
        REMOTE_PREFIX=$2; shift 2 ;;
      --remote-credentials-file)
        [[ -z "$REMOTE_CREDENTIALS_FILE" && $# -ge 2 ]] || usage
        REMOTE_CREDENTIALS_FILE=$2; shift 2 ;;
      --remote-retention-mode)
        [[ -z "$REMOTE_RETENTION_MODE" && $# -ge 2 ]] || usage
        REMOTE_RETENTION_MODE=$2; shift 2 ;;
      --remote-retention-days)
        [[ -z "$REMOTE_RETENTION_DAYS" && $# -ge 2 ]] || usage
        REMOTE_RETENTION_DAYS=$2; shift 2 ;;
      *) usage ;;
    esac
  done

  [[ -n "$output_dir" && -n "$app_version" && -n "$migrations_dir" &&
    -n "$source_cluster_id" && -n "$age_recipient" && -n "$signing_private_key" &&
    -n "$signing_key_id" ]] || usage
  validate_directory "$output_dir" "output directory"
  validate_directory "$migrations_dir" "migrations directory"
  validate_version "$app_version"
  validate_cluster_id "$source_cluster_id"
  validate_age_recipient "$age_recipient"
  validate_secret_file "$signing_private_key" "manifest signing private key"
  validate_version "$signing_key_id"
  [[ -z "$clickhouse_database" ]] || validate_clickhouse_data_database "$clickhouse_database"
  validate_remote_config false
  validate_db_environment
  select_client_mode true
  require_command jq
  require_command age
  require_command openssl
  require_command python3
  age --encrypt --recipient "$age_recipient" </dev/null >/dev/null
  new_work_dir
  signing_public_fingerprint=$(public_key_fingerprint "$signing_private_key" private)
  openssl pkey -in "$signing_private_key" -pubout -out "$WORK_DIR/signing-public.pem" \
    >/dev/null 2>&1 || die "cannot derive manifest signing public key"

  start_pg_snapshot
  database=$(jq -r '.database' "$PG_SNAPSHOT_METRICS_FILE")
  validate_database_name "$database"
  [[ "$database" == "$PGDATABASE" ]] || die "connected database does not match PGDATABASE"
  server_version_num=$(jq -r '.server_version_num' "$PG_SNAPSHOT_METRICS_FILE")
  [[ "$server_version_num" =~ ^[0-9]{6}$ ]] || die "invalid PostgreSQL server version"
  server_version=$(jq -r '.server_version' "$PG_SNAPSHOT_METRICS_FILE")
  db_size=$(jq -r '.database_size' "$PG_SNAPSHOT_METRICS_FILE")
  [[ "$db_size" =~ ^[0-9]+$ ]] || die "invalid PostgreSQL database size"
  [[ $(jq -r '.missing_required' "$PG_SNAPSHOT_METRICS_FILE") == "0" ]] ||
    die "source database is missing required control-plane tables"
  migration_versions=$(jq -r '.migration_versions' "$PG_SNAPSHOT_METRICS_FILE")
  validate_migration_versions "$migration_versions"
  migration_hash=$(migration_fingerprint "$migrations_dir" "$migration_versions")
  public_table_count=$(jq -r '.public_table_count' "$PG_SNAPSHOT_METRICS_FILE")
  migration_row_count=$(jq -r '.migration_row_count' "$PG_SNAPSHOT_METRICS_FILE")
  tenant_count=$(jq -r '.tenant_count' "$PG_SNAPSHOT_METRICS_FILE")
  user_count=$(jq -r '.user_count' "$PG_SNAPSHOT_METRICS_FILE")
  audit_count=$(jq -r '.audit_count' "$PG_SNAPSHOT_METRICS_FILE")
  audit_max_position=$(jq -r '.audit_max_position' "$PG_SNAPSHOT_METRICS_FILE")
  audit_max_occurred_at=$(jq -r '.audit_max_occurred_at' "$PG_SNAPSHOT_METRICS_FILE")
  transaction_count=$(jq -r '.transaction_count' "$PG_SNAPSHOT_METRICS_FILE")
  transaction_amount=$(jq -r '.transaction_amount' "$PG_SNAPSHOT_METRICS_FILE")
  posting_count=$(jq -r '.posting_count' "$PG_SNAPSHOT_METRICS_FILE")
  posting_debit=$(jq -r '.posting_debit' "$PG_SNAPSHOT_METRICS_FILE")
  posting_credit=$(jq -r '.posting_credit' "$PG_SNAPSHOT_METRICS_FILE")

  client_pg_major=$(client_major)
  server_major=$((10#$server_version_num / 10000))
  [[ "$client_pg_major" == "$server_major" ]] ||
    die "PostgreSQL client major $client_pg_major does not match server major $server_major"

  available_kb=$(df -Pk "$output_dir" | awk 'END {print $4}')
  scratch_available_kb=$(df -Pk "$WORK_DIR" | awk 'END {print $4}')
  [[ "$available_kb" =~ ^[0-9]+$ && "$scratch_available_kb" =~ ^[0-9]+$ ]] ||
    die "cannot determine backup disk capacity"
  required_kb=$(((db_size + MIN_FREE_BYTES + 1023) / 1024))
  ((available_kb >= required_kb)) ||
    die "insufficient output disk: need at least ${required_kb} KiB free"
  ((scratch_available_kb >= required_kb)) ||
    die "insufficient ephemeral scratch disk: need at least ${required_kb} KiB free"

  backup_id=$(new_backup_id)
  created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  stamp=$(date -u '+%Y%m%dT%H%M%SZ')
  final_dir="$output_dir/control-backup-$stamp-$backup_id"
  [[ ! -e "$final_dir" && ! -L "$final_dir" ]] || die "backup destination already exists"
  BACKUP_OUTPUT_DIR="$output_dir"
  BACKUP_TMP=$(mktemp -d "$output_dir/.control-backup.tmp.XXXXXX")
  chmod 700 "$BACKUP_TMP"

  test_stop_with_marker "${CONTROL_BACKUP_TEST_STOP_AFTER_SNAPSHOT_FILE:-}"
  plain_dump="$WORK_DIR/database.dump"
  run_pg_dump "$plain_dump" "$PG_SNAPSHOT_ID"
  [[ -s "$plain_dump" ]] || die "pg_dump produced an empty archive"
  assert_dump_archive "$plain_dump"
  snapshot_id_file="$WORK_DIR/postgresql-snapshot-id"
  printf '%s\n' "$PG_SNAPSHOT_ID" > "$snapshot_id_file"
  snapshot_id_hash=$(sha256_file "$snapshot_id_file")
  close_pg_snapshot rollback || die "PostgreSQL snapshot session did not close cleanly"
  test_stop_with_marker "${CONTROL_BACKUP_TEST_STOP_AFTER_DUMP_FILE:-}"

  artifact="$BACKUP_TMP/database.dump.age"
  age --encrypt --recipient "$age_recipient" --output "$artifact" "$plain_dump"
  [[ -s "$artifact" ]] || die "age produced an empty encrypted archive"
  rm -f -- "$plain_dump"

  artifact_name=$(basename "$artifact")
  artifact_hash=$(sha256_file "$artifact")
  artifact_size=$(file_size "$artifact")
  if [[ -n "$clickhouse_database" ]]; then
    backup_clickhouse "$clickhouse_database" "$output_dir" "$age_recipient" "$backup_id"
    clickhouse_component=$(< "$CLICKHOUSE_COMPONENT_FILE")
  fi
  jq -n \
    --arg database "$database" \
    --arg server_version "$server_version" \
    --arg server_version_num "$server_version_num" \
    --arg migration_fingerprint "$migration_hash" \
    --arg migration_versions "$migration_versions" \
    --arg artifact_name "$artifact_name" \
    --arg artifact_hash "$artifact_hash" \
    --argjson artifact_size "$artifact_size" \
    --argjson database_size "$db_size" \
    --argjson public_table_count "$public_table_count" \
    --argjson migration_row_count "$migration_row_count" \
    --argjson tenant_count "$tenant_count" --argjson user_count "$user_count" \
    --argjson audit_count "$audit_count" --argjson audit_max_position "$audit_max_position" \
    --arg audit_max_occurred_at "$audit_max_occurred_at" \
    --argjson transaction_count "$transaction_count" --argjson transaction_amount "$transaction_amount" \
    --argjson posting_count "$posting_count" --argjson posting_debit "$posting_debit" \
    --argjson posting_credit "$posting_credit" \
    --arg snapshot_id_hash "$snapshot_id_hash" \
    '{required: true,
      database: {
        name: $database,
        server_version: $server_version,
        server_version_num: ($server_version_num | tonumber),
        source_size_bytes: $database_size
      },
      migration: {
        schema_version: ($migration_versions | split(",") | map(tonumber) | max),
        applied_versions: ($migration_versions | split(",") | map(tonumber)),
        fingerprint_sha256: $migration_fingerprint
      },
      logical_contents: {
        public_table_count: $public_table_count,
        migration_ledger: {row_count: $migration_row_count},
        tenants: {row_count: $tenant_count},
        users: {row_count: $user_count},
        audit_events: {row_count: $audit_count, max_stream_position: $audit_max_position,
          max_occurred_at: $audit_max_occurred_at},
        billing_ledger: {transaction_count: $transaction_count,
          transaction_amount_minor: $transaction_amount, posting_count: $posting_count,
          debit_amount_minor: $posting_debit, credit_amount_minor: $posting_credit}
      },
      artifact: {
        filename: $artifact_name,
        format: "pg_dump-custom",
        sha256: $artifact_hash,
        size_bytes: $artifact_size
      },
      consistency: {
        method: "pg-exported-snapshot",
        single_transaction_snapshot: true,
        dump_snapshot_bound: true,
        snapshot_identifier_sha256: $snapshot_id_hash
      }
    }' > "$WORK_DIR/postgresql-component.json"
  jq -n \
    --arg schema "$MANIFEST_SCHEMA" --arg backup_id "$backup_id" --arg created_at "$created_at" \
    --arg app_version "$app_version" --arg source_cluster_id "$source_cluster_id" \
    --arg age_recipient "$age_recipient" --arg signing_key_id "$signing_key_id" \
    --arg signing_fingerprint "$signing_public_fingerprint" --arg tool_version "$TOOL_VERSION" \
    --argjson clickhouse "$clickhouse_component" \
    --slurpfile postgresql "$WORK_DIR/postgresql-component.json" \
    '{schema: $schema, format_version: 3, backup_id: $backup_id, created_at: $created_at,
      source: {cluster_id: $source_cluster_id}, app_version: $app_version,
      tool: {name: "control-backup", version: $tool_version},
      encryption: {state: "encrypted", method: "age", recipients: [$age_recipient]},
      signing: {algorithm: "Ed25519", key_id: $signing_key_id,
        public_key_sha256: $signing_fingerprint, signature_file: "manifest.sig"},
      components: ({postgresql: $postgresql[0]} + (if $clickhouse == null then {} else {clickhouse: $clickhouse} end)),
      consistency: {identifier: $backup_id, method: "component-bounded-snapshot",
        required_components: (if $clickhouse == null then ["postgresql"] else ["postgresql", "clickhouse"] end)}}' \
    > "$WORK_DIR/manifest.unsorted.json"
  canonicalize_json "$WORK_DIR/manifest.unsorted.json" "$BACKUP_TMP/manifest.json"
  sign_manifest "$BACKUP_TMP/manifest.json" "$signing_private_key" "$BACKUP_TMP/manifest.sig"
  verify_manifest_signature "$BACKUP_TMP/manifest.json" "$WORK_DIR/signing-public.pem" \
    "$BACKUP_TMP/manifest.sig"
  manifest_sha256=$(sha256_file "$BACKUP_TMP/manifest.json")
  [[ -z $(find "$BACKUP_TMP" -type f \( -name 'database.dump' -o -name '*.native' -o -name '*.schema.sql' \) -print -quit) ]] ||
    die "plaintext artifact remained in final staging"
  find "$BACKUP_TMP" -type f -exec chmod 600 {} +
  fsync_tree "$BACKUP_TMP"

  mv -- "$BACKUP_TMP" "$final_dir"
  PUBLISHED_DIR="$final_dir"
  BACKUP_TMP=""
  if ! fsync_path "$output_dir"; then
    rm -rf -- "$PUBLISHED_DIR" || die "backup parent fsync failed and final bundle removal failed"
    PUBLISHED_DIR=""
    fsync_path "$output_dir" || die "backup parent fsync failed and removal was not durably synchronized"
    die "backup parent directory fsync failed; unpublished bundle was removed"
  fi
  PUBLISHED_DIR=""
  if [[ "$REMOTE_ENABLED" == "true" ]]; then
    remote_publish_bundle "$final_dir" "$backup_id" "$manifest_sha256"
  fi
  printf 'backup_bundle=%s\n' "$final_dir"
  printf 'backup_id=%s\n' "$backup_id"
  printf 'manifest_sha256=%s\n' "$manifest_sha256"
  printf 'artifact_sha256=%s\n' "$artifact_hash"
  printf 'encryption=age\n'
  printf 'signing_key_id=%s\n' "$signing_key_id"
}

validate_manifest_shape() {
  local manifest=$1
  jq -e --arg schema "$MANIFEST_SCHEMA" --arg tool_version "$TOOL_VERSION" '
    . as $root |
    .components.postgresql as $pg |
    .schema == $schema and
    .format_version == 3 and
    (.backup_id | type == "string" and test("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")) and
    (.created_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    (.source.cluster_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")) and
    (.app_version | type == "string" and length > 0) and
    .tool == {name: "control-backup", version: $tool_version} and
    (.encryption.state == "encrypted" and .encryption.method == "age" and
      (.encryption.recipients | type == "array" and length == 1 and
        all(.[]; type == "string" and test("^age1[023456789acdefghjklmnpqrstuvwxyz]{20,90}$")))) and
    (.signing.algorithm == "Ed25519" and
      (.signing.key_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$")) and
      (.signing.public_key_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      .signing.signature_file == "manifest.sig") and
    $pg.required == true and
    ($pg.database.name | type == "string" and length > 0) and
    ($pg.database.server_version_num | type == "number" and . >= 100000) and
    ($pg.database.source_size_bytes | type == "number" and . > 0 and floor == .) and
    ($pg.migration.schema_version | type == "number" and . >= 1) and
    ($pg.migration.applied_versions | type == "array" and length > 0 and all(.[]; type == "number" and . >= 1)) and
    ($pg.migration.fingerprint_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    ($pg.logical_contents.public_table_count | type == "number" and . > 0 and floor == .) and
    ($pg.logical_contents.migration_ledger.row_count | type == "number" and . > 0 and floor == .) and
    ($pg.logical_contents.tenants.row_count | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.users.row_count | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.audit_events.row_count | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.audit_events.max_stream_position | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.audit_events.max_occurred_at | type == "string") and
    ($pg.logical_contents.billing_ledger.transaction_count | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.billing_ledger.transaction_amount_minor | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.billing_ledger.posting_count | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.billing_ledger.debit_amount_minor | type == "number" and . >= 0 and floor == .) and
    ($pg.logical_contents.billing_ledger.credit_amount_minor | type == "number" and . >= 0 and floor == .) and
    $pg.artifact.format == "pg_dump-custom" and
    ($pg.artifact.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    ($pg.artifact.size_bytes | type == "number" and . > 0 and floor == .) and
    $pg.artifact.filename == "database.dump.age" and
    $pg.consistency.method == "pg-exported-snapshot" and
    $pg.consistency.single_transaction_snapshot == true and
    $pg.consistency.dump_snapshot_bound == true and
    ($pg.consistency.snapshot_identifier_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    .consistency.identifier == .backup_id and
    .consistency.method == "component-bounded-snapshot" and
    (.consistency.required_components == ["postgresql"] or .consistency.required_components == ["postgresql", "clickhouse"]) and
    ((.components | has("clickhouse")) == (.consistency.required_components | index("clickhouse") != null)) and
    ((.components | has("clickhouse") | not) or
      (.components.clickhouse as $ch |
        $ch.required == true and
        ($ch.database.name | type == "string" and length > 0) and
        ($ch.database.server_version | type == "string" and test("^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$")) and
        ($ch.database.server_revision | type == "number" and . > 0) and
        ($ch.schema_fingerprint_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
        ($ch.source_bytes_on_disk | type == "number" and . >= 0) and
        ($ch.source_uncompressed_bytes | type == "number" and . >= 0) and
        ($ch.table_count | type == "number" and . > 0 and . == ($ch.tables | length)) and
        ([$ch.tables[].name] | unique | length) == $ch.table_count and
        ($ch.tables | type == "array" and length > 0 and
          all(.[];
            (.name | type == "string" and test("^[A-Za-z_][A-Za-z0-9_]{0,62}$")) and
            (.engine | IN("MergeTree", "ReplacingMergeTree", "SummingMergeTree", "AggregatingMergeTree", "CollapsingMergeTree", "VersionedCollapsingMergeTree")) and
            (.schema.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
            (.schema.artifact.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
            (.schema.artifact.size_bytes | type == "number" and . > 0) and
            (.data.format == "ClickHouse Native") and
            (.data.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
            (.data.size_bytes | type == "number" and . >= 0) and
            (.row_count | type == "number" and . >= 0) and
            (.partition_count | type == "number") and .partition_count == (.partitions | length) and
            (.partitions | type == "array" and all(.[]; (.id | type == "string") and (.rows | type == "number" and . >= 0))) and
            ([.partitions[].rows] | add // 0) == .row_count and
            (.watermark.column | type == "string" and test("^[A-Za-z_][A-Za-z0-9_]{0,62}$")) and
            (.watermark.min | type == "string") and (.watermark.max | type == "string") and
            (.row_count == 0 or (.watermark.min | length) > 0) and
            (.row_count == 0 or (.watermark.max | length) > 0) and
            .aggregate_checksum.algorithm == "sum-cityHash64-tuple" and
            (.aggregate_checksum.value | type == "string" and test("^[0-9]+$")) and
            .schema.artifact.filename == ("clickhouse/" + .name + ".schema.sql.age") and
            .data.filename == ("clickhouse/" + .name + ".native.age"))) and
        $ch.snapshot.identifier == $root.backup_id and
        $ch.snapshot.method == "per-table-Native-export-with-stable-pre-post-watermarks"))
  ' "$manifest" >/dev/null || die "manifest schema validation failed"
}

verify_clickhouse_component() {
  local bundle=$1 manifest=$2 age_identity_file=$3 encryption_method=$4
  local table_entry table schema_name data_name schema_artifact data_artifact expected_hash expected_size
  local schema_plain data_plain schema_hash schema_fingerprint expected_schema_fingerprint
  local fingerprint_input="$WORK_DIR/verified-clickhouse-schema-fingerprint"
  mkdir -p "$WORK_DIR/clickhouse"
  : > "$fingerprint_input"

  while IFS= read -r table_entry; do
    table=$(jq -r '.name' <<< "$table_entry")
    validate_clickhouse_identifier "$table"
    schema_name=$(jq -r '.schema.artifact.filename' <<< "$table_entry")
    data_name=$(jq -r '.data.filename' <<< "$table_entry")
    schema_artifact="$bundle/$schema_name"
    data_artifact="$bundle/$data_name"
    [[ -f "$schema_artifact" && ! -L "$schema_artifact" ]] ||
      die "ClickHouse schema artifact is missing for table $table"
    [[ -f "$data_artifact" && ! -L "$data_artifact" ]] ||
      die "ClickHouse Native artifact is missing for table $table"

    expected_hash=$(jq -r '.schema.artifact.sha256' <<< "$table_entry")
    [[ $(sha256_file "$schema_artifact") == "$expected_hash" ]] ||
      die "ClickHouse schema artifact hash mismatch for table $table"
    expected_size=$(jq -r '.schema.artifact.size_bytes' <<< "$table_entry")
    [[ $(file_size "$schema_artifact") == "$expected_size" ]] ||
      die "ClickHouse schema artifact size mismatch for table $table"
    expected_hash=$(jq -r '.data.sha256' <<< "$table_entry")
    [[ $(sha256_file "$data_artifact") == "$expected_hash" ]] ||
      die "ClickHouse data artifact hash mismatch for table $table"
    expected_size=$(jq -r '.data.size_bytes' <<< "$table_entry")
    [[ $(file_size "$data_artifact") == "$expected_size" ]] ||
      die "ClickHouse data artifact size mismatch for table $table"

    if [[ "$encryption_method" == "age" ]]; then
      schema_plain="$WORK_DIR/clickhouse/$table.schema.sql"
      data_plain="$WORK_DIR/clickhouse/$table.native"
      age --decrypt --identity "$age_identity_file" --output "$schema_plain" "$schema_artifact"
      age --decrypt --identity "$age_identity_file" --output "$data_plain" "$data_artifact"
    else
      schema_plain=$schema_artifact
      data_plain=$data_artifact
    fi
    [[ -s "$schema_plain" ]] || die "ClickHouse decrypted schema artifact is empty"
    [[ $(jq -r '.row_count' <<< "$table_entry") == "0" || -s "$data_plain" ]] ||
      die "ClickHouse decrypted data artifact is empty for non-empty table $table"
    [[ $(sed -n '1p' "$schema_plain") == "CREATE TABLE $table "* ]] ||
      die "ClickHouse schema is not portable for table $table"
    schema_hash=$(sha256_file "$schema_plain")
    [[ "$schema_hash" == "$(jq -r '.schema.sha256' <<< "$table_entry")" ]] ||
      die "ClickHouse plaintext schema hash mismatch for table $table"
    printf '%s %s\n' "$table" "$schema_hash" >> "$fingerprint_input"
  done < <(jq -c '.components.clickhouse.tables[]' "$manifest")

  schema_fingerprint=$(sha256_file "$fingerprint_input")
  expected_schema_fingerprint=$(jq -r '.components.clickhouse.schema_fingerprint_sha256' "$manifest")
  [[ "$schema_fingerprint" == "$expected_schema_fingerprint" ]] ||
    die "ClickHouse schema fingerprint mismatch"
}

verify_bundle() {
  local bundle=$1 expected_app_version=$2 migrations_dir=$3 age_identity_file=$4
  local expected_source_cluster_id=$5 expected_backup_id=$6 expected_manifest_sha256=$7
  local signing_public_key=$8 expected_signing_key_id=$9
  local manifest artifact_name artifact expected_hash actual_hash expected_size actual_size
  local encryption_method actual_migration_hash signature actual_signing_fingerprint

  validate_directory "$bundle" "backup bundle"
  validate_directory "$migrations_dir" "migrations directory"
  validate_version "$expected_app_version"
  validate_cluster_id "$expected_source_cluster_id"
  validate_backup_id "$expected_backup_id"
  validate_sha256 "$expected_manifest_sha256"
  validate_public_file "$signing_public_key" "manifest signing public key"
  validate_version "$expected_signing_key_id"
  validate_secret_file "$age_identity_file" "age identity file"
  manifest="$bundle/manifest.json"
  [[ -f "$manifest" && ! -L "$manifest" ]] || die "manifest.json must be a regular non-symlink file"
  signature="$bundle/manifest.sig"
  [[ -f "$signature" && ! -L "$signature" ]] || die "manifest.sig must be a regular non-symlink file"
  [[ $(file_size "$signature") == "64" ]] || die "manifest signature has an invalid size"
  require_command openssl
  require_command age
  new_work_dir
  VERIFIED_BUNDLE=$bundle
  MANIFEST_SHA256=$(sha256_file "$manifest")
  [[ "$MANIFEST_SHA256" == "$expected_manifest_sha256" ]] || die "manifest digest does not match expected digest"
  verify_manifest_signature "$manifest" "$signing_public_key" "$signature"
  require_command jq
  canonicalize_json "$manifest" "$WORK_DIR/manifest.canonical.json"
  cmp -s "$manifest" "$WORK_DIR/manifest.canonical.json" || die "manifest is not canonical JSON"
  validate_manifest_shape "$manifest"

  MANIFEST_DATABASE=$(jq -r '.components.postgresql.database.name' "$manifest")
  MANIFEST_SERVER_VERSION_NUM=$(jq -r '.components.postgresql.database.server_version_num' "$manifest")
  MANIFEST_APP_VERSION=$(jq -r '.app_version' "$manifest")
  MANIFEST_MIGRATION_VERSIONS=$(jq -r '.components.postgresql.migration.applied_versions | join(",")' "$manifest")
  MANIFEST_MIGRATION_FINGERPRINT=$(jq -r '.components.postgresql.migration.fingerprint_sha256' "$manifest")
  MANIFEST_BACKUP_ID=$(jq -r '.backup_id' "$manifest")
  MANIFEST_SOURCE_CLUSTER_ID=$(jq -r '.source.cluster_id' "$manifest")
  MANIFEST_CLICKHOUSE_PRESENT=$(jq -r '.components | has("clickhouse")' "$manifest")
  validate_database_name "$MANIFEST_DATABASE"
  validate_version "$MANIFEST_APP_VERSION"
  if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
    validate_clickhouse_data_database "$(jq -r '.components.clickhouse.database.name' "$manifest")"
  fi
  [[ "$MANIFEST_APP_VERSION" == "$expected_app_version" ]] || die "backup app version does not match expected version"
  [[ "$MANIFEST_SOURCE_CLUSTER_ID" == "$expected_source_cluster_id" ]] ||
    die "backup source cluster does not match expected cluster"
  [[ "$MANIFEST_BACKUP_ID" == "$expected_backup_id" ]] || die "backup ID does not match expected backup ID"
  [[ $(jq -r '.signing.key_id' "$manifest") == "$expected_signing_key_id" ]] ||
    die "manifest signing key ID does not match expected key ID"
  actual_signing_fingerprint=$(public_key_fingerprint "$signing_public_key" public)
  [[ "$actual_signing_fingerprint" == "$(jq -r '.signing.public_key_sha256' "$manifest")" ]] ||
    die "manifest signing public key fingerprint mismatch"
  validate_migration_versions "$MANIFEST_MIGRATION_VERSIONS"
  [[ $(jq -r '.components.postgresql.migration.schema_version' "$manifest") == "${MANIFEST_MIGRATION_VERSIONS##*,}" ]] ||
    die "manifest schema version does not match its migration ledger"
  actual_migration_hash=$(migration_fingerprint "$migrations_dir" "$MANIFEST_MIGRATION_VERSIONS")
  [[ "$actual_migration_hash" == "$MANIFEST_MIGRATION_FINGERPRINT" ]] ||
    die "migration fingerprint mismatch"

  artifact_name=$(jq -r '.components.postgresql.artifact.filename' "$manifest")
  artifact="$bundle/$artifact_name"
  [[ -f "$artifact" && ! -L "$artifact" ]] || die "backup artifact must be a regular non-symlink file"
  expected_hash=$(jq -r '.components.postgresql.artifact.sha256' "$manifest")
  actual_hash=$(sha256_file "$artifact")
  [[ "$actual_hash" == "$expected_hash" ]] || die "backup artifact hash mismatch"
  expected_size=$(jq -r '.components.postgresql.artifact.size_bytes' "$manifest")
  actual_size=$(file_size "$artifact")
  [[ "$actual_size" == "$expected_size" ]] || die "backup artifact size mismatch"

  encryption_method=$(jq -r '.encryption.method' "$manifest")
  [[ "$encryption_method" == "age" ]] || die "only age-encrypted bundles are accepted"
  VERIFIED_DUMP="$WORK_DIR/database.dump"
  age --decrypt --identity "$age_identity_file" --output "$VERIFIED_DUMP" "$artifact"
  [[ -s "$VERIFIED_DUMP" ]] || die "decrypted PostgreSQL archive is empty"

  select_client_mode false
  assert_dump_archive "$VERIFIED_DUMP"
  if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
    verify_clickhouse_component "$bundle" "$manifest" "$age_identity_file" "$encryption_method"
  fi
}

parse_verify_options() {
  VERIFY_BUNDLE=""
  VERIFY_EXPECTED_APP_VERSION=""
  VERIFY_MIGRATIONS_DIR=""
  VERIFY_AGE_IDENTITY=""
  VERIFY_EXPECTED_SOURCE_CLUSTER_ID=""
  VERIFY_EXPECTED_BACKUP_ID=""
  VERIFY_EXPECTED_MANIFEST_SHA256=""
  VERIFY_SIGNING_PUBLIC_KEY=""
  VERIFY_EXPECTED_SIGNING_KEY_ID=""
  while (($#)); do
    case "$1" in
      --bundle)
        [[ -z "$VERIFY_BUNDLE" && $# -ge 2 ]] || usage
        VERIFY_BUNDLE=$2; shift 2 ;;
      --expected-app-version)
        [[ -z "$VERIFY_EXPECTED_APP_VERSION" && $# -ge 2 ]] || usage
        VERIFY_EXPECTED_APP_VERSION=$2; shift 2 ;;
      --migrations-dir)
        [[ -z "$VERIFY_MIGRATIONS_DIR" && $# -ge 2 ]] || usage
        VERIFY_MIGRATIONS_DIR=$2; shift 2 ;;
      --age-identity-file)
        [[ -z "$VERIFY_AGE_IDENTITY" && $# -ge 2 ]] || usage
        VERIFY_AGE_IDENTITY=$2; shift 2 ;;
      --expected-source-cluster-id)
        [[ -z "$VERIFY_EXPECTED_SOURCE_CLUSTER_ID" && $# -ge 2 ]] || usage
        VERIFY_EXPECTED_SOURCE_CLUSTER_ID=$2; shift 2 ;;
      --expected-backup-id)
        [[ -z "$VERIFY_EXPECTED_BACKUP_ID" && $# -ge 2 ]] || usage
        VERIFY_EXPECTED_BACKUP_ID=$2; shift 2 ;;
      --expected-manifest-sha256)
        [[ -z "$VERIFY_EXPECTED_MANIFEST_SHA256" && $# -ge 2 ]] || usage
        VERIFY_EXPECTED_MANIFEST_SHA256=$2; shift 2 ;;
      --signing-public-key-file)
        [[ -z "$VERIFY_SIGNING_PUBLIC_KEY" && $# -ge 2 ]] || usage
        VERIFY_SIGNING_PUBLIC_KEY=$2; shift 2 ;;
      --expected-signing-key-id)
        [[ -z "$VERIFY_EXPECTED_SIGNING_KEY_ID" && $# -ge 2 ]] || usage
        VERIFY_EXPECTED_SIGNING_KEY_ID=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ -n "$VERIFY_BUNDLE" && -n "$VERIFY_EXPECTED_APP_VERSION" && -n "$VERIFY_MIGRATIONS_DIR" &&
    -n "$VERIFY_AGE_IDENTITY" && -n "$VERIFY_EXPECTED_SOURCE_CLUSTER_ID" &&
    -n "$VERIFY_EXPECTED_BACKUP_ID" && -n "$VERIFY_EXPECTED_MANIFEST_SHA256" &&
    -n "$VERIFY_SIGNING_PUBLIC_KEY" && -n "$VERIFY_EXPECTED_SIGNING_KEY_ID" ]] || usage
}

verify_command() {
  parse_verify_options "$@"
  verify_bundle "$VERIFY_BUNDLE" "$VERIFY_EXPECTED_APP_VERSION" "$VERIFY_MIGRATIONS_DIR" \
    "$VERIFY_AGE_IDENTITY" "$VERIFY_EXPECTED_SOURCE_CLUSTER_ID" "$VERIFY_EXPECTED_BACKUP_ID" \
    "$VERIFY_EXPECTED_MANIFEST_SHA256" "$VERIFY_SIGNING_PUBLIC_KEY" "$VERIFY_EXPECTED_SIGNING_KEY_ID"
  printf 'verified_backup_id=%s\n' "$MANIFEST_BACKUP_ID"
  printf 'verified_database=%s\n' "$MANIFEST_DATABASE"
  printf 'verified_manifest_sha256=%s\n' "$MANIFEST_SHA256"
  printf 'verified_artifact_sha256=%s\n' "$(sha256_file "$VERIFY_BUNDLE/$(jq -r '.components.postgresql.artifact.filename' "$VERIFY_BUNDLE/manifest.json")")"
}

restore_checks() {
  local migrations_dir=$1
  local restored_versions migration_hash missing_core invalid_constraints broken_audit trigger_count
  local manifest="$VERIFIED_BUNDLE/manifest.json" actual expected
  restored_versions=$(psql_value "SELECT string_agg(version::text, ',' ORDER BY version) FROM schema_migrations")
  [[ "$restored_versions" == "$MANIFEST_MIGRATION_VERSIONS" ]] || die "restored migration ledger mismatch"
  migration_hash=$(migration_fingerprint "$migrations_dir" "$restored_versions")
  [[ "$migration_hash" == "$MANIFEST_MIGRATION_FINGERPRINT" ]] || die "restored migration fingerprint mismatch"

  missing_core=$(psql_value "SELECT count(*) FROM (VALUES ('schema_migrations'),('tenants'),('access_scopes'),('users'),('audit_events')) AS required(name) WHERE to_regclass('public.' || name) IS NULL")
  [[ "$missing_core" == "0" ]] || die "restored database is missing core tables"
  invalid_constraints=$(psql_value "SELECT count(*) FROM pg_constraint c JOIN pg_namespace n ON n.oid=c.connamespace WHERE n.nspname='public' AND NOT c.convalidated")
  [[ "$invalid_constraints" == "0" ]] || die "restored database has unvalidated constraints"
  trigger_count=$(psql_value "SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname='audit_events' AND t.tgname='audit_events_append_only' AND NOT t.tgisinternal AND t.tgenabled <> 'D'")
  [[ "$trigger_count" == "1" ]] || die "audit append-only trigger is missing or disabled"
  broken_audit=$(psql_value "WITH ordered AS (SELECT scope_id, stream_position, previous_hash, event_hash, row_number() OVER (PARTITION BY scope_id ORDER BY stream_position) AS expected_position, lag(event_hash) OVER (PARTITION BY scope_id ORDER BY stream_position) AS expected_previous FROM audit_events) SELECT count(*) FROM ordered WHERE stream_position <> expected_position OR previous_hash IS DISTINCT FROM expected_previous")
  [[ "$broken_audit" == "0" ]] || die "restored audit sequence or hash linkage is inconsistent"

  while IFS=$'\t' read -r actual expected; do
    [[ "$actual" == "$expected" ]] || die "restored PostgreSQL logical contents mismatch"
  done <<EOF
$(psql_value "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p')")	$(jq -r '.components.postgresql.logical_contents.public_table_count' "$manifest")
$(psql_value 'SELECT count(*) FROM schema_migrations')	$(jq -r '.components.postgresql.logical_contents.migration_ledger.row_count' "$manifest")
$(psql_value 'SELECT count(*) FROM tenants')	$(jq -r '.components.postgresql.logical_contents.tenants.row_count' "$manifest")
$(psql_value 'SELECT count(*) FROM users')	$(jq -r '.components.postgresql.logical_contents.users.row_count' "$manifest")
$(psql_value 'SELECT count(*) FROM audit_events')	$(jq -r '.components.postgresql.logical_contents.audit_events.row_count' "$manifest")
$(psql_value 'SELECT COALESCE(max(stream_position),0) FROM audit_events')	$(jq -r '.components.postgresql.logical_contents.audit_events.max_stream_position' "$manifest")
$(psql_value "SELECT COALESCE(to_char(max(occurred_at) AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'),'') FROM audit_events")	$(jq -r '.components.postgresql.logical_contents.audit_events.max_occurred_at' "$manifest")
$(psql_value 'SELECT count(*) FROM billing_transactions')	$(jq -r '.components.postgresql.logical_contents.billing_ledger.transaction_count' "$manifest")
$(psql_value 'SELECT COALESCE(sum(amount_minor),0) FROM billing_transactions')	$(jq -r '.components.postgresql.logical_contents.billing_ledger.transaction_amount_minor' "$manifest")
$(psql_value 'SELECT count(*) FROM billing_postings')	$(jq -r '.components.postgresql.logical_contents.billing_ledger.posting_count' "$manifest")
$(psql_value "SELECT COALESCE(sum(amount_minor) FILTER (WHERE side='debit'),0) FROM billing_postings")	$(jq -r '.components.postgresql.logical_contents.billing_ledger.debit_amount_minor' "$manifest")
$(psql_value "SELECT COALESCE(sum(amount_minor) FILTER (WHERE side='credit'),0) FROM billing_postings")	$(jq -r '.components.postgresql.logical_contents.billing_ledger.credit_amount_minor' "$manifest")
EOF
}

clickhouse_verified_path() {
  local table=$1 kind=$2 encryption_method
  encryption_method=$(jq -r '.encryption.method' "$VERIFIED_BUNDLE/manifest.json")
  if [[ "$encryption_method" == "age" ]]; then
    printf '%s/clickhouse/%s.%s\n' "$WORK_DIR" "$table" "$kind"
  else
    printf '%s/clickhouse/%s.%s\n' "$VERIFIED_BUNDLE" "$table" "$kind"
  fi
}

preflight_clickhouse_restore() {
  local target=$1 confirmation=$2 manifest="$VERIFIED_BUNDLE/manifest.json"
  local exists target_version manifest_version client_version table_count free_bytes required_bytes source_bytes
  validate_clickhouse_data_database "$target"
  [[ "$confirmation" == "$target" ]] ||
    die "--confirm-empty-clickhouse-target must exactly match --clickhouse-target-database"
  validate_clickhouse_environment
  select_clickhouse_client_mode

  exists=$(clickhouse_value "SELECT count() FROM system.databases WHERE name = '$target' FORMAT TSVRaw")
  [[ "$exists" == "1" ]] || die "ClickHouse target database does not exist"
  table_count=$(clickhouse_value "SELECT count() FROM system.tables WHERE database = '$target' FORMAT TSVRaw")
  [[ "$table_count" == "0" ]] || die "ClickHouse target database is not empty; refusing restore"
  target_version=$(clickhouse_value "SELECT version() FORMAT TSVRaw")
  manifest_version=$(jq -r '.components.clickhouse.database.server_version' "$manifest")
  client_version=$(clickhouse_client_version)
  [[ $(clickhouse_version_line "$target_version") == "$(clickhouse_version_line "$manifest_version")" ]] ||
    die "ClickHouse target and backup major.minor versions do not match"
  [[ $(clickhouse_version_line "$target_version") == "$(clickhouse_version_line "$client_version")" ]] ||
    die "ClickHouse restore client and target major.minor versions do not match"
  free_bytes=$(clickhouse_value "SELECT toString(free_space) FROM system.disks WHERE name = 'default' FORMAT TSVRaw")
  [[ "$free_bytes" =~ ^[0-9]+$ ]] || die "cannot determine ClickHouse target capacity"
  source_bytes=$(jq -r '.components.clickhouse.source_uncompressed_bytes' "$manifest")
  required_bytes=$((source_bytes + MIN_FREE_BYTES))
  ((free_bytes >= required_bytes)) || die "insufficient ClickHouse target capacity"
}

restore_clickhouse() {
  local target=$1 manifest="$VERIFIED_BUNDLE/manifest.json"
  local table_entry table engine schema_file data_file expected_metrics actual_metrics expected_partitions actual_partitions
  local schema_file_actual schema_hash schema_fingerprint expected_schema_fingerprint table_count
  local fingerprint_input="$WORK_DIR/restored-clickhouse-schema-fingerprint"
  : > "$fingerprint_input"

  run_clickhouse_query "$target" "CREATE TABLE $RESTORE_GUARD (backup_id String) ENGINE = TinyLog"
  run_clickhouse_query "$target" "INSERT INTO $RESTORE_GUARD VALUES ('$MANIFEST_BACKUP_ID')"
  while IFS= read -r table_entry; do
    table=$(jq -r '.name' <<< "$table_entry")
    schema_file=$(clickhouse_verified_path "$table" 'schema.sql')
    data_file=$(clickhouse_verified_path "$table" 'native')
    run_clickhouse_input "$target" < "$schema_file"
    run_clickhouse_query_input "$target" "INSERT INTO $table FORMAT Native" < "$data_file"
  done < <(jq -c '.components.clickhouse.tables[]' "$manifest")

  while IFS= read -r table_entry; do
    table=$(jq -r '.name' <<< "$table_entry")
    engine=$(jq -r '.engine' <<< "$table_entry")
    [[ $(clickhouse_value "SELECT engine FROM system.tables WHERE database = '$target' AND name = '$table' FORMAT TSVRaw") == "$engine" ]] ||
      die "restored ClickHouse engine mismatch for table $table"
    schema_file_actual="$WORK_DIR/$table.restored-schema.sql"
    clickhouse_portable_schema "$target" "$table" > "$schema_file_actual"
    printf ';\n' >> "$schema_file_actual"
    schema_hash=$(sha256_file "$schema_file_actual")
    [[ "$schema_hash" == "$(jq -r '.schema.sha256' <<< "$table_entry")" ]] ||
      die "restored ClickHouse schema mismatch for table $table"
    printf '%s %s\n' "$table" "$schema_hash" >> "$fingerprint_input"

    expected_metrics=$(jq -r '[.row_count, .watermark.min, .watermark.max, .aggregate_checksum.value] | @tsv' <<< "$table_entry")
    actual_metrics=$(clickhouse_table_metrics "$target" "$table" "$(jq -r '.watermark.column' <<< "$table_entry")")
    [[ "$actual_metrics" == "$expected_metrics" ]] ||
      die "restored ClickHouse aggregate mismatch for table $table"
    expected_partitions=$(jq -Sc '.partitions' <<< "$table_entry")
    actual_partitions=$(clickhouse_partitions "$target" "$table" | jq -Sc -s 'map({id: .id, rows: (.rows | tonumber)})')
    [[ "$actual_partitions" == "$expected_partitions" ]] ||
      die "restored ClickHouse partition mismatch for table $table"
  done < <(jq -c '.components.clickhouse.tables[]' "$manifest")

  schema_fingerprint=$(sha256_file "$fingerprint_input")
  expected_schema_fingerprint=$(jq -r '.components.clickhouse.schema_fingerprint_sha256' "$manifest")
  [[ "$schema_fingerprint" == "$expected_schema_fingerprint" ]] ||
    die "restored ClickHouse schema fingerprint mismatch"
  table_count=$(clickhouse_value "SELECT count() FROM system.tables WHERE database = '$target' FORMAT TSVRaw")
  [[ "$table_count" == "$(( $(jq -r '.components.clickhouse.table_count' "$manifest") + 1 ))" ]] ||
    die "restored ClickHouse table count mismatch"
}

finalize_clickhouse_restore() {
  run_clickhouse_query "$1" "DROP TABLE $RESTORE_GUARD SYNC"
}

cleanup_clickhouse_restore() {
  local target=$1 table
  while IFS= read -r table; do
    validate_clickhouse_identifier "$table"
    run_clickhouse_query "$target" "DROP TABLE IF EXISTS $table SYNC" || return 1
  done < <(jq -r '.components.clickhouse.tables[].name' "$VERIFIED_BUNDLE/manifest.json")
  run_clickhouse_query "$target" "DROP TABLE IF EXISTS $RESTORE_GUARD SYNC" || return 1
  [[ $(clickhouse_value "SELECT count() FROM system.tables WHERE database = '$target' FORMAT TSVRaw") == "0" ]]
}

cleanup_postgresql_restore() {
  run_psql -q --single-transaction -c \
    'DROP SCHEMA public CASCADE; CREATE SCHEMA public AUTHORIZATION pg_database_owner;' || return 1
  [[ $(psql_value "SELECT (SELECT count(*) FROM pg_namespace WHERE nspname NOT IN ('pg_catalog','information_schema','public') AND nspname !~ '^pg_toast') + (SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public') + (SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public') + (SELECT count(*) FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace WHERE n.nspname='public')") == "0" ]]
}

restore_command() {
  local target_database="" confirmation="" expected_app_version="" migrations_dir="" bundle="" age_identity=""
  local clickhouse_target="" clickhouse_confirmation=""
  local expected_source_cluster_id="" expected_backup_id="" expected_manifest_sha256=""
  local signing_public_key="" expected_signing_key_id="" postgresql_target_free_bytes=""
  local target_server_version target_major manifest_major object_count restore_check_label required_bytes
  while (($#)); do
    case "$1" in
      --bundle)
        [[ -z "$bundle" && $# -ge 2 ]] || usage
        bundle=$2; shift 2 ;;
      --target-database)
        [[ -z "$target_database" && $# -ge 2 ]] || usage
        target_database=$2; shift 2 ;;
      --confirm-empty-target)
        [[ -z "$confirmation" && $# -ge 2 ]] || usage
        confirmation=$2; shift 2 ;;
      --expected-app-version)
        [[ -z "$expected_app_version" && $# -ge 2 ]] || usage
        expected_app_version=$2; shift 2 ;;
      --migrations-dir)
        [[ -z "$migrations_dir" && $# -ge 2 ]] || usage
        migrations_dir=$2; shift 2 ;;
      --age-identity-file)
        [[ -z "$age_identity" && $# -ge 2 ]] || usage
        age_identity=$2; shift 2 ;;
      --expected-source-cluster-id)
        [[ -z "$expected_source_cluster_id" && $# -ge 2 ]] || usage
        expected_source_cluster_id=$2; shift 2 ;;
      --expected-backup-id)
        [[ -z "$expected_backup_id" && $# -ge 2 ]] || usage
        expected_backup_id=$2; shift 2 ;;
      --expected-manifest-sha256)
        [[ -z "$expected_manifest_sha256" && $# -ge 2 ]] || usage
        expected_manifest_sha256=$2; shift 2 ;;
      --signing-public-key-file)
        [[ -z "$signing_public_key" && $# -ge 2 ]] || usage
        signing_public_key=$2; shift 2 ;;
      --expected-signing-key-id)
        [[ -z "$expected_signing_key_id" && $# -ge 2 ]] || usage
        expected_signing_key_id=$2; shift 2 ;;
      --postgresql-target-free-bytes)
        [[ -z "$postgresql_target_free_bytes" && $# -ge 2 ]] || usage
        postgresql_target_free_bytes=$2; shift 2 ;;
      --clickhouse-target-database)
        [[ -z "$clickhouse_target" && $# -ge 2 ]] || usage
        clickhouse_target=$2; shift 2 ;;
      --confirm-empty-clickhouse-target)
        [[ -z "$clickhouse_confirmation" && $# -ge 2 ]] || usage
        clickhouse_confirmation=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ -n "$bundle" && -n "$target_database" && -n "$confirmation" && -n "$expected_app_version" &&
    -n "$migrations_dir" && -n "$age_identity" && -n "$expected_source_cluster_id" &&
    -n "$expected_backup_id" && -n "$expected_manifest_sha256" && -n "$signing_public_key" &&
    -n "$expected_signing_key_id" && -n "$postgresql_target_free_bytes" ]] || usage
  validate_database_name "$target_database"
  [[ "$confirmation" == "$target_database" ]] || die "--confirm-empty-target must exactly match --target-database"
  [[ "$postgresql_target_free_bytes" =~ ^[0-9]+$ ]] || die "PostgreSQL target free bytes is invalid"
  verify_bundle "$bundle" "$expected_app_version" "$migrations_dir" "$age_identity" \
    "$expected_source_cluster_id" "$expected_backup_id" "$expected_manifest_sha256" \
    "$signing_public_key" "$expected_signing_key_id"

  validate_db_environment
  [[ "$PGDATABASE" == "$target_database" ]] || die "PGDATABASE must exactly match --target-database"
  target_server_version=$(psql_value "SELECT current_setting('server_version_num')")
  [[ "$target_server_version" =~ ^[0-9]{6}$ ]] || die "invalid target PostgreSQL server version"
  target_major=$((10#$target_server_version / 10000))
  manifest_major=$((10#$MANIFEST_SERVER_VERSION_NUM / 10000))
  [[ "$target_major" == "$manifest_major" ]] ||
    die "target PostgreSQL major $target_major does not match backup major $manifest_major"
  [[ $(client_major) == "$target_major" ]] || die "PostgreSQL restore client major does not match target"
  required_bytes=$(($(jq -r '.components.postgresql.database.source_size_bytes' "$VERIFIED_BUNDLE/manifest.json") + MIN_FREE_BYTES))
  ((postgresql_target_free_bytes >= required_bytes)) || die "insufficient PostgreSQL target capacity"

  object_count=$(psql_value "SELECT (SELECT count(*) FROM pg_namespace WHERE nspname NOT IN ('pg_catalog','information_schema','public') AND nspname !~ '^pg_toast') + (SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public') + (SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public') + (SELECT count(*) FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace WHERE n.nspname='public')")
  [[ "$object_count" == "0" ]] || die "target database is not empty; refusing restore"
  if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
    [[ -n "$clickhouse_target" && -n "$clickhouse_confirmation" ]] ||
      die "ClickHouse backup requires an explicit empty ClickHouse target"
    preflight_clickhouse_restore "$clickhouse_target" "$clickhouse_confirmation"
  elif [[ -n "$clickhouse_target" || -n "$clickhouse_confirmation" ]]; then
    die "ClickHouse target was supplied for a PostgreSQL-only backup"
  fi

  if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
    if ! (restore_clickhouse "$clickhouse_target"); then
      cleanup_clickhouse_restore "$clickhouse_target" ||
        die "ClickHouse restore failed and compensation failed; target remains quarantined"
      die "ClickHouse restore failed; created ClickHouse objects were removed"
    fi
  fi
  if ! run_pg_restore_database "$VERIFIED_DUMP"; then
    if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
      cleanup_clickhouse_restore "$clickhouse_target" ||
        die "PostgreSQL restore rolled back but ClickHouse compensation failed; target remains quarantined"
    fi
    die "PostgreSQL restore failed and its single transaction was rolled back"
  fi
  if ! (restore_checks "$migrations_dir"); then
    cleanup_postgresql_restore ||
      die "PostgreSQL restore verification failed and compensation failed; target remains quarantined"
    if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
      cleanup_clickhouse_restore "$clickhouse_target" ||
        die "restore verification failed and ClickHouse compensation failed; target remains quarantined"
    fi
    die "restore verification failed; restored objects were removed"
  fi
  restore_check_label="migrations,core-tables,constraints,audit-linkage"
  if [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "true" ]]; then
    if ! finalize_clickhouse_restore "$clickhouse_target"; then
      cleanup_postgresql_restore ||
        die "ClickHouse finalization failed and PostgreSQL compensation failed; targets remain quarantined"
      cleanup_clickhouse_restore "$clickhouse_target" ||
        die "ClickHouse finalization and compensation failed; target remains quarantined"
      die "ClickHouse finalization failed; restored objects were removed"
    fi
    restore_check_label+=",clickhouse-schema,clickhouse-partitions,clickhouse-watermarks,clickhouse-aggregates"
  fi
  printf 'restored_backup_id=%s\n' "$MANIFEST_BACKUP_ID"
  printf 'restored_target_database=%s\n' "$target_database"
  [[ "$MANIFEST_CLICKHOUSE_PRESENT" == "false" ]] ||
    printf 'restored_clickhouse_target_database=%s\n' "$clickhouse_target"
  printf 'restore_checks=%s\n' "$restore_check_label"
}

remote_fetch_command() {
  local output_dir="" expected_app_version="" migrations_dir="" age_identity=""
  local expected_source_cluster_id="" expected_backup_id="" expected_manifest_sha256=""
  local signing_public_key="" expected_signing_key_id="" commit filename sha256 size_bytes destination
  local commit_objects actual_objects created_at stamp
  while (($#)); do
    case "$1" in
      --output-dir)
        [[ -z "$output_dir" && $# -ge 2 ]] || usage
        output_dir=$2; shift 2 ;;
      --expected-app-version)
        [[ -z "$expected_app_version" && $# -ge 2 ]] || usage
        expected_app_version=$2; shift 2 ;;
      --migrations-dir)
        [[ -z "$migrations_dir" && $# -ge 2 ]] || usage
        migrations_dir=$2; shift 2 ;;
      --age-identity-file)
        [[ -z "$age_identity" && $# -ge 2 ]] || usage
        age_identity=$2; shift 2 ;;
      --expected-source-cluster-id)
        [[ -z "$expected_source_cluster_id" && $# -ge 2 ]] || usage
        expected_source_cluster_id=$2; shift 2 ;;
      --expected-backup-id)
        [[ -z "$expected_backup_id" && $# -ge 2 ]] || usage
        expected_backup_id=$2; shift 2 ;;
      --expected-manifest-sha256)
        [[ -z "$expected_manifest_sha256" && $# -ge 2 ]] || usage
        expected_manifest_sha256=$2; shift 2 ;;
      --signing-public-key-file)
        [[ -z "$signing_public_key" && $# -ge 2 ]] || usage
        signing_public_key=$2; shift 2 ;;
      --expected-signing-key-id)
        [[ -z "$expected_signing_key_id" && $# -ge 2 ]] || usage
        expected_signing_key_id=$2; shift 2 ;;
      --remote-endpoint)
        [[ -z "$REMOTE_ENDPOINT" && $# -ge 2 ]] || usage
        REMOTE_ENDPOINT=$2; shift 2 ;;
      --remote-region)
        [[ -z "$REMOTE_REGION" && $# -ge 2 ]] || usage
        REMOTE_REGION=$2; shift 2 ;;
      --remote-bucket)
        [[ -z "$REMOTE_BUCKET" && $# -ge 2 ]] || usage
        REMOTE_BUCKET=$2; shift 2 ;;
      --remote-prefix)
        [[ -z "$REMOTE_PREFIX" && $# -ge 2 ]] || usage
        REMOTE_PREFIX=$2; shift 2 ;;
      --remote-credentials-file)
        [[ -z "$REMOTE_CREDENTIALS_FILE" && $# -ge 2 ]] || usage
        REMOTE_CREDENTIALS_FILE=$2; shift 2 ;;
      --remote-retention-mode)
        [[ -z "$REMOTE_RETENTION_MODE" && $# -ge 2 ]] || usage
        REMOTE_RETENTION_MODE=$2; shift 2 ;;
      --remote-retention-days)
        [[ -z "$REMOTE_RETENTION_DAYS" && $# -ge 2 ]] || usage
        REMOTE_RETENTION_DAYS=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ -n "$output_dir" && -n "$expected_app_version" && -n "$migrations_dir" &&
    -n "$age_identity" && -n "$expected_source_cluster_id" && -n "$expected_backup_id" &&
    -n "$expected_manifest_sha256" && -n "$signing_public_key" &&
    -n "$expected_signing_key_id" ]] || usage
  validate_directory "$output_dir" "output directory"
  validate_remote_config true
  validate_backup_id "$expected_backup_id"
  validate_sha256 "$expected_manifest_sha256"
  require_command jq
  require_command python3
  new_work_dir
  remote_preflight

  BACKUP_OUTPUT_DIR="$output_dir"
  BACKUP_TMP=$(mktemp -d "$output_dir/.control-backup.remote-fetch.tmp.XXXXXX")
  chmod 700 "$BACKUP_TMP"
  commit="$BACKUP_TMP/.remote-commit.json"
  if ! remote_download "$REMOTE_PREFIX/bundles/$expected_backup_id/commit.json" "$commit"; then
    die "remote commit marker is unavailable or not immutable"
  fi
  validate_remote_commit "$commit" "$expected_backup_id" "$expected_manifest_sha256"
  while IFS=$'\t' read -r filename sha256 size_bytes; do
    validate_remote_filename "$filename"
    mkdir -p "$(dirname "$BACKUP_TMP/$filename")"
    if ! remote_download "$REMOTE_PREFIX/bundles/$expected_backup_id/$filename" \
      "$BACKUP_TMP/$filename" "$sha256" "$size_bytes"; then
      die "remote object download failed digest/size/immutability verification: $filename"
    fi
  done < <(jq -r '.objects[] | [.filename, .sha256, .size_bytes] | @tsv' "$commit")
  commit_objects="$WORK_DIR/commit-objects.json"
  jq -S -c '.objects' "$commit" > "$commit_objects"
  rm -f -- "$commit"
  actual_objects="$WORK_DIR/fetched-objects.json"
  remote_build_object_list "$BACKUP_TMP" "$actual_objects"
  cmp -s "$actual_objects" "$commit_objects" || die "downloaded remote bundle does not match its exact commit"

  rm -rf -- "$WORK_DIR" || die "remote fetch scratch cleanup failed before offline verification"
  WORK_DIR=""
  verify_bundle "$BACKUP_TMP" "$expected_app_version" "$migrations_dir" "$age_identity" \
    "$expected_source_cluster_id" "$expected_backup_id" "$expected_manifest_sha256" \
    "$signing_public_key" "$expected_signing_key_id"
  find "$BACKUP_TMP" -type f -exec chmod 600 {} +
  fsync_tree "$BACKUP_TMP"
  created_at=$(jq -r '.created_at' "$BACKUP_TMP/manifest.json")
  stamp=${created_at//[-:]/}
  destination="$output_dir/control-backup-$stamp-$expected_backup_id"
  [[ ! -e "$destination" && ! -L "$destination" ]] || die "remote fetch destination already exists"
  mv -- "$BACKUP_TMP" "$destination"
  PUBLISHED_DIR="$destination"
  BACKUP_TMP=""
  if ! fsync_path "$output_dir"; then
    rm -rf -- "$PUBLISHED_DIR" || die "remote fetch parent fsync failed and bundle removal failed"
    PUBLISHED_DIR=""
    fsync_path "$output_dir" || die "remote fetch parent fsync failed and removal was not durably synchronized"
    die "remote fetch parent directory fsync failed; unpublished bundle was removed"
  fi
  PUBLISHED_DIR=""
  printf 'bundle_path=%s\n' "$destination"
  printf 'fetched_backup_id=%s\n' "$expected_backup_id"
  printf 'fetched_manifest_sha256=%s\n' "$expected_manifest_sha256"
}

main() {
  (($# >= 1)) || usage
  local command=$1
  shift
  case "$command" in
    backup) backup_command "$@" ;;
    remote-fetch) remote_fetch_command "$@" ;;
    verify) verify_command "$@" ;;
    restore) restore_command "$@" ;;
    -h | --help | help) usage ;;
    *) usage ;;
  esac
}

main "$@"
