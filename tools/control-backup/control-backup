start_pg_snapshot() {
  local input_fifo="$WORK_DIR/postgresql-snapshot.in"
  local output_fifo="$WORK_DIR/postgresql-snapshot.out"
  local error_file="$WORK_DIR/postgresql-snapshot.err"
  local metrics
  mkfifo "$input_fifo" "$output_fifo"
  PGAPPNAME=cdnca-control-backup-snapshot run_psql -Atq \
    < "$input_fifo" > "$output_fifo" 2> "$error_file" &
  PG_SNAPSHOT_PID=$!
  exec 8> "$input_fifo"
  exec 9< "$output_fifo"
  PG_SNAPSHOT_FDS_OPEN="true"
  printf '%s\n' \
    "BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ, READ ONLY;" \
    "SELECT pg_export_snapshot();" \
    "SELECT json_build_object(" \
    "  'database', current_database()," \
    "  'server_version_num', current_setting('server_version_num')," \
    "  'server_version', current_setting('server_version')," \
    "  'database_size', pg_database_size(current_database())," \
    "  'missing_required', (SELECT count(*) FROM (VALUES ('schema_migrations'),('tenants'),('access_scopes'),('users'),('audit_events'),('billing_transactions'),('billing_postings')) AS required(name) WHERE to_regclass('public.' || name) IS NULL)," \
    "  'migration_versions', (SELECT string_agg(version::text, ',' ORDER BY version) FROM schema_migrations)," \
    "  'public_table_count', (SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p'))," \
    "  'migration_row_count', (SELECT count(*) FROM schema_migrations)," \
    "  'tenant_count', (SELECT count(*) FROM tenants)," \
    "  'user_count', (SELECT count(*) FROM users)," \
    "  'audit_count', (SELECT count(*) FROM audit_events)," \
    "  'audit_max_position', (SELECT COALESCE(max(stream_position),0) FROM audit_events)," \
    "  'audit_max_occurred_at', (SELECT COALESCE(to_char(max(occurred_at) AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'),'') FROM audit_events)," \
    "  'transaction_count', (SELECT count(*) FROM billing_transactions)," \
    "  'transaction_amount', (SELECT COALESCE(sum(amount_minor),0) FROM billing_transactions)," \
    "  'posting_count', (SELECT count(*) FROM billing_postings)," \
    "  'posting_debit', (SELECT COALESCE(sum(amount_minor) FILTER (WHERE side='debit'),0) FROM billing_postings)," \
    "  'posting_credit', (SELECT COALESCE(sum(amount_minor) FILTER (WHERE side='credit'),0) FROM billing_postings)" \
    ")::text;" >&8
  if ! IFS= read -r PG_SNAPSHOT_ID <&9; then
    die "PostgreSQL snapshot session ended before exporting a snapshot"
  fi
  [[ "$PG_SNAPSHOT_ID" =~ ^[0-9A-Fa-f-]+$ ]] || die "invalid PostgreSQL exported snapshot ID"
  if ! IFS= read -r metrics <&9; then
    die "PostgreSQL snapshot session ended before collecting logical metrics"
  fi
  jq -e 'type == "object"' <<< "$metrics" >/dev/null ||
    die "PostgreSQL snapshot metrics are invalid"
  PG_SNAPSHOT_METRICS_FILE="$WORK_DIR/postgresql-snapshot-metrics.json"
  printf '%s\n' "$metrics" > "$PG_SNAPSHOT_METRICS_FILE"
}

close_pg_snapshot() {
  local mode=${1:-rollback} status=0 snapshot_pid=$PG_SNAPSHOT_PID
  [[ -n "$snapshot_pid" ]] || return
  if [[ "$PG_SNAPSHOT_FDS_OPEN" == "true" ]]; then
    if [[ "$mode" == "rollback" ]] && kill -0 "$snapshot_pid" >/dev/null 2>&1; then
      printf 'ROLLBACK;\n' >&8 || status=1
    fi
    exec 8>&-
    cat <&9 >/dev/null || status=1
    exec 9<&-
    PG_SNAPSHOT_FDS_OPEN="false"
  fi
  if [[ "$mode" == "abort" ]] && kill -0 "$snapshot_pid" >/dev/null 2>&1; then
    kill "$snapshot_pid" >/dev/null 2>&1 || status=1
  fi
  wait "$snapshot_pid" >/dev/null 2>&1 || {
    [[ "$mode" == "abort" ]] || status=1
  }
  PG_SNAPSHOT_PID=""
  ((status == 0))
}

new_backup_id() {
