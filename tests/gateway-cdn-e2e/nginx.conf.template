# CDN stand-in for tests/gateway-cdn-e2e (GW-03): terminates the node's TLS
# with its own edge certificate (cdn.e2e.test), pulls the WebSocket tunnel
# from the Gateway's shared port over verified TLS and sets the node address
# in X-Real-IP like a CDN's client-IP header.
worker_processes 1;
error_log /dev/stderr notice;
events { worker_connections 256; }
http {
    access_log /dev/stdout;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    server {
        listen 8443 ssl;
        server_name cdn.e2e.test;
        ssl_certificate     /cdn/edge.pem;
        ssl_certificate_key /cdn/edge-key.pem;
        location /agent/v1/tunnel {
            proxy_pass https://host.docker.internal:__GATEWAY_PORT__;
            proxy_http_version 1.1;
            proxy_ssl_server_name on;
            proxy_ssl_name localhost;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /cdn/origin-ca.pem;
            proxy_set_header Host localhost;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP 203.0.113.77;
            proxy_buffering off;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }
    }
}
