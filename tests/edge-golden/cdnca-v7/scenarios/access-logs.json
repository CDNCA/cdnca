{
  "name": "access-logs",
  "description": "访问与安全日志：签名遥测身份下的访问日志字段（主机、状态、字节、回源、缓存、通配子域）与 WAF 拦截安全事件；时间、请求 ID、耗时等掩码。",
  "covers": [
    "访问日志",
    "安全日志",
    "遥测身份"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b200f-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b200f-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        },
        {
          "name": "waf",
          "api_version": 1
        }
      ],
      "sites": [
        {
          "id": "0a1b200f-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "logs.example.test",
            "*.logs.example.test"
          ],
          "listeners": [
            {
              "id": "l-18094",
              "position": 0,
              "address_family": "ipv4",
              "port": 18094,
              "protocols": [
                "http1"
              ],
              "security": {
                "policies": [
                  {
                    "kind": "waf",
                    "policy_id": "0a1b200f-0000-4000-8000-0000000000d1",
                    "policy_version": 2,
                    "binding_revision": 1,
                    "runtime_sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                    "enabled": true,
                    "default_action": "allow",
                    "rules": [
                      {
                        "rule_id": "0a1b200f-0000-4000-8000-0000000000e1",
                        "match": {
                          "path": {
                            "kind": "prefix",
                            "value": "/blocked"
                          }
                        },
                        "action": "block",
                        "flow": "stop"
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19351,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "health_port": 18914
    },
    "telemetry": {
      "tenant_id": "0a1b9999-0000-4000-8000-000000000003",
      "installation_id": "0a1b9999-0000-4000-8000-000000000004",
      "subscriptions": {
        "0a1b200f-0000-4000-8000-000000000101": "0a1b9999-0000-4000-8000-000000000005"
      }
    }
  },
  "origins": [
    {
      "name": "logs",
      "address": "127.0.0.1:19351",
      "routes": [
        {
          "path": "/missing",
          "status": 404,
          "body": "nf"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "ok",
      "port": 18094,
      "host": "logs.example.test",
      "path": "/a?b=1",
      "headers": {
        "Referer": "http://r.example.test/",
        "User-Agent": "golden-log/1"
      }
    },
    {
      "id": "wildcard",
      "port": 18094,
      "host": "x.logs.example.test",
      "path": "/w"
    },
    {
      "id": "post",
      "port": 18094,
      "host": "logs.example.test",
      "path": "/form",
      "method": "POST",
      "body": "k=v"
    },
    {
      "id": "origin-404",
      "port": 18094,
      "host": "logs.example.test",
      "path": "/missing"
    },
    {
      "id": "blocked",
      "port": 18094,
      "host": "logs.example.test",
      "path": "/blocked/x"
    },
    {
      "id": "drain",
      "kind": "logs"
    }
  ],
  "mask": {
    "log_fields": [
      "time_local",
      "msec",
      "timestamp",
      "start_time",
      "duration_ms",
      "bytes_sent",
      "upstream_connect_time",
      "upstream_header_time",
      "upstream_addr",
      "remote_port",
      "client_port"
    ]
  }
}
