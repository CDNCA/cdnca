{
  "name": "host-routing",
  "description": "按 Host 选站：同端口两个站点，主域名、别名、前导通配（含多级子域）、大小写、带端口的 Host、未配置的 Host 与缺省 Host；nginx server_name 语义为精确 > 最长前导通配，*.a 不匹配 a。",
  "covers": ["多域名", "通配", "别名", "未知 Host", "server_name 语义"],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b0000-0000-4000-8000-000000000001",
      "source_revision": 11,
      "config_version_id": "0a1b0000-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {"name": "http1", "api_version": 1},
        {"name": "ipv4", "api_version": 1},
        {"name": "ipv6", "api_version": 1},
        {"name": "site_runtime", "api_version": 6}
      ],
      "sites": [
        {
          "id": "0a1b0000-0000-4000-8000-000000000101",
          "revision": 3,
          "domains": ["shop.example.test", "www.shop.example.test", "*.shop.example.test"],
          "listeners": [{"id": "http-18080", "position": 0, "address_family": "dual_stack", "port": 18080, "protocols": ["http1"]}],
          "origin_pools": [{
            "id": "primary", "position": 0, "kind": "origin", "algorithm": "round_robin",
            "origins": [{"id": "o1", "position": 0, "tier": "origin", "scheme": "http", "host": "127.0.0.1", "port": 19101, "weight": 1}],
            "retry": {"methods": ["GET", "HEAD"], "bodyless_only": true, "response_not_started": true,
              "retry_on": ["connect_error", "connect_timeout", "read_timeout", "http_502", "http_503", "http_504"],
              "max_attempts": 1, "connect_timeout_ms": 2000, "read_timeout_ms": 5000, "total_budget_ms": 10000}
          }],
          "default_pool_id": "primary", "websocket": false, "range": false,
          "l2": {"enabled": false, "probe_interval_ms": 10000, "failure_threshold": 3, "recovery_threshold": 3, "single_half_open_probe": true, "max_hops": 1}
        },
        {
          "id": "0a1b0000-0000-4000-8000-000000000102",
          "revision": 5,
          "domains": ["api.shop.example.test", "*.eu.shop.example.test", "blog.example.test"],
          "listeners": [{"id": "http-18080", "position": 0, "address_family": "dual_stack", "port": 18080, "protocols": ["http1"]}],
          "origin_pools": [{
            "id": "primary", "position": 0, "kind": "origin", "algorithm": "round_robin",
            "origins": [{"id": "o2", "position": 0, "tier": "origin", "scheme": "http", "host": "127.0.0.1", "port": 19102, "weight": 1}],
            "retry": {"methods": ["GET", "HEAD"], "bodyless_only": true, "response_not_started": true,
              "retry_on": ["connect_error", "connect_timeout", "read_timeout", "http_502", "http_503", "http_504"],
              "max_attempts": 1, "connect_timeout_ms": 2000, "read_timeout_ms": 5000, "total_budget_ms": 10000}
          }],
          "default_pool_id": "primary", "websocket": false, "range": false,
          "l2": {"enabled": false, "probe_interval_ms": 10000, "failure_threshold": 3, "recovery_threshold": 3, "single_half_open_probe": true, "max_hops": 1}
        }
      ]
    },
    "node": {"health_port": 18981}
  },
  "origins": [
    {"name": "shop", "address": "127.0.0.1:19101"},
    {"name": "api", "address": "127.0.0.1:19102"}
  ],
  "steps": [
    {"id": "primary", "port": 18080, "host": "shop.example.test", "path": "/a?x=1"},
    {"id": "alias", "port": 18080, "host": "www.shop.example.test", "path": "/"},
    {"id": "wildcard-one-level", "port": 18080, "host": "img.shop.example.test", "path": "/i.png"},
    {"id": "wildcard-two-levels", "port": 18080, "host": "a.b.shop.example.test", "path": "/"},
    {"id": "exact-beats-wildcard", "port": 18080, "host": "api.shop.example.test", "path": "/v1"},
    {"id": "longest-wildcard", "port": 18080, "host": "x.eu.shop.example.test", "path": "/"},
    {"id": "wildcard-not-bare", "port": 18080, "host": "eu.shop.example.test", "path": "/", "note": "*.eu 不匹配 eu 本身，落到 *.shop"},
    {"id": "other-alias", "port": 18080, "host": "blog.example.test", "path": "/post"},
    {"id": "uppercase-host", "port": 18080, "host": "SHOP.Example.Test", "path": "/"},
    {"id": "host-with-port", "port": 18080, "host": "shop.example.test:18080", "path": "/"},
    {"id": "unknown-host", "port": 18080, "host": "unknown.example.test", "path": "/"},
    {"id": "parent-of-wildcard", "port": 18080, "host": "example.test", "path": "/"},
    {"id": "ip-host", "port": 18080, "host": "127.0.0.1", "path": "/"},
    {"id": "head", "method": "HEAD", "port": 18080, "host": "shop.example.test", "path": "/h"},
    {"id": "post-body", "method": "POST", "port": 18080, "host": "api.shop.example.test", "path": "/submit", "body": "a=1&b=2",
      "headers": {"Content-Type": "application/x-www-form-urlencoded"}},
    {"id": "ipv6-listener", "address": "::1", "port": 18080, "host": "shop.example.test", "path": "/v6"}
  ]
}
