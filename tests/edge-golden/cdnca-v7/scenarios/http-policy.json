            "policy.example.test"
          ],
          "redirects": [
            {
              "rule_id": "rd-301",
              "priority": 10,
              "match_kind": "exact",
              "match_path": "/moved",
              "status": 301,
              "target_url": "https://policy.example.test/new-home",
              "preserve_query": true,
              "preserve_path": false
            },
            {
              "rule_id": "rd-302",
              "priority": 20,
              "match_kind": "prefix",
              "match_path": "/go/",
              "status": 302,
              "target_url": "https://policy.example.test/landing",
              "preserve_query": false,
              "preserve_path": false
            },
            {
              "rule_id": "rd-307",
              "priority": 30,
              "match_kind": "exact",
              "match_path": "/temp",
              "status": 307,
              "target_url": "https://policy.example.test/temp2",
              "preserve_query": false,
              "preserve_path": false
            },
            {
              "rule_id": "rd-308",
              "priority": 40,
              "match_kind": "exact",
              "match_path": "/ext",
              "status": 308,
              "target_url": "https://docs.example.test/page",
              "preserve_query": false,
              "preserve_path": false
            }
          ],
          "cors": {
            "allowed_origins": [
              "https://app.example.test"
            ],
            "allowed_methods": [
              "GET",
              "PUT"
            ],
            "allowed_headers": [
              "x-token"
            ],
            "exposed_headers": [
              "x-edge"
            ],
            "allow_credentials": true,
            "max_age_seconds": 600
          },
          "referer_check": {
            "allow_empty": true,
            "allow_same_domain": true,
            "allowed_domains": [
              "*.partner.example.test"
            ],
            "denied_domains": [
              "bad.partner.example.test"
            ],
            "check_origin": true,
            "extensions": [
