{
  "name": "site-access",
  "description": "GoEdge 对照 G4 站点访问设置：主机跳转（保留路径参数、ACME 例外）、强制 HTTPS 308 与排除域名、HSTS 只在 HTTPS 发送、站点 gzip 类型、Basic 认证（凭据不回源、排除前缀、错误密码 401）、维护页（放行网段）。",
  "covers": [
    "主机跳转",
    "强制 HTTPS 状态码",
    "排除域名",
    "HSTS",
    "站点压缩",
    "Basic 认证",
    "维护页"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b2022-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b2022-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "http2",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "ipv6",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 7
        }
      ],
      "sites": [
        {
          "id": "0a1b2022-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "secure.example.test",
            "old.example.test",
            "plain.example.test"
          ],
          "listeners": [
            {
              "id": "l-18836",
              "position": 0,
              "address_family": "dual_stack",
              "port": 18836,
              "protocols": [
                "http1"
              ]
            },
            {
              "id": "l-18837",
              "position": 1,
              "address_family": "dual_stack",
              "port": 18837,
              "protocols": [
                "http1",
                "http2"
              ],
              "tls": {
                "certificate_version_id": "0a1b2022-0000-4000-8000-0000000000a1"
              }
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19836,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          },
          "force_https": {
            "redirect_port": 18837,
            "status": 308,
            "exclude_hosts": [
              "plain.example.test"
            ]
          },
          "access": {
            "host_redirects": [
              {
                "source_host": "old.example.test",
                "target_host": "www.example.test",
                "target_scheme": "follow",
                "status": 301,
                "preserve_uri": true
              }
            ],
            "hsts": {
              "max_age_seconds": 31536000,
              "include_subdomains": true,
              "preload": true
            },
            "compression": {
              "enabled": true,
              "types": [
                "application/json"
              ],
              "min_length_bytes": 16
            },
            "basic_auth": {
              "realm": "staff",
              "users": [
                {
                  "username": "alice",
                  "salt": "000102030405060708090a0b0c0d0e0f",
                  "sha256": "bb913cc836b213896ba4e54fc1d1c54bc72242421085f10ac4944db11bd9f191"
                }
              ],
              "exclude_path_prefixes": [
                "/public/"
              ]
            }
          }
        },
        {
          "id": "0a1b2022-0000-4000-8000-000000000102",
          "revision": 1,
          "domains": [
            "plain-other.example.test"
          ],
          "listeners": [
            {
              "id": "l-18836",
              "position": 0,
              "address_family": "dual_stack",
              "port": 18836,
              "protocols": [
                "http1"
              ]
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o2",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19837,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          },
          "access": {
            "maintenance": {
              "status": 503,
              "content_type": "text/plain",
              "body": "down for maintenance",
              "retry_after_seconds": 120,
              "allowed_cidrs": [
                "127.0.0.2/32"
              ]
            }
          }
        }
      ],
      "lazy_certificates": {
        "cache_max": 10000
      }
    },
    "node": {
      "certificates": [
        {
          "site_id": "0a1b2022-0000-4000-8000-000000000101",
          "version_id": "0a1b2022-0000-4000-8000-0000000000a1",
          "revision": 1,
          "serial": 222,
          "names": [
            "secure.example.test",
            "old.example.test",
            "plain.example.test"
          ]
        }
      ],
      "health_port": 18838
    }
  },
  "origins": [
    {
      "name": "secure",
      "address": "127.0.0.1:19836",
      "routes": [
        {
          "path": "/json",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"k\":\"v\"},{\"k\":\"v\"},{\"k\":\"v\"},{\"k\":\"v\"},{\"k\":\"v\"},{\"k\":\"v\"}"
        }
      ]
    },
    {
      "name": "plain",
      "address": "127.0.0.1:19837"
    }
  ],
  "steps": [
    {
      "id": "host-redirect",
      "port": 18836,
      "host": "old.example.test",
      "path": "/a/b?c=1"
    },
    {
      "id": "host-redirect-acme",
      "port": 18836,
      "host": "old.example.test",
      "path": "/.well-known/acme-challenge/token123"
    },
    {
      "id": "force-https-308",
      "port": 18836,
      "host": "secure.example.test",
      "path": "/x?y=2"
    },
    {
      "id": "excluded-no-auth",
      "port": 18836,
      "host": "plain.example.test",
      "path": "/x"
    },
    {
      "id": "excluded-with-auth",
      "port": 18836,
      "host": "plain.example.test",
      "path": "/x",
      "headers": {
        "Authorization": "Basic YWxpY2U6czNjcmV0"
      }
    },
    {
      "id": "excluded-wrong-password",
      "port": 18836,
      "host": "plain.example.test",
      "path": "/x",
      "headers": {
        "Authorization": "Basic YWxpY2U6d3Jvbmc="
      }
    },
    {
      "id": "excluded-public-prefix",
      "port": 18836,
      "host": "plain.example.test",
      "path": "/public/ping"
    },
    {
      "id": "https-gzip-hsts",
      "port": 18837,
      "host": "secure.example.test",
      "path": "/json",
      "scheme": "https",
      "headers": {
        "Authorization": "Basic YWxpY2U6czNjcmV0",
        "Accept-Encoding": "gzip"
      }
    },
    {
      "id": "https-401-hsts",
      "port": 18837,
      "host": "secure.example.test",
      "path": "/nope",
      "scheme": "https"
    },
    {
      "id": "maintenance",
      "port": 18836,
      "host": "plain-other.example.test",
      "path": "/any"
    },
    {
      "id": "maintenance-allowed",
      "port": 18836,
      "host": "plain-other.example.test",
      "path": "/any",
      "source": "127.0.0.2"
    }
  ]
}
