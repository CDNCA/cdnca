{
  "name": "js-challenge",
  "description": "JS 挑战（click 模式）：HTML 请求得到挑战页、别名同样挑战、绕过路由直达源站、非浏览器请求（Accept 非 HTML）的处理、无效 cookie 不放行。",
  "covers": [
    "JS 挑战",
    "绕过路由",
    "别名"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b200d-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b200d-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        }
      ],
      "sites": [
        {
          "id": "0a1b200d-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "challenge.example.test",
            "alias.challenge.example.test"
          ],
          "listeners": [
            {
              "id": "l-18092",
              "position": 0,
              "address_family": "ipv4",
              "port": 18092,
              "protocols": [
                "http1"
              ],
              "security": {
                "challenge": {
                  "tenant_id": "0a1b9999-0000-4000-8000-000000000002",
                  "policy_id": "0a1b200d-0000-4000-8000-0000000000c0",
                  "policy_version": 7
                }
              }
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19331,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "challenges": [
        {
          "policy_id": "0a1b200d-0000-4000-8000-0000000000c0",
          "policy": {
            "schema_version": "cdnca.edge.challenge/v1",
            "policy_version": 7,
            "algorithm": "hmac-sha256",
            "cookie_name": "__Host-cdnca_challenge",
            "trusted_proxies": [],
            "bypass_routes": [
              {
                "kind": "exact",
                "path": "/healthz-origin"
              },
              {
                "kind": "prefix",
                "path": "/static/"
              }
            ],
            "rules": [
              {
                "rule_id": "click",
                "priority": 10,
                "tenant_id": "0a1b9999-0000-4000-8000-000000000002",
                "site_id": "0a1b200d-0000-4000-8000-000000000101",
                "host": "challenge.example.test",
                "mode": "click",
                "min_delay_seconds": 0,
                "challenge_ttl_seconds": 60,
                "pass_ttl_seconds": 300,
                "clock_skew_seconds": 1,
                "attempts_per_nonce": 1,
                "failure_window_seconds": 30,
                "max_failures_per_window": 20,
                "ip_binding": "exact",
                "bind_user_agent": true
              }
            ]
          }
        }
      ],
      "health_port": 18912
    }
  },
  "origins": [
    {
      "name": "challenge",
      "address": "127.0.0.1:19331"
    }
  ],
  "steps": [
    {
      "id": "page",
      "port": 18092,
      "host": "challenge.example.test",
      "path": "/item",
      "headers": {
        "Accept": "text/html"
      }
    },
    {
      "id": "alias-page",
      "port": 18092,
      "host": "alias.challenge.example.test",
      "path": "/item",
      "headers": {
        "Accept": "text/html"
      }
    },
    {
      "id": "bypass-exact",
      "port": 18092,
      "host": "challenge.example.test",
      "path": "/healthz-origin",
      "headers": {
        "Accept": "text/html"
      }
    },
    {
      "id": "bypass-prefix",
      "port": 18092,
      "host": "challenge.example.test",
      "path": "/static/app.js",
      "headers": {
        "Accept": "text/html"
      }
    },
    {
      "id": "api-accept",
      "port": 18092,
      "host": "challenge.example.test",
      "path": "/api",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "id": "bad-cookie",
      "port": 18092,
      "host": "challenge.example.test",
      "path": "/item",
      "headers": {
        "Accept": "text/html",
        "Cookie": "__Host-cdnca_challenge=forged"
      }
    }
  ],
  "mask": {
    "patterns": [
      "[A-Za-z0-9_-]{32,}",
      "nonce-[A-Za-z0-9_-]+",
      "nonce=\"[A-Za-z0-9_-]+\"",
      "value=\"[A-Za-z0-9_.~-]{16,}\"",
      "\\b1[0-9]{9}\\b"
    ],
    "response_headers": [
      "set-cookie"
    ]
  }
}
