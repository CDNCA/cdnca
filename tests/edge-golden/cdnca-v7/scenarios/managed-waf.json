{
  "name": "managed-waf",
  "description": "托管 WAF（OWASP CRS）：正常请求放行、查询串 SQL 注入与 XSS 拦截、POST 表单 SQL 注入拦截、放行网段豁免。",
  "covers": [
    "托管 WAF",
    "CRS",
    "SQL 注入",
    "XSS"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b2010-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b2010-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        },
        {
          "name": "waf",
          "api_version": 3
        }
      ],
      "sites": [
        {
          "id": "0a1b2010-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "crs.example.test"
          ],
          "listeners": [
            {
              "id": "l-18095",
              "position": 0,
              "address_family": "ipv4",
              "port": 18095,
              "protocols": [
                "http1"
              ],
              "security": {
                "managed_waf": {
                  "policy_id": "0a1b2010-0000-4000-8000-0000000000d1",
                  "policy_version": 3,
                  "request_body_limit": 1048576,
                  "request_body_no_files_limit": 131072,
                  "request_body_limit_action": "reject",
                  "arguments_limit": 1000,
                  "json_depth_limit": 512,
                  "pcre_match_limit": 100000,
                  "inspection_limit_action": "block",
                  "profile": {
                    "pack_id": "system/crs-pl1",
                    "version": "1.4.0",
                    "sha256": "782892a2e0076b68af5ed4f9bdca1a77da1f0dd928393fb6af71a634ff9d9873"
                  },
                  "allow_cidrs": [
                    "127.0.0.8/32"
                  ]
                }
              }
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19361,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "health_port": 18915
    },
    "crs": true
  },
  "origins": [
    {
      "name": "crs",
      "address": "127.0.0.1:19361"
    }
  ],
  "steps": [
    {
      "id": "clean",
      "port": 18095,
      "host": "crs.example.test",
      "path": "/search?q=hello"
    },
    {
      "id": "sqli-query",
      "port": 18095,
      "host": "crs.example.test",
      "path": "/search?id=1%27%20OR%20%271%27%3D%271"
    },
    {
      "id": "xss-query",
      "port": 18095,
      "host": "crs.example.test",
      "path": "/search?q=%3Cscript%3Ealert(1)%3C%2Fscript%3E"
    },
    {
      "id": "sqli-form",
      "port": 18095,
      "host": "crs.example.test",
      "path": "/login",
      "method": "POST",
      "body": "user=admin'--&pass=x' UNION SELECT password FROM users--",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      }
    },
    {
      "id": "allowed-cidr",
      "port": 18095,
      "host": "crs.example.test",
      "path": "/search?id=1%27%20OR%20%271%27%3D%271",
      "source": "127.0.0.8"
    }
  ],
  "requires": [
    "managed_waf"
  ]
}
