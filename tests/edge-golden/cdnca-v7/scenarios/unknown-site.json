{
  "name": "unknown-site",
  "description": "GoEdge 对照 G4 域名不匹配：没有站点承接的 Host 返回平台 unknown_site 页（选定 410），站点自己的源站 404 原样透传（全局专用页不进站点状态码），已知 Host 正常回源。",
  "covers": [
    "域名不匹配页",
    "unknown_site",
    "410"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b2021-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b2021-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        }
      ],
      "sites": [
        {
          "id": "0a1b2021-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "known.example.test"
          ],
          "listeners": [
            {
              "id": "l-18834",
              "position": 0,
              "address_family": "ipv4",
              "port": 18834,
              "protocols": [
                "http1"
              ]
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19834,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 500,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "error_pages": {
        "schema": "cdnca.error-pages/v1",
        "version": "v1",
        "revision": 1,
        "global": {
          "rules": [
            {
              "id": "unknown-site",
              "category": "unknown_site",
              "match": {
                "codes": [
                  410
                ]
              },
              "resource": {
                "mime_type": "text/plain",
                "inline": "this domain is not served here"
              }
            }
          ]
        },
        "sites": []
      },
      "health_port": 18835
    }
  },
  "origins": [
    {
      "name": "origin",
      "address": "127.0.0.1:19834",
      "routes": [
        {
          "path": "/missing",
          "status": 404,
          "body": "origin 404 body"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "unknown-host",
      "port": 18834,
      "host": "stranger.example.test",
      "path": "/x"
    },
    {
      "id": "known-origin-404",
      "port": 18834,
      "host": "known.example.test",
      "path": "/missing"
    },
    {
      "id": "known-host",
      "port": 18834,
      "host": "known.example.test",
      "path": "/"
    }
  ]
}
