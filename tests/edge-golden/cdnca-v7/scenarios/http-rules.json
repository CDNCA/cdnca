{
  "name": "http-rules",
  "description": "GoEdge 对照 G4：正则重写（捕获组回源）、正则重定向（捕获组转义进 Location）、前缀重定向保留后续路径（含查询）、普通前缀重定向不保留、同端口未绑定策略的站点不受影响。",
  "covers": [
    "正则重写",
    "正则重定向",
    "保留后续路径"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b2020-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b2020-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "ipv6",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        }
      ],
      "sites": [
        {
          "id": "0a1b2020-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "policy.example.test",
            "alias.policy.example.test"
          ],
          "listeners": [
            {
              "id": "l-18823",
              "position": 0,
              "address_family": "dual_stack",
              "port": 18823,
              "protocols": [
                "http1"
              ]
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19823,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          },
          "http_policy": {
            "policy_id": "0a1b2020-0000-4000-8000-0000000000b1",
            "policy_revision": 3,
            "artifact_sha256": "${http_policy_sha256}"
          }
        },
        {
          "id": "0a1b2020-0000-4000-8000-000000000102",
          "revision": 1,
          "domains": [
            "nopolicy.example.test"
          ],
          "listeners": [
            {
              "id": "l-18823",
              "position": 0,
              "address_family": "dual_stack",
              "port": 18823,
              "protocols": [
                "http1"
              ]
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o2",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19824,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "health_port": 18824
    },
    "http_policy": {
      "schema_version": "cdnca.edge.http-policy/v1",
      "policy_version": 3,
      "sites": [
        {
          "site_id": "0a1b2020-0000-4000-8000-000000000101",
          "max_upload_bytes": 4096,
          "request_headers": [],
          "response_headers": [],
          "rewrites": [
            {
              "rule_id": "rw-regex",
              "priority": 10,
              "match_kind": "regex",
              "match_path": "^/item/([0-9]+)/(\\w+)$",
              "target_path": "/items/$2/$1",
              "preserve_query": true,
              "preserve_cookie": true
            }
          ],
          "redirect_allowed_hosts": [
            "new.example.test"
          ],
          "redirects": [
            {
              "rule_id": "rd-regex",
              "priority": 20,
              "match_kind": "regex",
              "match_path": "^/u/(.+)$",
              "status": 301,
              "target_url": "https://new.example.test/users/$1",
              "preserve_query": false,
              "preserve_path": false
            },
            {
              "rule_id": "rd-keep",
              "priority": 30,
              "match_kind": "prefix",
              "match_path": "/docs/",
              "status": 302,
              "target_url": "https://new.example.test/manual/",
              "preserve_query": true,
              "preserve_path": true
            },
            {
              "rule_id": "rd-fixed",
              "priority": 40,
              "match_kind": "prefix",
              "match_path": "/old/",
              "status": 302,
              "target_url": "https://new.example.test/landing",
              "preserve_query": false,
              "preserve_path": false
            }
          ],
          "cors": null,
          "referer_check": null
        }
      ]
    }
  },
  "origins": [
    {
      "name": "policy",
      "address": "127.0.0.1:19823"
    },
    {
      "name": "plain",
      "address": "127.0.0.1:19824"
    }
  ],
  "steps": [
    {
      "id": "rewrite-regex",
      "port": 18823,
      "host": "policy.example.test",
      "path": "/item/42/shoes?c=1"
    },
    {
      "id": "rewrite-regex-miss",
      "port": 18823,
      "host": "policy.example.test",
      "path": "/item/x/shoes"
    },
    {
      "id": "redirect-regex",
      "port": 18823,
      "host": "policy.example.test",
      "path": "/u/a%20b"
    },
    {
      "id": "redirect-keep-path",
      "port": 18823,
      "host": "policy.example.test",
      "path": "/docs/guide/intro.html?x=1"
    },
    {
      "id": "redirect-keep-root",
      "port": 18823,
      "host": "policy.example.test",
      "path": "/docs/"
    },
    {
      "id": "redirect-prefix-fixed",
      "port": 18823,
      "host": "policy.example.test",
      "path": "/old/a/b?q=1"
    },
    {
      "id": "other-site",
      "port": 18823,
      "host": "nopolicy.example.test",
      "path": "/docs/guide"
    }
  ]
}
