{
  "name": "cc",
  "description": "CC v2：固定窗口超限 429、临时封禁（超限后同路径与其他路径各自的表现）、always 跳转挑战页、log 动作不拦截、其他 IP 独立计数（签名策略的 allowlist 恒为空）；按客户端的临时封禁进内核封禁队列（健康端口 /cc-kernel-bans 取出一次）。",
  "covers": [
    "CC",
    "429",
    "封禁",
    "挑战",
    "白名单",
    "内核封禁队列"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b200c-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b200c-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "cc",
          "api_version": 3
        },
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        }
      ],
      "sites": [
        {
          "id": "0a1b200c-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "cc.example.test"
          ],
          "listeners": [
            {
              "id": "l-18091",
              "position": 0,
              "address_family": "ipv4",
              "port": 18091,
              "protocols": [
                "http1"
              ],
              "security": {
                "cc": {
                  "SourceSHA256": "auto",
                  "CompiledSHA256": "auto",
                  "Policy": {
                    "schema_version": "cdnca.edge.cc/v2",
                    "tenant_scope_id": "0a1b200c-0000-4000-8000-000000000001",
                    "site_id": "0a1b200c-0000-4000-8000-000000000101",
                    "policy_id": "0a1b200c-0000-4000-8000-0000000000f1",
                    "policy_version": 1,
                    "binding_id": "0a1b200c-0000-4000-8000-0000000000f2",
                    "binding_revision": 1,
                    "publication_id": "0a1b200c-0000-4000-8000-0000000000f3",
                    "enabled": true,
                    "trusted_proxies": [],
                    "allowlist": [],
                    "rules": [
                      {
                        "rule_id": "0a1b200c-0000-4000-8000-000000000f11",
                        "priority": 10,
                        "flow": "stop",
                        "match": {
                          "path": {
                            "kind": "prefix",
                            "value": "/limited"
                          }
                        },
                        "dimension": "client_ip",
                        "limit": {
                          "algorithm": "fixed_window",
                          "requests": 3,
                          "window_seconds": 60
                        },
                        "action": {
                          "kind": "reject_429"
                        }
                      },
                      {
                        "rule_id": "0a1b200c-0000-4000-8000-000000000f12",
                        "priority": 20,
                        "flow": "stop",
                        "match": {
                          "path": {
                            "kind": "prefix",
                            "value": "/ban"
                          }
                        },
                        "dimension": "client_ip",
                        "limit": {
                          "algorithm": "fixed_window",
                          "requests": 2,
                          "window_seconds": 60
                        },
                        "action": {
                          "kind": "temporary_ban",
                          "ban_seconds": 120
                        }
                      },
                      {
                        "rule_id": "0a1b200c-0000-4000-8000-000000000f13",
                        "priority": 30,
                        "flow": "stop",
                        "match": {
                          "path": {
                            "kind": "prefix",
                            "value": "/challenge"
                          }
                        },
                        "dimension": "client_ip",
                        "limit": {
                          "algorithm": "always"
                        },
                        "action": {
                          "kind": "challenge",
                          "ban_seconds": 120,
                          "challenge": {
                            "mode": "redirect",
                            "failure_window_seconds": 60,
                            "max_failures": 50,
                            "pass_seconds": 600,
                            "challenge_seconds": 120,
                            "bind_ipv4_prefix": 32,
                            "bind_ipv6_prefix": 64,
                            "key_rotate_seconds": 3600
                          }
                        }
                      },
                      {
                        "rule_id": "0a1b200c-0000-4000-8000-000000000f14",
                        "priority": 40,
                        "flow": "continue",
                        "match": {
                          "path": {
                            "kind": "prefix",
                            "value": "/logged"
                          }
                        },
                        "dimension": "client_ip",
                        "limit": {
                          "algorithm": "fixed_window",
                          "requests": 1,
                          "window_seconds": 60
                        },
                        "action": {
                          "kind": "log"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19321,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "health_port": 18911
    }
  },
  "origins": [
    {
      "name": "cc",
      "address": "127.0.0.1:19321"
    }
  ],
  "steps": [
    {
      "id": "limited",
      "port": 18091,
      "host": "cc.example.test",
      "path": "/limited",
      "repeat": 5
    },
    {
      "id": "limited-other-ip",
      "port": 18091,
      "host": "cc.example.test",
      "path": "/limited",
      "source": "127.0.0.6"
    },
    {
      "id": "ban",
      "port": 18091,
      "host": "cc.example.test",
      "path": "/ban",
      "repeat": 4,
      "source": "127.0.0.7"
    },
    {
      "id": "banned-elsewhere",
      "port": 18091,
      "host": "cc.example.test",
      "path": "/other",
      "source": "127.0.0.7"
    },
    {
      "id": "kernel-ban-queue",
      "port": 18911,
      "host": "localhost",
      "path": "/healthz/cc-kernel-bans",
      "note": "r136 ge-ddos: the client ban above is queued once for the Agent's kernel ban (tenant scope|site|client|until)"
    },
    {
      "id": "kernel-ban-queue-drained",
      "port": 18911,
      "host": "localhost",
      "path": "/healthz/cc-kernel-bans"
    },
    {
      "id": "challenge",
      "port": 18091,
      "host": "cc.example.test",
      "path": "/challenge/x",
      "headers": {
        "Accept": "text/html"
      }
    },
    {
      "id": "logged",
      "port": 18091,
      "host": "cc.example.test",
      "path": "/logged",
      "repeat": 3
    }
  ],
  "mask": {
    "patterns": [
      "[A-Za-z0-9_-]{32,}",
      "nonce=[^&\"' ]+",
      "\\b1[0-9]{9}\\b"
    ],
    "response_headers": [
      "set-cookie",
      "location"
    ]
  }
}
