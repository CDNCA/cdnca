  "origins": [
    {
      "name": "ws",
      "address": "127.0.0.1:19261",
      "websocket": true,
      "routes": [
        {
          "path": "/file",
          "body": "0123456789abcdefghij",
          "ranges": true,
          "headers": {
            "ETag": "\"e1\""
          }
        }
      ]
    },
    {
      "name": "nows",
      "address": "127.0.0.1:19262",
      "websocket": true,
      "routes": [
        {
          "path": "/file",
          "body": "0123456789abcdefghij",
          "ranges": true
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "ws-echo",
      "kind": "websocket",
      "port": 18085,
      "host": "ws.example.test",
      "path": "/socket",
      "message": "hello"
    },
    {
      "id": "ws-disabled",
      "kind": "websocket",
      "port": 18085,
      "host": "nows.example.test",
      "path": "/socket",
      "message": "hello"
    },
    {
      "id": "range-single",
      "port": 18085,
      "host": "ws.example.test",
      "path": "/file",
      "headers": {
        "Range": "bytes=2-5"
      }
    },
    {
      "id": "range-suffix",
      "port": 18085,
      "host": "ws.example.test",
      "path": "/file",
      "headers": {
        "Range": "bytes=-3"
      }
    },
    {
      "id": "range-multi",
      "port": 18085,
      "host": "ws.example.test",
      "path": "/file",
      "headers": {
        "Range": "bytes=0-1,4-5"
      }
    },
    {
      "id": "range-unsatisfiable",
      "port": 18085,
      "host": "ws.example.test",
      "path": "/file",
      "headers": {
        "Range": "bytes=100-200"
      }
    },
    {
      "id": "range-if-range",
      "port": 18085,
      "host": "ws.example.test",
      "path": "/file",
      "headers": {
        "Range": "bytes=0-3",
        "If-Range": "\"other\""
      }
    },
    {
      "id": "range-off-site",
      "port": 18085,
      "host": "nows.example.test",
      "path": "/file",
      "headers": {
        "Range": "bytes=2-5"
      }
    }
  ],
  "mask": {
    "origin_headers": [
      "sec-websocket-key"
    ],
    "patterns": [
      "boundary=[0-9a-f]+",
      "--[0-9a-f]{40,}"
    ]
  }
