{
  "name": "http-policy-cache",
  "description": "HTTP 策略与缓存同站：缓存未命中、命中与 BYPASS（POST）三种响应都带策略的响应头（add/set/delete），请求头仍按策略改写；同节点无策略站点不受影响。",
  "covers": [
    "响应头",
    "请求头",
    "缓存"
  ],
  "facts": {
    "document": {
      "schema": "cdnca.edge.site-runtime/v2",
      "configuration_scope_id": "0a1b2009-0000-4000-8000-000000000001",
      "source_revision": 7,
      "config_version_id": "0a1b2009-0000-4000-8000-0000000000c1",
      "required_capabilities": [
        {
          "name": "http1",
          "api_version": 1
        },
        {
          "name": "ipv4",
          "api_version": 1
        },
        {
          "name": "ipv6",
          "api_version": 1
        },
        {
          "name": "site_runtime",
          "api_version": 6
        }
      ],
      "sites": [
        {
          "id": "0a1b2009-0000-4000-8000-000000000101",
          "revision": 1,
          "domains": [
            "policy.example.test",
            "alias.policy.example.test"
          ],
          "listeners": [
            {
              "id": "l-18088",
              "position": 0,
              "address_family": "dual_stack",
              "port": 18088,
              "protocols": [
                "http1"
              ]
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o1",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19291,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          },
          "http_policy": {
            "policy_id": "0a1b2009-0000-4000-8000-0000000000b1",
            "policy_revision": 3,
            "artifact_sha256": "${http_policy_sha256}"
          },
          "cache": {
            "tenant_id": "0a1b9999-0000-4000-8000-000000000002",
            "domain": "policy.example.test",
            "policy": {
              "revision": 1,
              "mode": "override",
              "rules": [],
              "query_mode": "preserve",
              "query_names": [],
              "vary_headers": [],
              "disk_quota_bytes": 67108864
            }
          }
        },
        {
          "id": "0a1b2009-0000-4000-8000-000000000102",
          "revision": 1,
          "domains": [
            "nopolicy.example.test"
          ],
          "listeners": [
            {
              "id": "l-18088",
              "position": 0,
              "address_family": "dual_stack",
              "port": 18088,
              "protocols": [
                "http1"
              ]
            }
          ],
          "origin_pools": [
            {
              "id": "primary",
              "position": 0,
              "kind": "origin",
              "algorithm": "round_robin",
              "origins": [
                {
                  "id": "o2",
                  "position": 0,
                  "tier": "origin",
                  "scheme": "http",
                  "host": "127.0.0.1",
                  "port": 19292,
                  "weight": 1
                }
              ],
              "retry": {
                "methods": [
                  "GET",
                  "HEAD"
                ],
                "bodyless_only": true,
                "response_not_started": true,
                "retry_on": [
                  "connect_error",
                  "connect_timeout",
                  "read_timeout",
                  "http_502",
                  "http_503",
                  "http_504"
                ],
                "max_attempts": 1,
                "connect_timeout_ms": 2000,
                "read_timeout_ms": 5000,
                "total_budget_ms": 10000
              }
            }
          ],
          "default_pool_id": "primary",
          "websocket": false,
          "range": false,
          "l2": {
            "enabled": false,
            "probe_interval_ms": 10000,
            "failure_threshold": 3,
            "recovery_threshold": 3,
            "single_half_open_probe": true,
            "max_hops": 1
          }
        }
      ]
    },
    "node": {
      "health_port": 18908
    },
    "http_policy": {
      "schema_version": "cdnca.edge.http-policy/v1",
      "policy_version": 3,
      "sites": [
        {
          "site_id": "0a1b2009-0000-4000-8000-000000000101",
          "max_upload_bytes": 4096,
          "request_headers": [
            {
              "kind": "add",
              "name": "X-Added",
              "values": [
                "a1",
                "a2"
              ]
            },
            {
              "kind": "set",
              "name": "X-Set",
              "values": [
                "edge"
              ]
            },
            {
              "kind": "delete",
              "name": "X-Drop",
              "values": []
            }
          ],
          "response_headers": [
            {
              "kind": "add",
              "name": "X-Edge",
              "values": [
                "yes"
              ]
            },
            {
              "kind": "set",
              "name": "X-Replace-Me",
              "values": [
                "edge"
              ]
            },
            {
              "kind": "delete",
              "name": "X-Remove-Me",
              "values": []
            }
          ],
          "rewrites": [
            {
              "rule_id": "rw-exact",
              "priority": 10,
              "match_kind": "exact",
              "match_path": "/old",
              "target_path": "/new",
              "preserve_query": true,
              "preserve_cookie": true
            },
            {
              "rule_id": "rw-prefix",
              "priority": 20,
              "match_kind": "prefix",
              "match_path": "/legacy/",
              "target_path": "/v2/",
              "preserve_query": false,
              "preserve_cookie": true
            }
          ],
          "redirect_allowed_hosts": [
            "docs.example.test",
            "policy.example.test"
          ],
          "redirects": [
            {
              "rule_id": "rd-301",
              "priority": 10,
              "match_kind": "exact",
              "match_path": "/moved",
              "status": 301,
              "target_url": "https://policy.example.test/new-home",
              "preserve_query": true,
              "preserve_path": false
            },
            {
              "rule_id": "rd-302",
              "priority": 20,
              "match_kind": "prefix",
              "match_path": "/go/",
              "status": 302,
              "target_url": "https://policy.example.test/landing",
              "preserve_query": false,
              "preserve_path": false
            },
            {
              "rule_id": "rd-307",
              "priority": 30,
              "match_kind": "exact",
              "match_path": "/temp",
              "status": 307,
              "target_url": "https://policy.example.test/temp2",
              "preserve_query": false,
              "preserve_path": false
            },
            {
              "rule_id": "rd-308",
              "priority": 40,
              "match_kind": "exact",
              "match_path": "/ext",
              "status": 308,
              "target_url": "https://docs.example.test/page",
              "preserve_query": false,
              "preserve_path": false
            }
          ],
          "cors": {
            "allowed_origins": [
              "https://app.example.test"
            ],
            "allowed_methods": [
              "GET",
              "PUT"
            ],
            "allowed_headers": [
              "x-token"
            ],
            "exposed_headers": [
              "x-edge"
            ],
            "allow_credentials": true,
            "max_age_seconds": 600
          },
          "referer_check": {
            "allow_empty": true,
            "allow_same_domain": true,
            "allowed_domains": [
              "*.partner.example.test"
            ],
            "denied_domains": [
              "bad.partner.example.test"
            ],
            "check_origin": true,
            "extensions": [
              "jpg"
            ]
          }
        }
      ]
    }
  },
  "origins": [
    {
      "name": "policy",
      "address": "127.0.0.1:19291",
      "routes": [
        {
          "path": "/resp",
          "body": "r",
          "headers": {
            "X-Remove-Me": "1",
            "X-Replace-Me": "origin",
            "Server": "origin"
          }
        }
      ]
    },
    {
      "name": "plain",
      "address": "127.0.0.1:19292"
    }
  ],
  "steps": [
    {
      "id": "response-headers-miss",
      "port": 18088,
      "host": "policy.example.test",
      "path": "/resp"
    },
    {
      "id": "response-headers-hit",
      "port": 18088,
      "host": "policy.example.test",
      "path": "/resp"
    },
    {
      "id": "response-headers-bypass",
      "port": 18088,
      "host": "policy.example.test",
      "path": "/resp",
      "method": "POST",
      "body": "x"
    },
    {
      "id": "headers",
      "port": 18088,
      "host": "policy.example.test",
      "path": "/h",
      "headers": {
        "X-Drop": "1",
        "X-Set": "client"
      }
    },
    {
      "id": "other-site",
      "port": 18088,
      "host": "nopolicy.example.test",
      "path": "/moved",
      "headers": {
        "X-Drop": "1"
      }
    }
  ]
}
