{
  "name": "@cdnca/www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public marketing site www.cdnca.com: static, prerendered, no accounts.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "package": "tar -C dist -cf www-dist.tar .",
    "catalog": "GOWORK=off go -C ../../tools/openapi-catalog run . -repo ../..",
    "catalog:check": "GOWORK=off go -C ../../tools/openapi-catalog run . -repo ../.. -check"
  },
  "dependencies": {
    "@cdnca/ui": "workspace:*",
    "lucide-react": "0.544.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
