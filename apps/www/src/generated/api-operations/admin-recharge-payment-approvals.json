     "in": "query",
     "type": "integer",
     "required": true
    },
    {
     "name": "limit",
     "in": "query",
     "type": "integer",
     "required": true
    },
    {
     "name": "kind",
     "in": "query",
     "type": "string: refund / void"
    },
    {
     "name": "state",
     "in": "query",
     "type": "string: pending / approved / rejected / expired"
    },
    {
     "name": "snapshot_at",
     "in": "query",
     "type": "string(date-time)"
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "稳定快照分页",
     "fields": [
      {
       "name": "items",
       "type": "array<Approval>",
       "required": true
      },
      {
       "name": "total",
       "type": "integer(int64)",
       "required": true
      },
      {
       "name": "page",
       "type": "integer",
       "required": true
      },
      {
       "name": "limit",
       "type": "integer",
       "required": true
      },
      {
       "name": "snapshot_at",
       "type": "string(date-time)",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "稳定错误码"
    },
    {
     "status": "401",
     "description": "稳定错误码"
    },
    {
     "status": "403",
     "description": "稳定错误码"
