   "operation_id": "listRechargePaymentApprovals",
   "method": "GET",
   "path": "/v1/admin/recharge-payment-approvals",
   "summary": "稳定快照分页读取充值审批",
   "auth": [
    "bearer"
   ],
   "permissions": [
    "billing.recharges.read"
   ],
   "params": [
    {
     "name": "X-Request-ID",
     "in": "header",
