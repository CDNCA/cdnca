{
 "id": "admin-dashboard",
 "prefix": "/v1/admin/dashboard",
 "operations": [
  {
   "operation_id": "getAdminDashboard",
   "method": "GET",
   "path": "/v1/admin/dashboard",
   "summary": "Read the platform administrator dashboard",
   "auth": [
    "bearer"
   ],
   "description": "Requires a live platform session and platform.admin. The calendar window is constructed in timezone, converted to a left-closed, right-open UTC window, and must remain hour aligned and no longer than 31 local calendar days (745 elapsed hours across a fall-back). Every query parameter is required, single-valued, and strict; unknown parameters and tenant_id are rejected.",
   "permissions": [
    "platform.admin"
   ],
   "params": [
    {
     "name": "range",
     "in": "query",
     "type": "string: seven_days / thirty_days / previous_month",
     "required": true,
     "description": "Platform calendar range in the requested timezone."
    },
    {
     "name": "timezone",
     "in": "query",
     "type": "string",
     "required": true,
     "description": "IANA timezone name other than Local. Calendar boundaries converted to UTC must be hour aligned; zones with a non-hour boundary offset are rejected rather than rounded."
    },
    {
     "name": "site_id",
     "in": "query",
     "type": "string(uuid)",
     "description": "Optional canonical site UUID for ClickHouse drill-down; tenant scope remains session-derived."
    },
    {
     "name": "node_id",
     "in": "query",
     "type": "string(uuid)",
     "description": "Optional canonical node UUID for ClickHouse drill-down; tenant scope remains session-derived."
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string",
     "description": "Optional safe correlation ID; invalid values are replaced."
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Version 2 platform dashboard snapshot.",
     "fields": [
      {
       "name": "dashboard_version",
       "type": "integer",
       "required": true
      },
      {
       "name": "meta",
       "type": "DashboardMeta",
       "required": true
      },
      {
       "name": "accounts",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "subscriptions",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "billing",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "resources",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "operations",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "operation_charts",
       "type": "object | UnavailableSection"
      },
      {
       "name": "entitlement",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "node_health",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "analytics_health",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "account_security",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "network",
       "type": "object | UnavailableSection",
       "required": true
      },
      {
       "name": "analytics",
       "type": "object | UnavailableSection",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "dashboard_invalid_request"
    },
    {
     "status": "401",
     "description": "dashboard_authentication_required"
    },
    {
     "status": "403",
     "description": "dashboard_scope_forbidden or dashboard_permission_denied"
    },
    {
     "status": "408",
     "description": "dashboard_request_cancelled"
    },
    {
     "status": "500",
     "description": "dashboard_internal_error"
    },
    {
     "status": "502",
     "description": "dashboard_response_too_large"
    },
    {
     "status": "503",
     "description": "dashboard_storage_unavailable; no zero-value data is substituted."
    },
    {
     "status": "504",
     "description": "dashboard_query_timeout"
    }
   ]
  }
 ]
}
