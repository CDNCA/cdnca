      {
       "name": "id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "scope_type",
       "type": "string: global / region / node",
       "required": true
      },
      {
       "name": "scope_id",
       "type": "string",
       "required": true
      },
      {
       "name": "scope_label",
       "type": "string"
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "config",
       "type": "Config",
       "required": true
      },
      {
       "name": "key_configured",
       "type": "boolean",
       "required": true
      },
      {
       "name": "updated_at",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "sources",
       "type": "object",
       "description": "Effective documents only (GET /v1/openresty-security/effective) - the layer each config field comes from."
      }
     ]
    },
