  {
   "operation_id": "patchGlobalOpenRestySecurityConfig",
   "method": "PATCH",
   "path": "/v1/openresty-security/configs/global",
   "summary": "",
   "summary_zh": "修改全局 OpenResty 安全配置",
   "auth": [
    "bearer"
   ],
   "description": "Applies the smallest auto-save patch. A logical retry must reuse the same Idempotency-Key.",
