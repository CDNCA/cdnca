  {
   "operation_id": "queueCCImageDownload",
   "method": "POST",
   "path": "/v1/openresty-security/actions/download-cc-image",
   "summary": "",
   "summary_zh": "排队下载 CC 验证图片资源",
   "auth": [
    "bearer"
   ],
   "permissions": [
    "openresty_security.manage"
   ],
   "params": [
    {
     "name": "Idempotency-Key",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string",
     "required": true
    }
   ],
   "responses": [
    {
     "status": "202",
     "description": "Durable download_cc_img task queued"
    },
    {
     "status": "401",
     "description": "Authentication required"
    },
    {
     "status": "403",
     "description": "Permission denied"
    },
    {
     "status": "409",
     "description": "Duplicate target or idempotency conflict"
    }
   ]
  },
  {
   "operation_id": "getGlobalOpenRestySecurityConfig",
   "method": "GET",
   "path": "/v1/openresty-security/configs/global",
