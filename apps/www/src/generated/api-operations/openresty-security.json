    "openresty_security.manage"
   ],
   "params": [
    {
     "name": "If-Match",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "Idempotency-Key",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string",
     "required": true
    }
   ],
   "body": {
    "content_types": [
     "application/json"
    ],
    "required": true,
    "fields": [
     {
      "name": "patch",
      "type": "Config",
      "required": true
     }
    ]
   },
   "responses": [
    {
     "status": "200",
     "description": "Current redacted configuration document",
     "fields": [
      {
       "name": "id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "scope_type",
       "type": "string: global / region / node",
       "required": true
      },
      {
       "name": "scope_id",
       "type": "string",
       "required": true
      },
      {
       "name": "scope_label",
       "type": "string"
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "config",
       "type": "Config",
       "required": true
      },
      {
       "name": "key_configured",
       "type": "boolean",
       "required": true
      },
      {
       "name": "updated_at",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "sources",
       "type": "object",
       "description": "Effective documents only (GET /v1/openresty-security/effective) - the layer each config field comes from."
      }
     ]
    },
    {
     "status": "400",
     "description": "Invalid field, conditional value, range, or relationship"
    },
    {
     "status": "401",
     "description": "Authentication required"
    },
    {
     "status": "403",
     "description": "Permission denied"
    },
    {
     "status": "409",
     "description": "Duplicate target or idempotency conflict"
    },
    {
     "status": "412",
     "description": "If-Match revision conflict"
    }
   ]
  },
