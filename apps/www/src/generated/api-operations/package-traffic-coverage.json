{
 "id": "package-traffic-coverage",
 "prefix": "/v1/package-traffic-coverage",
 "operations": [
  {
   "operation_id": "listTenantPackageTrafficCoverage",
   "method": "GET",
   "path": "/v1/package-traffic-coverage",
   "summary": "查询本人套餐每个周期由全局流量包覆盖的流量（最近周期在前）",
   "auth": [
    "bearer"
   ],
   "params": [
    {
     "name": "subscription_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "limit",
     "in": "query",
     "type": "integer",
     "description": "返回的周期数，默认 12"
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "每个周期由流量包覆盖的流量（字节，十进制字符串）与扣量批次",
     "fields": [
      {
       "name": "subscription_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "items",
       "type": "array<PackageTrafficCoverageCycle>",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "稳定错误信封"
    },
    {
     "status": "401",
     "description": "稳定错误信封"
    },
    {
     "status": "403",
     "description": "稳定错误信封"
    },
    {
     "status": "404",
     "description": "稳定错误信封"
    },
    {
     "status": "408",
     "description": "稳定错误信封"
    },
    {
     "status": "503",
     "description": "稳定错误信封"
    }
   ]
  }
 ]
}
