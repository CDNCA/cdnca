      }
     ]
    },
    {
     "status": "400",
     "description": "Request validation failed (regions_validation_error)"
    },
    {
     "status": "401",
     "description": "Authentication is required (regions_unauthenticated)"
    },
    {
     "status": "403",
     "description": "Required region permission is missing (regions_permission_denied)"
    },
    {
     "status": "404",
