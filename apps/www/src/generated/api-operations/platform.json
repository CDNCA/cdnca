{
 "id": "platform",
 "prefix": "/v1/platform",
 "operations": [
  {
   "operation_id": "listPlatformPluginInstallations",
   "method": "GET",
   "path": "/v1/platform/plugin-installations",
   "summary": "List tenant plugin installation authorization state in the platform scope of the session (themes, rule data packs; exact plugin_installations.platform permissions)",
   "summary_zh": "列出平台范围插件安装的授权状态（平台）",
   "auth": [
    "bearer"
   ],
   "params": [
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "limit",
     "in": "query",
     "type": "integer"
    },
    {
     "name": "cursor",
     "in": "query",
     "type": "string"
    },
    {
     "name": "status",
     "in": "query",
     "type": "string: pending_confirmation / authorized / installing / enabled / disabled / upgrade_failed_lkg_preserved / uninstalled"
    },
    {
     "name": "plugin_id",
     "in": "query",
     "type": "string"
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Stable keyset page",
     "fields": [
      {
       "name": "items",
       "type": "array<PluginInstallation>",
       "required": true
      },
      {
       "name": "next_cursor",
       "type": "string"
      }
     ]
    },
    {
     "status": "400",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "401",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "403",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "502",
     "description": "Stable localized-client error envelope"
    }
   ]
  },
  {
   "operation_id": "getPlatformPluginInstallation",
   "method": "GET",
   "path": "/v1/platform/plugin-installations/{authorization_id}",
   "summary": "Read one tenant plugin installation authorization in the platform scope of the session (themes, rule data packs; exact plugin_installations.platform permissions)",
   "summary_zh": "读取一条平台范围插件安装授权（平台）",
   "auth": [
    "bearer"
   ],
   "params": [
    {
     "name": "authorization_id",
     "in": "path",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string",
     "required": true
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Plugin installation authorization state",
     "fields": [
      {
       "name": "schema",
       "type": "const cdnca.control.plugin-installation/v1",
       "required": true
      },
      {
       "name": "tenant_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "authorization_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "installation_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "verification_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "plugin_id",
       "type": "string",
       "required": true
      },
      {
       "name": "resource_scope",
       "type": "string: platform / tenant",
       "required": true,
       "description": "Signed by the license service from the verified manifest entrypoint. platform resources (themes, rule data packs) are confirmed only under /v1/platform; tenant plugins only under their tenant scope."
      },
      {
       "name": "entrypoint_type",
       "type": "string: theme / rule_pack / external_https / ui_page",
       "required": true,
       "description": "Plugin type, the verified manifest entrypoint type signed by the license service next to resource_scope (theme and rule_pack are platform resources, external_https and ui_page tenant plugins). Clients link a confirmed theme to theme management and a rule_pack to rule packs; they never infer the type themselves."
      },
      {
       "name": "version",
       "type": "string",
       "required": true
      },
      {
       "name": "manifest_sha256",
       "type": "string",
       "required": true
      },
      {
       "name": "configuration_schema_sha256",
       "type": "string",
       "required": true
      },
      {
       "name": "manifest_scopes",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "approved_scopes",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "sensitive_scopes",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "new_scopes",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "status",
       "type": "string: pending_confirmation / authorized / installing / enabled / disabled / upgrade_failed_lkg_preserved / uninstalled",
       "required": true
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "identity_generation",
       "type": "integer",
       "required": true
      },
      {
       "name": "lkg_verification_id",
       "type": "string(uuid) | null",
       "required": true
      },
      {
       "name": "lkg_version",
       "type": "string | null",
       "required": true
      },
      {
       "name": "stable_reason_code",
       "type": "string | null",
       "required": true
      },
      {
       "name": "updated_at",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "authorization_status",
       "type": "string: pending_confirmation / authorized / enabled / disabled",
       "description": "Platform authorization state reported by the license service. Omitted when the license service was not reachable. A locally enabled plugin whose authorization is disabled is paused by the platform. pending_confirmation marks a purchased market plugin waiting for this controller's administrator: confirm sends the confirmation to the license service and then installs it."
      },
      {
       "name": "paused_by",
       "type": "string: installation / operator / service",
       "description": "Who paused a disabled authorization, from the signed license snapshot. installation is this controller's own pause (resume allowed); operator (license operator) and service (market delisting or security advisory) are platform pauses this controller cannot resume. Omitted otherwise, and a disabled authorization without it is treated as a platform pause."
      },
      {
       "name": "paused_reason",
       "type": "string",
       "description": "The reason recorded with that pause. Omitted when the pause has none (a controller pause from 1.0.35 on asks for no reason; operator and service pauses still record one)."
      },
      {
       "name": "available_upgrade",
       "type": "PluginInstallationAvailableUpgrade",
       "description": "A newer version the platform already authorized for this installation; submit it to upgrade."
      },
      {
       "name": "managed_by",
       "type": "string: platform / tenant",
       "description": "Who confirms and changes an installed plugin. platform: the controller's platform administrator (every installation from 1.0.35; a tenant reads it but cannot change it, writes are 403 plugin_installation_platform_managed). tenant: a tenant's own installation confirmed before 1.0.35, still managed in that tenant console. Omitted on candidates not installed yet."
      },
      {
       "name": "targets",
       "type": "object",
       "description": "Tenants a platform-held tenant plugin is installed for. Platform view only; tenants never read it."
      }
     ]
    },
    {
     "status": "401",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "403",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "404",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "502",
     "description": "Stable localized-client error envelope"
    }
   ]
  },
  {
   "operation_id": "confirmPlatformPluginInstallation",
   "method": "POST",
   "path": "/v1/platform/plugin-installations/{authorization_id}/confirm",
   "summary": "Confirm declared and sensitive plugin scopes before installation in the platform scope of the session (exact plugin_installations.platform permissions). Themes and rule data packs install for the controller; tenant plugins (ui_page, external_https) require targets (all tenants or listed tenant scopes) and are then usable by those tenants without any tenant step. Targets on a platform resource, or a tenant plugin without them, is 422 plugin_installation_targets_invalid.",
   "summary_zh": "主控平台管理员确认安装：主题、规则包装在平台；页面插件、外部服务须指定装给哪些租户（全部租户/指定租户），确认后这些租户直接可用",
   "auth": [
    "bearer"
   ],
   "params": [
    {
     "name": "authorization_id",
     "in": "path",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "If-Match",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "Idempotency-Key",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string",
     "required": true
    }
   ],
   "body": {
    "content_types": [
     "application/json"
    ],
    "required": true,
    "fields": [
     {
      "name": "verification_id",
      "type": "string(uuid)",
      "required": true
     },
     {
      "name": "approved_scopes",
      "type": "array<string>",
      "required": true
     },
     {
      "name": "sensitive_permissions_confirmed",
      "type": "boolean",
      "required": true
     },
     {
      "name": "new_permissions_confirmed",
      "type": "boolean",
      "required": true
     },
     {
      "name": "targets",
      "type": "PluginInstallationTargets",
      "description": "Platform confirmation of a tenant plugin only (required there, refused elsewhere)."
     }
    ]
   },
   "responses": [
    {
     "status": "200",
     "description": "Durable mutation snapshot; replay returns the original snapshot",
     "fields": [
      {
       "name": "installation",
       "type": "PluginInstallation",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "401",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "403",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "404",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "409",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "422",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "502",
     "description": "Stable localized-client error envelope"
    },
    {
     "status": "503",
     "description": "Stable localized-client error envelope"
    }
   ]
  },
