    "required": true,
    "fields": [
     {
      "name": "all_tenants",
      "type": "boolean",
      "required": true
     },
     {
      "name": "tenant_scope_ids",
      "type": "array<string(uuid)>",
      "required": true
     }
    ]
   },
   "responses": [
