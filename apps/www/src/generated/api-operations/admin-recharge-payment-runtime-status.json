       "required": true
      },
      {
       "name": "ready",
       "type": "boolean",
       "required": true
      },
      {
       "name": "alipay",
       "type": "RechargePaymentProviderStatus",
       "required": true
      },
      {
       "name": "wechat",
       "type": "RechargePaymentProviderStatus",
       "required": true
      },
      {
