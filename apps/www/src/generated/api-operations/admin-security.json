{
 "id": "admin-security",
 "prefix": "/v1/admin/security",
 "operations": [
  {
   "operation_id": "getAdminSiteCCStats",
   "method": "GET",
   "path": "/v1/admin/security/cc-stats",
   "summary": "Read the CC rule statistics of a site of any tenant scope",
   "auth": [
    "bearer"
   ],
   "permissions": [
    "platform.admin",
    "security_policies.read"
   ],
   "params": [
    {
     "name": "tenant_scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "site_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "range",
     "in": "query",
     "type": "string: 1h / 6h / 24h",
     "description": "1h (1 minute steps, default), 6h (5 minutes) or 24h (15 minutes)."
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "The site's CC rule statistics.",
     "fields": [
      {
       "name": "tenant_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "range",
       "type": "string: 1h / 6h / 24h",
       "required": true
      },
      {
       "name": "site_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "from",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "to",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "step_seconds",
       "type": "integer: 60 / 300 / 900",
       "required": true
      },
      {
       "name": "series",
       "type": "array<object>",
       "required": true
      },
      {
       "name": "rules",
       "type": "array<object>",
       "required": true,
       "description": "Totals per CC rule, most triggered first; rule_id null is the site level count (a challenge ban outside any rule)."
      },
      {
       "name": "top_clients",
       "type": "array<Top>",
       "required": true
      },
      {
       "name": "top_paths",
       "type": "array<Top>",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "Error."
    },
    {
     "status": "401",
     "description": "Error."
    },
    {
     "status": "403",
     "description": "Error."
    },
    {
     "status": "404",
     "description": "Error."
    },
    {
     "status": "405",
     "description": "Error."
    },
    {
     "status": "503",
     "description": "Error."
    }
   ]
  },
  {
   "operation_id": "getSecurityCoordinationMetrics",
   "method": "GET",
   "path": "/v1/admin/security/coordination/metrics",
   "summary": "Read bounded cross-node CC and global firewall coordination counters",
   "auth": [
    "bearer"
   ],
   "description": "Returns fixed-cardinality process counters. Node, tenant, policy, subject, address, and message labels are never exposed.",
   "permissions": [
    "platform.admin",
    "security_policies.read"
   ],
   "responses": [
    {
     "status": "200",
     "description": "Fixed-cardinality in-process security coordination counters.",
     "fields": [
      {
       "name": "schema",
       "type": "string",
       "required": true
      },
      {
       "name": "cc",
       "type": "CCMetrics",
       "required": true
      },
      {
       "name": "firewall",
       "type": "FirewallMetrics",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "Stable error code without identity or dependency detail."
    },
    {
     "status": "401",
     "description": "Stable error code without identity or dependency detail."
    },
    {
     "status": "403",
     "description": "Stable error code without identity or dependency detail."
    },
    {
     "status": "405",
     "description": "Stable error code without identity or dependency detail."
    },
    {
     "status": "503",
     "description": "Stable error code without identity or dependency detail."
    }
   ]
  },
  {
   "operation_id": "createAdminJA4BlockWorkflow",
   "method": "POST",
   "path": "/v1/admin/security/ja4-blocks",
   "summary": "Create a tenant/site-scoped JA4 block as a platform administrator",
   "auth": [
    "bearer"
   ],
   "permissions": [
    "platform.admin",
    "security_policies.manage"
   ],
   "params": [
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string"
    },
    {
     "name": "Idempotency-Key",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "If-Match",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "X-Step-Up-Token",
     "in": "header",
     "type": "string",
     "required": true,
     "description": "Single-use proof consumed by the configured step-up verifier; never persisted."
    }
   ],
   "body": {
    "content_types": [
     "application/json"
    ],
    "required": true,
    "fields": [
     {
      "name": "site_id",
      "type": "string(uuid)",
      "required": true
     },
     {
      "name": "ja4",
      "type": "string",
      "required": true
     },
     {
      "name": "snapshot_at",
      "type": "string(date-time)",
      "required": true
     },
     {
      "name": "duration_seconds",
      "type": "integer",
      "required": true
     },
     {
      "name": "reason",
      "type": "string",
      "required": true
     },
     {
      "name": "tenant_scope_id",
      "type": "string(uuid)",
      "required": true
     }
    ]
   },
   "responses": [
    {
     "status": "202",
     "description": "Durable workflow created or exact idempotent replay returned.",
     "fields": [
      {
       "name": "id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "tenant_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "site_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "ja4_sha256",
       "type": "string",
       "required": true
      },
      {
       "name": "snapshot_at",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "duration_seconds",
       "type": "integer",
       "required": true
      },
      {
       "name": "reason",
       "type": "string",
       "required": true
      },
      {
       "name": "phase",
       "type": "string: queued / policy_ready / edge_pending / active / failed / expired",
       "required": true
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "policy_id",
       "type": "string(uuid)"
      },
      {
       "name": "policy_revision",
       "type": "integer"
      },
      {
       "name": "binding_id",
       "type": "string(uuid)"
      },
      {
       "name": "binding_revision",
       "type": "integer"
      },
      {
       "name": "edge_publication_id",
       "type": "string(uuid)"
      },
      {
       "name": "rollout_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "edge_state",
       "type": "string:  / pending / active / failed / rolled_back",
       "required": true
      },
      {
       "name": "attempt_count",
       "type": "integer",
       "required": true
      },
      {
       "name": "last_error_code",
       "type": "string"
      },
      {
       "name": "replayed",
       "type": "boolean"
      }
     ]
    },
    {
     "status": "400",
     "description": "Stable error response."
    },
    {
     "status": "401",
     "description": "Stable error response."
    },
    {
     "status": "403",
     "description": "Stable error response."
    },
    {
     "status": "409",
     "description": "Stable error response."
    },
    {
     "status": "412",
     "description": "Stable error response."
    },
    {
     "status": "428",
     "description": "Stable error response."
    },
    {
     "status": "503",
     "description": "Stable error response."
    }
   ]
  },
  {
   "operation_id": "getAdminJA4BlockWorkflow",
   "method": "GET",
   "path": "/v1/admin/security/ja4-blocks/{workflow_id}",
   "summary": "Get one exact tenant JA4 block workflow without raw access events",
   "auth": [
    "bearer"
   ],
   "permissions": [
    "platform.admin",
    "security_policies.read"
   ],
   "params": [
    {
     "name": "workflow_id",
     "in": "path",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string"
    },
    {
     "name": "tenant_scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Fixed workflow state; raw access events are never returned.",
     "fields": [
      {
       "name": "id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "tenant_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "site_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "ja4_sha256",
       "type": "string",
       "required": true
      },
      {
       "name": "snapshot_at",
       "type": "string(date-time)",
       "required": true
      },
      {
       "name": "duration_seconds",
       "type": "integer",
       "required": true
      },
      {
       "name": "reason",
       "type": "string",
       "required": true
      },
      {
       "name": "phase",
       "type": "string: queued / policy_ready / edge_pending / active / failed / expired",
       "required": true
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "policy_id",
       "type": "string(uuid)"
      },
      {
       "name": "policy_revision",
       "type": "integer"
      },
      {
       "name": "binding_id",
       "type": "string(uuid)"
      },
      {
       "name": "binding_revision",
       "type": "integer"
      },
      {
       "name": "edge_publication_id",
       "type": "string(uuid)"
      },
      {
       "name": "rollout_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "edge_state",
       "type": "string:  / pending / active / failed / rolled_back",
       "required": true
      },
      {
       "name": "attempt_count",
       "type": "integer",
       "required": true
      },
      {
       "name": "last_error_code",
       "type": "string"
      },
      {
       "name": "replayed",
       "type": "boolean"
      }
     ]
    },
    {
     "status": "400",
     "description": "Stable error response."
    },
    {
     "status": "401",
     "description": "Stable error response."
    },
    {
     "status": "403",
     "description": "Stable error response."
    },
    {
     "status": "404",
     "description": "Stable error response."
    },
    {
     "status": "503",
     "description": "Stable error response."
    }
   ]
  }
 ]
}
