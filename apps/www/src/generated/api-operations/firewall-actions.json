  {
   "operation_id": "getFirewallActionPolicy",
   "method": "GET",
   "path": "/v1/firewall-actions/policy",
   "summary": "Read the site's effective firewall action policy",
   "auth": [
    "bearer"
   ],
   "description": "A site without its own policy answers 200 with inherited=true and the tenant default (source tenant_default) or the undelivered system default (source system_default); 404 means the site is absent or outside the actor scope.",
   "permissions": [
    "firewall.read"
   ],
   "params": [
    {
     "name": "target_scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "site_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Desired, active, and LKG state",
     "fields": [
      {
       "name": "normal_action",
       "type": "string: disconnect / return_page",
       "required": true
      },
      {
       "name": "escalated_action",
       "type": "string: nftables",
       "required": true
      },
      {
       "name": "engage_threshold",
       "type": "integer",
       "required": true
      },
      {
       "name": "recover_threshold",
       "type": "integer",
       "required": true
      },
      {
       "name": "recovery_windows",
       "type": "integer",
       "required": true
      },
      {
       "name": "block_networks",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "trusted_proxies",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "trusted_crawlers",
       "type": "array<TrustedCrawler>",
       "required": true
      },
      {
       "name": "return_page",
       "type": "ReturnPage",
       "required": true
      },
      {
       "name": "id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "tenant_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "site_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true,
       "description": "The site's own revision counter, the If-Match of its next PUT (0: never had its own policy)."
      },
      {
       "name": "active_revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "lkg_revision",
       "type": "integer",
       "required": true
      },
      {
       "name": "deployment_state",
       "type": "string: pending / active / failed / inherited",
       "required": true
      },
      {
       "name": "inherited",
       "type": "boolean",
       "required": true,
       "description": "No policy of the site's own; the fields are the effective tenant or system default."
      },
      {
       "name": "source",
       "type": "string: site / tenant_default / system_default",
       "required": true
      },
      {
       "name": "delivered",
       "type": "boolean",
       "required": true,
       "description": "Whether nodes receive the policy; false only for the system default."
      },
      {
       "name": "enabled",
       "type": "boolean",
       "required": true,
       "description": "false - the site's own policy is disabled, not delivered to the nodes (revisions and LKG kept); always true while inherited"
      },
      {
       "name": "host_escalation",
       "type": "string: owned / shared_unsupported",
       "required": true,
       "description": "Where the nftables escalation runs. owned - the scope owns an active node, the escalation applies there; shared_unsupported - the scope has only shared platform nodes, which never take tenant host rules, so only the OpenResty normal action applies (use site access control)."
      },
      {
       "name": "document_sha256",
       "type": "string",
       "required": true
      },
      {
       "name": "created_at",
       "type": "string(date-time) | null(date-time)",
       "required": true,
       "description": "Null for the system default."
      },
      {
       "name": "updated_at",
       "type": "string(date-time) | null(date-time)",
       "required": true,
       "description": "Null for the system default."
      }
     ]
    },
    {
     "status": "401",
     "description": "Authentication required"
    },
    {
     "status": "403",
     "description": "Permission denied"
    },
    {
     "status": "404",
     "description": "Policy absent or outside actor scope"
    }
   ]
  },
