  {
   "operation_id": "setFirewallActionPolicyEnabled",
   "method": "PATCH",
   "path": "/v1/firewall-actions/policy",
   "summary": "Enable or disable the site's firewall action policy",
   "auth": [
    "bearer"
   ],
   "description": "Switches the site's own policy on or off without a new revision (If-Match is the current revision, the ETag stays). A disabled policy keeps its revisions and last-known-good document but is not delivered to the nodes; enabling delivers the current revision again. Only a revision mismatch is a 409; 404 while the site inherits the tenant default (it has no policy of its own to switch).",
   "permissions": [
    "firewall.manage"
   ],
   "params": [
    {
     "name": "target_scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "site_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    },
    {
