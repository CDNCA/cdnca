  {
   "operation_id": "inheritFirewallActionPolicy",
   "method": "DELETE",
   "path": "/v1/firewall-actions/policy",
   "summary": "Drop the site's own policy and inherit the tenant default again",
   "auth": [
    "bearer"
   ],
   "description": "Records the next revision as an inherited marker (revisions are never deleted). 404 when the site has no policy of its own.",
   "permissions": [
    "firewall.manage"
   ],
   "params": [
    {
     "name": "target_scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
