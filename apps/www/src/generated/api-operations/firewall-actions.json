 "operations": [
  {
   "operation_id": "getFirewallActionTenantDefault",
   "method": "GET",
   "path": "/v1/firewall-actions/default",
   "summary": "Read the tenant default firewall action",
   "auth": [
    "bearer"
   ],
   "description": "source system_default with revision 0 when the tenant never saved one.",
   "permissions": [
    "firewall.read"
   ],
   "params": [
    {
     "name": "target_scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Tenant default",
     "fields": [
      {
       "name": "normal_action",
       "type": "string: disconnect / return_page",
       "required": true
      },
      {
       "name": "escalated_action",
       "type": "string: nftables",
       "required": true
      },
      {
       "name": "engage_threshold",
       "type": "integer",
       "required": true
      },
      {
       "name": "recover_threshold",
       "type": "integer",
       "required": true
      },
      {
       "name": "recovery_windows",
       "type": "integer",
       "required": true
      },
      {
       "name": "block_networks",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "trusted_proxies",
       "type": "array<string>",
       "required": true
      },
      {
       "name": "trusted_crawlers",
       "type": "array<TrustedCrawler>",
       "required": true
      },
      {
       "name": "return_page",
       "type": "ReturnPage",
       "required": true
      },
      {
       "name": "tenant_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "source",
       "type": "string: tenant_default / system_default",
       "required": true
      },
      {
       "name": "revision",
       "type": "integer",
       "required": true,
       "description": "0 when never saved (the system default)."
      },
      {
       "name": "inheriting_site_count",
       "type": "integer",
       "required": true,
       "description": "Live sites without a policy of their own."
      },
      {
       "name": "updated_at",
       "type": "string(date-time) | null(date-time)",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "Invalid policy or request metadata"
    },
    {
     "status": "401",
     "description": "Authentication required"
    },
    {
     "status": "403",
     "description": "Permission denied"
    },
    {
     "status": "404",
     "description": "Policy absent or outside actor scope"
    }
   ]
  },
