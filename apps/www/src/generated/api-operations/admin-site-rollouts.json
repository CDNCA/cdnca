{
 "id": "admin-site-rollouts",
 "prefix": "/v1/admin/site-rollouts",
 "operations": [
  {
   "operation_id": "listAdminSiteRollouts",
   "method": "GET",
   "path": "/v1/admin/site-rollouts",
   "summary": "List rollouts for one tenant scope",
   "auth": [
    "bearer"
   ],
   "permissions": [
    "edge_publications.read"
   ],
   "params": [
    {
     "name": "scope_id",
     "in": "query",
     "type": "string(uuid)",
     "required": true,
     "description": "Platform route target tenant access-scope UUID."
    },
    {
     "name": "limit",
     "in": "query",
     "type": "integer"
    },
    {
     "name": "cursor",
     "in": "query",
     "type": "string",
     "description": "Versioned base64url HMAC-SHA256 envelope returned by the immediately preceding page. It is bound to audience, resolved tenant scope, resource kind, and the rollout ID for deployment pages. It cannot be reused across those boundaries or modified."
    }
   ],
   "responses": [
    {
     "status": "200",
     "description": "Stable platform rollout page.",
     "fields": [
      {
       "name": "items",
       "type": "array<AdminRollout>",
       "required": true
      },
      {
       "name": "next_cursor",
       "type": "string",
       "description": "Opaque authenticated pagination state. Clients must not parse or construct it."
      }
     ]
    },
    {
     "status": "400",
     "description": "Invalid UUID, RFC3339 value, enum, cursor, header, query, or JSON body."
    },
    {
     "status": "401",
     "description": "Authentication is missing or invalid."
    },
    {
     "status": "403",
     "description": "Wrong audience, missing permission, or tenant scope override."
    },
    {
     "status": "503",
     "description": "Storage, signing, cancellation, response validation, or another internal dependency is unavailable."
    }
   ]
  },
  {
   "operation_id": "reconcileAdminNodeConfiguration",
   "method": "POST",
   "path": "/v1/admin/site-rollouts/reconciliations",
   "summary": "Record the configuration proven to be active after an uncertain deployment result",
   "auth": [
    "bearer"
   ],
   "description": "Clears the rollback_failed reconciliation gate only when the named node, tenant scope, source deployment attempt, and observed immutable config all match persisted facts. It also permits operator-confirmed recovery of a legacy failed apply only when the deployment artifact, previous identity, fresh mTLS heartbeat pointer chain, missing current/loaded identity, stopped conservative OpenResty projection, and absence of active deployments all agree. That recovery moves only the version pointers; the next healthy publication establishes the current immutable identity. The append-only reconciliation record, live IAM authorization, node-state update, and audit event commit atomically. Retrying with the same Idempotency-Key returns the same fact; changing the payload with that key returns 409.",
   "permissions": [
    "edge_publications.manage"
   ],
   "params": [
    {
     "name": "Idempotency-Key",
     "in": "header",
     "type": "string",
     "required": true,
     "description": "Stable for the frozen business payload. Request, correlation, trace, and task identifiers may change on an identical retry."
    },
    {
     "name": "X-Request-ID",
     "in": "header",
     "type": "string(uuid)",
     "required": true
    },
    {
     "name": "Traceparent",
     "in": "header",
     "type": "string",
     "required": true
    },
    {
     "name": "X-Correlation-ID",
     "in": "header",
     "type": "string(uuid)",
     "description": "Defaults to X-Request-ID when omitted."
    },
    {
     "name": "X-Task-ID",
     "in": "header",
     "type": "string"
    }
   ],
   "body": {
    "content_types": [
     "application/json"
    ],
    "required": true,
    "fields": [
     {
      "name": "configuration_scope_id",
      "type": "string(uuid)",
      "required": true
     },
     {
      "name": "node_id",
      "type": "string(uuid)",
      "required": true
     },
     {
      "name": "source_deployment_id",
      "type": "string(uuid)",
      "required": true
     },
     {
      "name": "source_deployment_attempt",
      "type": "integer(int32)",
      "required": true
     },
     {
      "name": "observed_config_version_id",
      "type": "string(uuid) | null",
      "required": true
     },
     {
      "name": "resolution",
      "type": "string: agent_observed / operator_confirmed",
      "required": true
     },
     {
      "name": "evidence",
      "type": "string",
      "required": true
     }
    ]
   },
   "responses": [
    {
     "status": "201",
     "description": "Created reconciliation fact, or the stored result of an identical retry.",
     "fields": [
      {
       "name": "id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "node_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "configuration_scope_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "source_deployment_id",
       "type": "string(uuid)",
       "required": true
      },
      {
       "name": "source_deployment_attempt",
       "type": "integer(int32)",
       "required": true
      },
      {
       "name": "previous_config_version_id",
       "type": "string(uuid) | null",
       "required": true
      },
      {
       "name": "current_config_version_id",
       "type": "string(uuid) | null",
       "required": true
      },
      {
       "name": "resolution",
       "type": "string: agent_observed / operator_confirmed",
       "required": true
      },
      {
       "name": "reconciliation_required",
       "type": "boolean",
       "required": true
      },
      {
       "name": "reconciled_at",
       "type": "string(date-time)",
       "required": true
      }
     ]
    },
    {
     "status": "400",
     "description": "Invalid UUID, RFC3339 value, enum, cursor, header, query, or JSON body."
    },
    {
     "status": "401",
     "description": "Authentication is missing or invalid."
    },
    {
     "status": "403",
     "description": "Wrong audience, missing permission, or tenant scope override."
    },
    {
     "status": "404",
     "description": "Resource is absent in the authorized tenant scope. Cross-tenant IDs use the same response."
    },
    {
     "status": "409",
     "description": "Idempotency, target snapshot, rollout state, active deployment, or retry conflict."
    },
    {
     "status": "503",
     "description": "Storage, signing, cancellation, response validation, or another internal dependency is unavailable."
    }
   ]
  },
