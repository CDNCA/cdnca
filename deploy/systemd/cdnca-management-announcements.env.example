# Production-only. Store the real key in a root-owned 0600 EnvironmentFile.
ANNOUNCEMENT_ENABLED=true
ANNOUNCEMENT_EXTERNAL_CHANNEL=disabled
ANNOUNCEMENT_CURSOR_ACTIVE_KEY_ID=announcement-YYYYMMDD
# Replace with canonical padded Base64 for a random 32-64 byte key.
ANNOUNCEMENT_CURSOR_KEYS_JSON={"announcement-YYYYMMDD":"REPLACE_WITH_CANONICAL_PADDED_BASE64"}
