CONTROL_UPGRADE_TARGET=systemd
CONTROL_UPGRADE_INSTALLATION_ID_FILE=/etc/cdnca/control-upgrade/installation-id
CONTROL_UPGRADE_TRUST_FILE=/etc/cdnca/control-upgrade/upgrade-trust.json
CONTROL_UPGRADE_INTERNAL_TOKEN_FILE=/etc/cdnca/control-upgrade/internal-token

CONTROL_UPGRADE_PLAN_SOURCE_URL=https://control.internal.example/v1/internal/control-upgrade/plan
CONTROL_UPGRADE_PLAN_SOURCE_CA_FILE=/etc/cdnca/control-upgrade/plan-source-ca.pem
CONTROL_UPGRADE_PLAN_SOURCE_CERT_FILE=/etc/cdnca/control-upgrade/plan-source-client.pem
CONTROL_UPGRADE_PLAN_SOURCE_KEY_FILE=/etc/cdnca/control-upgrade/plan-source-client-key.pem
CONTROL_UPGRADE_PLAN_SOURCE_TIMEOUT=10s
CONTROL_UPGRADE_PLAN_SOURCE_MAX_BYTES=1048576
CONTROL_UPGRADE_POLL_INTERVAL=5s

CONTROL_UPGRADE_EXPECTED_REPLICAS=3
CONTROL_UPGRADE_QUORUM=2
CONTROL_UPGRADE_STATE_DIR=/var/lib/cdnca-control-upgrade/state
CONTROL_UPGRADE_PLAN_LKG_FILE=/var/lib/cdnca-control-upgrade/lkg/plan.bundle
CONTROL_UPGRADE_RELEASE_ROOT=/opt/cdnca/control-api/releases
CONTROL_UPGRADE_CURRENT_LINK=/opt/cdnca/control-api/current
CONTROL_UPGRADE_SYSTEMD_UNIT=cdnca-control-api.service

CONTROL_UPGRADE_DRAIN_URL=https://control.internal.example/v1/internal/control-upgrade/drain
CONTROL_UPGRADE_RESUME_URL=https://control.internal.example/v1/internal/control-upgrade/resume
CONTROL_UPGRADE_HEALTH_URL=https://control.internal.example/v1/internal/control-upgrade/health
CONTROL_UPGRADE_CURRENT_VERSION=1.0.0
CONTROL_UPGRADE_PROTOCOL_VERSION=2
CONTROL_UPGRADE_STEP_TIMEOUT=3m
CONTROL_UPGRADE_HEALTH_TIMEOUT=10m
