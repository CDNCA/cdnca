# /etc/cdnca-control/optional.env — optional control-api runtimes (market buyer,
# plugin installation). Mode 0600 root:root.
#
# install-control.sh does not write this file: control.env, runtime-extra.env and
# certificate-runtime/environment.env are generated and partly pinned by receipts,
# so operator settings live here and are loaded by a drop-in AFTER them:
#   install -d -m 0755 /etc/systemd/system/cdnca-control-api.service.d
#   install -m 0644 cdnca-control-api-optional.conf.example \
#     /etc/systemd/system/cdnca-control-api.service.d/60-optional.conf
#   systemctl daemon-reload && systemctl restart cdnca-control-api
#   curl -fsS http://127.0.0.1:8080/health/ready
# Every group below is off when its first key is unset; a half-filled group makes
# control-api refuse to start (check journalctl -u cdnca-control-api).

# --- Market (node market buyer/leaf, plugin market buyer) ---------------------
# MARKET_RUNTIME_ENABLED=true
# Market host member endpoint (mTLS with the installation client certificate).
# MARKET_URL=https://my.cdnca.com
# install-control.sh writes MARKET_MTLS_TRANSPORT=tunnel into control.env: mTLS rides
# wss://<MARKET_URL host>:443/mtls/v1/tunnel/market-member through the CDN. Set =direct here
# to dial MARKET_URL itself; MARKET_MTLS_TUNNEL_URL=https://host[:port] moves the tunnel entrance
# (PLUGIN_RUNTIME_MTLS_TRANSPORT=tunnel likewise; _TUNNEL_URL for the plugin installation runtime).
# MARKET_STATE_DIR=/var/lib/cdnca-control/market
# Defaults to the PLUGIN_RUNTIME_CLIENT_* pair below when unset.
# MARKET_CLIENT_CERT_FILE=/etc/cdnca-control/plugin-runtime/client.crt
# MARKET_CLIENT_KEY_FILE=/etc/cdnca-control/plugin-runtime/client.key
# Market grant/member-card verification keys published by the market host
# (public key of its MARKET_SIGNING_KEY_FILE): [{"key_id":"...","public_key":"<base64>"}]
# MARKET_KEYS_JSON=[{"key_id":"market-2026-10","public_key":"CHANGE_ME"}]
# MARKET_DISPLAY_NAME=
# CNAME domain handed to leaf sites; empty = market default.
# MARKET_LEAF_CNAME_DOMAIN=
# MARKET_TIMEZONE=Asia/Shanghai
# Optional ICP filing checker for leaf domains.
# MARKET_ICP_PROVIDER=
# MARKET_ICP_KEY_FILE=
# Answer market probes on node default_server ports (also needs market_probe on nodes).
# MARKET_PROBE_ENABLED=false

# --- Plugin installation runtime (license-side mTLS, LICENSE_PLUGIN_RUNTIME_MTLS_*) ---
# Needs LICENSE_SERVICE_URL (control.env). The client certificate is requested from
# the license host on first start into PLUGIN_RUNTIME_CLIENT_STATE_FILE's directory (0700).
# PLUGIN_RUNTIME_PROVIDER_URL=https://auth.cdnca.com:<port of LICENSE_PLUGIN_RUNTIME_MTLS_ADDRESS>
# PLUGIN_RUNTIME_PROJECTION_URL=https://auth.cdnca.com:<port of LICENSE_PLUGIN_RUNTIME_MTLS_ADDRESS>
# PLUGIN_RUNTIME_CLIENT_CERT_FILE=/etc/cdnca-control/plugin-runtime/client.crt
# PLUGIN_RUNTIME_CLIENT_PRIVATE_KEY_FILE=/etc/cdnca-control/plugin-runtime/client.key
# PLUGIN_RUNTIME_LICENSE_CA_FILE=/etc/cdnca-control/plugin-runtime/license-ca.crt
# PLUGIN_RUNTIME_CLIENT_STATE_FILE=/etc/cdnca-control/plugin-runtime/client-state.json
# Only when the license business port certificate is not in the system trust store.
# PLUGIN_RUNTIME_BOOTSTRAP_SERVER_CA_FILE=
