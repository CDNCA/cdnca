[Unit]
Description=CDNCA signed control-plane systemd upgrade runner
Documentation=file:/usr/share/doc/cdnca/control-upgrade-systemd.md
After=network-online.target cdnca-control-api.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/cdnca/control-upgrade-runner.env
ExecStartPre=/usr/bin/test -x /usr/local/libexec/cdnca/control-upgrade-runner
ExecStartPre=/usr/bin/test -s ${CONTROL_UPGRADE_INSTALLATION_ID_FILE}
ExecStartPre=/usr/bin/test -s ${CONTROL_UPGRADE_TRUST_FILE}
ExecStartPre=/usr/bin/test -s ${CONTROL_UPGRADE_INTERNAL_TOKEN_FILE}
ExecStartPre=/usr/bin/test -s ${CONTROL_UPGRADE_PLAN_SOURCE_CA_FILE}
ExecStartPre=/usr/bin/test -s ${CONTROL_UPGRADE_PLAN_SOURCE_CERT_FILE}
ExecStartPre=/usr/bin/test -s ${CONTROL_UPGRADE_PLAN_SOURCE_KEY_FILE}
ExecStartPre=/usr/bin/test -d ${CONTROL_UPGRADE_STATE_DIR}
ExecStartPre=/usr/bin/test -d /var/lib/cdnca-control-upgrade/lkg
ExecStart=/usr/local/libexec/cdnca/control-upgrade-runner
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/cdnca/control-upgrade /etc/cdnca/control-upgrade-runner.env
ReadWritePaths=/opt/cdnca/control-api /var/lib/cdnca-control-upgrade

[Install]
WantedBy=multi-user.target
