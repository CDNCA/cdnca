{
  "schema": "cdnca.theme/v1",
  "id": "default",
  "version": "1.0.0",
  "name": {"zh-CN": "默认主题", "zh-TW": "預設主題", "en-US": "Default"},
  "description": {"zh-CN": "平台默认外观。", "zh-TW": "平台預設外觀。", "en-US": "The platform's default look."},
  "layout_slots": {
    "login_layout": "split",
    "sidebar": "light"
  },
  "templates": {
    "styles": [
      {"selector": "body", "declarations": {"margin": "0", "background-color": "token:colorBgLayout", "color": "token:colorText", "font-family": "token:fontFamily", "font-size": "token:fontSize", "line-height": "token:lineHeight"}},
      {"selector": ".cf-page", "declarations": {"max-width": "560px", "margin": "80px auto", "padding": "32px 40px", "background-color": "token:colorBgContainer", "border-color": "token:colorBorderSecondary", "border-style": "solid", "border-width": "1px", "border-radius": "token:borderRadius"}},
      {"selector": ".cf-status", "declarations": {"margin": "0", "color": "token:colorPrimary", "font-size": "40px", "font-weight": "600"}},
      {"selector": ".cf-title", "declarations": {"margin": "8px 0 0", "font-size": "20px", "font-weight": "600"}},
      {"selector": ".cf-message", "declarations": {"margin": "12px 0 0", "color": "token:colorTextSecondary"}},
      {"selector": ".cf-footer", "declarations": {"margin": "24px 0 0", "color": "token:colorTextSecondary", "font-size": "12px"}},
      {"selector": ".cf-line", "declarations": {"margin": "8px 0 0"}}
    ],
    "error_page": "<!doctype html><html><head><title>{{title}}</title></head><body><main class=\"cf-page\"><p class=\"cf-status\">{{status}}</p><h1 class=\"cf-title\">{{title}}</h1><p class=\"cf-message\">{{message}}</p>{{#footer_text}}<p class=\"cf-footer\">{{footer_text}}</p>{{/footer_text}}</main></body></html>",
    "email": "<!doctype html><html><head><title>{{subject}}</title></head><body><main class=\"cf-page\"><h1 class=\"cf-title\">{{subject}}</h1>{{#lines}}<p class=\"cf-line\">{{.}}</p>{{/lines}}{{#footer_text}}<p class=\"cf-footer\">{{footer_text}}</p>{{/footer_text}}</main></body></html>"
  }
}
