{
  "schema": "cdnca.rule-pack/v1",
  "pack_id": "system/cc-basic",
  "version": "1.2.0",
  "layer": "system",
  "engine": "cc_v2",
  "engine_min_version": 2,
  "name": "CC 基础限速",
  "description": "",
  "params_schema": {
    "requests": {"type": "integer", "minimum": 10, "maximum": 10000, "bind": {"target": "cc.limit.requests", "rules": []}}
  },
  "exports": ["rate"],
  "rules": [
    {"id": "rate", "name": "单 IP 限速", "cc": {"rule_id": "", "priority": 0, "flow": "stop", "match": {}, "dimension": "client_ip",
      "limit": {"algorithm": "fixed_window", "requests": 100, "window_seconds": 10}, "action": {"kind": "temporary_ban", "ban_seconds": 600}}}
  ],
  "defaults": {"requests": 200}
}
