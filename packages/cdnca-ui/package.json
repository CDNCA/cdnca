    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "antd": "5.29.3",
    "dayjs": "1.11.21",
    "jsdom": "26.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
