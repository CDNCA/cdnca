# ngx_brotli's filter module only (no brotli_static), built as a static module
# and linked against the build base's system Brotli library (Alpine
# brotli-dev): upstream's config builds the deps/brotli submodule instead.
# The filter ordering is upstream's filter/config: right before gzip, so a
# Brotli-encoded response is never gzipped.
ngx_addon_name=ngx_brotli_filter
ngx_module_type=HTTP_FILTER
ngx_module_name=ngx_http_brotli_filter_module
ngx_module_incs=
ngx_module_deps=
ngx_module_srcs="$ngx_addon_dir/filter/ngx_http_brotli_filter_module.c"
ngx_module_libs="-lbrotlienc -lbrotlicommon -lm"

. auto/module

if [ "$ngx_module_link" != DYNAMIC ]; then
    if [ "$HTTP_GZIP" = YES ]; then
        next=ngx_http_gzip_filter_module
    else
        next=ngx_http_range_header_filter_module
    fi
    HTTP_FILTER_MODULES=`echo $HTTP_FILTER_MODULES \
                         | sed "s/$ngx_module_name//" \
                         | sed "s/$next/$next $ngx_module_name/"`
fi

CFLAGS="$CFLAGS -Wno-deprecated-declarations"
have=NGX_HTTP_BROTLI_FILTER . auto/have
