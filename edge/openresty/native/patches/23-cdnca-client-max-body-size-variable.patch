+/*
+ * CDNCA: the effective client_max_body_size of the request's location.
+ * A static value (0 = unlimited) is returned as configured.  A value with
+ * variables must evaluate to a positive size; empty, malformed, overflowing
+ * or zero values are errors (the caller rejects the request with 500), so a
+ * routing failure can never turn into an unlimited upload.
+ */
+
+ngx_int_t
+ngx_http_core_client_max_body_size(ngx_http_request_t *r, off_t *max)
+{
+    off_t                      size;
+    ngx_str_t                  value;
+    ngx_http_core_loc_conf_t  *clcf;
+
+    clcf = ngx_http_get_module_loc_conf(r, ngx_http_core_module);
+
+    if (clcf->client_max_body_size_value == NULL) {
+        *max = clcf->client_max_body_size;
+        return NGX_OK;
+    }
+
+    if (ngx_http_complex_value(r, clcf->client_max_body_size_value, &value)
+        != NGX_OK)
+    {
+        return NGX_ERROR;
+    }
+
+    size = ngx_parse_offset(&value);
+
+    if (size == NGX_ERROR || size == 0) {
+        ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
+                      "invalid client_max_body_size value \"%V\"", &value);
+        return NGX_ERROR;
+    }
+
+    *max = size;
 
     return NGX_OK;
 }
