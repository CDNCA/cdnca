+static char *
+ngx_http_core_client_max_body_size_slot(ngx_conf_t *cf, ngx_command_t *cmd,
+    void *conf)
+{
+    ngx_http_core_loc_conf_t *clcf = conf;
+
+    ngx_str_t                         *value;
+    ngx_http_compile_complex_value_t   ccv;
+
+    value = cf->args->elts;
+
+    if (clcf->client_max_body_size != NGX_CONF_UNSET
+        || ngx_http_script_variables_count(&value[1]) == 0)
+    {
+        return ngx_conf_set_off_slot(cf, cmd, conf);
+    }
+
+    clcf->client_max_body_size_value = ngx_palloc(cf->pool,
+                                             sizeof(ngx_http_complex_value_t));
+    if (clcf->client_max_body_size_value == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_memzero(&ccv, sizeof(ngx_http_compile_complex_value_t));
+
+    ccv.cf = cf;
+    ccv.value = &value[1];
+    ccv.complex_value = clcf->client_max_body_size_value;
+
+    if (ngx_http_compile_complex_value(&ccv) != NGX_OK) {
+        return NGX_CONF_ERROR;
+    }
+
+    /*
+     * the static field only marks the directive as set; readers of
+     * the field that bypass ngx_http_core_client_max_body_size() see
+     * the largest limit rather than "unlimited" (0)
+     */
+
+    clcf->client_max_body_size = NGX_MAX_OFF_T_VALUE;
+
+    return NGX_CONF_OK;
 }
 
 
