+    if (conf->client_max_body_size == NGX_CONF_UNSET) {
+        conf->client_max_body_size_value = prev->client_max_body_size_value;
+    }
+
     ngx_conf_merge_off_value(conf->client_max_body_size,
                               prev->client_max_body_size, 1 * 1024 * 1024);
     ngx_conf_merge_size_value(conf->client_body_buffer_size,
@@ -4819,6 +4880,51 @@ ngx_http_core_limit_except(ngx_conf_t *cf, ngx_command
