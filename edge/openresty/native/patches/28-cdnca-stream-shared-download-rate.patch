+static char *
+ngx_stream_proxy_download_rate_shared(ngx_conf_t *cf, ngx_command_t *cmd,
+    void *conf)
+{
+    ngx_stream_proxy_srv_conf_t *pscf = conf;
+
+    u_char                              *p;
+    ssize_t                              size;
+    ngx_str_t                           *value, name, s;
+    ngx_stream_proxy_rate_zone_t        *zone;
+    ngx_stream_compile_complex_value_t   ccv;
+
+    if (pscf->download_rate_zone != NGX_CONF_UNSET_PTR) {
+        return "is duplicate";
+    }
+
+    value = cf->args->elts;
+
+    p = (u_char *) ngx_strlchr(value[1].data, value[1].data + value[1].len,
+                               ':');
+    if (p == NULL || p == value[1].data) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "invalid zone \"%V\"", &value[1]);
+        return NGX_CONF_ERROR;
+    }
+
+    name.data = value[1].data;
+    name.len = p - value[1].data;
+
+    s.data = p + 1;
+    s.len = value[1].data + value[1].len - s.data;
+
+    size = ngx_parse_size(&s);
+
+    if (size == NGX_ERROR || size < (ssize_t) (8 * ngx_pagesize)) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "invalid zone size \"%V\"", &value[1]);
+        return NGX_CONF_ERROR;
+    }
+
+    pscf->download_rate_zone = ngx_shared_memory_add(cf, &name, size,
+                                                     &ngx_stream_proxy_module);
+    if (pscf->download_rate_zone == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    if (pscf->download_rate_zone->data == NULL) {
+        zone = ngx_pcalloc(cf->pool, sizeof(ngx_stream_proxy_rate_zone_t));
+        if (zone == NULL) {
+            return NGX_CONF_ERROR;
+        }
+
+        pscf->download_rate_zone->init = ngx_stream_proxy_rate_init_zone;
+        pscf->download_rate_zone->data = zone;
+    }
+
+    pscf->download_rate_key = ngx_palloc(cf->pool,
+                                         sizeof(ngx_stream_complex_value_t));
+    if (pscf->download_rate_key == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_memzero(&ccv, sizeof(ngx_stream_compile_complex_value_t));
+
+    ccv.cf = cf;
+    ccv.value = &value[2];
+    ccv.complex_value = pscf->download_rate_key;
+
+    if (ngx_stream_compile_complex_value(&ccv) != NGX_OK) {
+        return NGX_CONF_ERROR;
     }
 
     return NGX_CONF_OK;
 }
 
 
+static ngx_int_t
+ngx_stream_proxy_rate_init_zone(ngx_shm_zone_t *shm_zone, void *data)
+{
+    ngx_stream_proxy_rate_zone_t  *ozone = data;
+
+    size_t                         len;
+    ngx_stream_proxy_rate_zone_t  *zone;
+
+    zone = shm_zone->data;
+
+    if (ozone) {
+        zone->sh = ozone->sh;
+        zone->shpool = ozone->shpool;
+        return NGX_OK;
+    }
+
+    zone->shpool = (ngx_slab_pool_t *) shm_zone->shm.addr;
+
+    if (shm_zone->shm.exists) {
+        zone->sh = zone->shpool->data;
+        return NGX_OK;
+    }
+
+    zone->sh = ngx_slab_alloc(zone->shpool,
+                              sizeof(ngx_stream_proxy_rate_shctx_t));
+    if (zone->sh == NULL) {
+        return NGX_ERROR;
+    }
+
+    zone->shpool->data = zone->sh;
+
+    ngx_rbtree_init(&zone->sh->rbtree, &zone->sh->sentinel,
+                    ngx_str_rbtree_insert_value);
+
+    ngx_queue_init(&zone->sh->queue);
+
+    len = sizeof(" in proxy_download_rate_shared zone \"\"")
+          + shm_zone->shm.name.len;
+
+    zone->shpool->log_ctx = ngx_slab_alloc(zone->shpool, len);
+    if (zone->shpool->log_ctx == NULL) {
+        return NGX_ERROR;
+    }
+
+    ngx_sprintf(zone->shpool->log_ctx,
+                " in proxy_download_rate_shared zone \"%V\"%Z",
+                &shm_zone->shm.name);
+
+    zone->shpool->log_nomem = 0;
+
+    return NGX_OK;
+}
+
+
+/*
+ * Refills the bucket of the session's key at rate bytes per second (a new
+ * key starts full), takes consume bytes and returns the bytes left (negative
+ * when sessions of other workers took the same tokens).  Keys idle for a
+ * minute are dropped; with the zone full the least recently used keys go.
+ * NGX_DECLINED: no memory for the key, the session keeps its own rate.
+ */
+
+static ngx_int_t
+ngx_stream_proxy_rate_bucket(ngx_stream_session_t *s,
+    ngx_stream_proxy_srv_conf_t *pscf, size_t rate, off_t consume,
+    off_t *tokens)
+{
+    size_t                          n;
+    uint32_t                        hash;
+    ngx_str_t                      *key;
+    ngx_uint_t                      i;
+    ngx_msec_t                      now;
+    ngx_queue_t                    *q;
+    ngx_msec_int_t                  elapsed;
+    ngx_str_node_t                 *sn;
+    ngx_stream_proxy_rate_node_t   *node, *old;
+    ngx_stream_proxy_rate_zone_t   *zone;
+
+    zone = pscf->download_rate_zone->data;
+    key = &s->upstream->download_rate_key;
+    hash = ngx_crc32_short(key->data, key->len);
+    now = ngx_current_msec;
+
+    ngx_shmtx_lock(&zone->shpool->mutex);
+
+    sn = ngx_str_rbtree_lookup(&zone->sh->rbtree, key, hash);
+
+    if (sn == NULL) {
+
+        for (i = 0; i < 2 && !ngx_queue_empty(&zone->sh->queue); i++) {
+            q = ngx_queue_last(&zone->sh->queue);
+            old = ngx_queue_data(q, ngx_stream_proxy_rate_node_t, queue);
+
+            if ((ngx_msec_int_t) (now - old->last) < 60000) {
+                break;
+            }
+
+            ngx_queue_remove(q);
+            ngx_rbtree_delete(&zone->sh->rbtree, &old->sn.node);
+            ngx_slab_free_locked(zone->shpool, old);
+        }
+
+        n = offsetof(ngx_stream_proxy_rate_node_t, data) + key->len;
+
+        node = ngx_slab_alloc_locked(zone->shpool, n);
+
+        while (node == NULL && !ngx_queue_empty(&zone->sh->queue)) {
+            q = ngx_queue_last(&zone->sh->queue);
+            old = ngx_queue_data(q, ngx_stream_proxy_rate_node_t, queue);
+
+            ngx_queue_remove(q);
+            ngx_rbtree_delete(&zone->sh->rbtree, &old->sn.node);
+            ngx_slab_free_locked(zone->shpool, old);
+
+            node = ngx_slab_alloc_locked(zone->shpool, n);
+        }
+
+        if (node == NULL) {
+            ngx_shmtx_unlock(&zone->shpool->mutex);
+            return NGX_DECLINED;
+        }
+
+        ngx_memcpy(node->data, key->data, key->len);
+
+        node->sn.node.key = hash;
+        node->sn.str.len = key->len;
+        node->sn.str.data = node->data;
+        node->last = now;
+        node->tokens = (int64_t) rate * 1000;
+
+        ngx_rbtree_insert(&zone->sh->rbtree, &node->sn.node);
+
+    } else {
+        node = (ngx_stream_proxy_rate_node_t *) sn;
+
+        /* worker clocks differ slightly: never refill backwards */
+
+        elapsed = (ngx_msec_int_t) (now - node->last);
+
+        if (elapsed > 0) {
+            if (elapsed > 1000) {
+                elapsed = 1000;
+            }
+
+            node->tokens += (int64_t) rate * elapsed;
+
+            if (node->tokens > (int64_t) rate * 1000) {
+                node->tokens = (int64_t) rate * 1000;
+            }
+
+            node->last = now;
+        }
+
+        ngx_queue_remove(&node->queue);
+    }
+
+    ngx_queue_insert_head(&zone->sh->queue, &node->queue);
+
+    node->tokens -= (int64_t) consume * 1000;
+
+    *tokens = (off_t) (node->tokens / 1000);
+
+    ngx_shmtx_unlock(&zone->shpool->mutex);
+
+    return NGX_OK;
+}
