+
+
+/*
+ * gzip_comp_level with variables (CDNCA): evaluated once per compressed
+ * response. An empty value is the inherited static level (an outer
+ * gzip_comp_level, default 1); a value that is not 1-9 is logged and also
+ * uses it. Without variables the stock bounded number slot applies.
+ */
+
+static char *
+ngx_http_gzip_comp_level(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    ngx_http_gzip_conf_t  *gcf = conf;
+
+    ngx_str_t                         *value;
+    ngx_http_compile_complex_value_t   ccv;
+
+    value = cf->args->elts;
+
+    if (gcf->level_value != NULL) {
+        return "is duplicate";
+    }
+
+    if (ngx_http_script_variables_count(&value[1]) == 0) {
+        return ngx_conf_set_num_slot(cf, cmd, conf);
+    }
+
+    if (gcf->level != NGX_CONF_UNSET) {
+        return "is duplicate";
+    }
+
+    gcf->level_value = ngx_palloc(cf->pool, sizeof(ngx_http_complex_value_t));
+    if (gcf->level_value == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_memzero(&ccv, sizeof(ngx_http_compile_complex_value_t));
+
+    ccv.cf = cf;
+    ccv.value = &value[1];
+    ccv.complex_value = gcf->level_value;
+
+    if (ngx_http_compile_complex_value(&ccv) != NGX_OK) {
+        return NGX_CONF_ERROR;
+    }
+
+    return NGX_CONF_OK;
 }
+
+
+static ngx_int_t
+ngx_http_gzip_level(ngx_http_request_t *r, ngx_http_gzip_conf_t *conf)
+{
+    ngx_int_t  level;
+    ngx_str_t  value;
+
+    if (conf->level_value == NULL) {
+        return conf->level;
+    }
+
+    if (ngx_http_complex_value(r, conf->level_value, &value) != NGX_OK) {
+        return conf->level;
+    }
+
+    if (value.len == 0) {
+        return conf->level;
+    }
+
+    level = ngx_atoi(value.data, value.len);
+
+    if (level < 1 || level > 9) {
+        ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
+                      "invalid gzip_comp_level value \"%V\"", &value);
+        return conf->level;
+    }
+
+    return level;
+}
