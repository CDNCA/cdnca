+
+/* CDNCA: brotli_comp_level with variables, evaluated once per compressed
+   response. An empty value is the inherited static quality (an outer
+   brotli_comp_level, default 6); a value outside 0-11 is logged and also uses
+   it. Without variables the stock bounded number slot applies. */
+static char* ngx_http_brotli_comp_level(ngx_conf_t* cf, ngx_command_t* cmd,
+                                        void* conf) {
+  ngx_http_brotli_conf_t* bcf = conf;
+  ngx_str_t* value;
+  ngx_http_compile_complex_value_t ccv;
+
+  value = cf->args->elts;
+  if (bcf->quality_value != NULL) return "is duplicate";
+  if (ngx_http_script_variables_count(&value[1]) == 0) {
+    return ngx_conf_set_num_slot(cf, cmd, conf);
+  }
+  if (bcf->quality != NGX_CONF_UNSET) return "is duplicate";
+
+  bcf->quality_value = ngx_palloc(cf->pool, sizeof(ngx_http_complex_value_t));
+  if (bcf->quality_value == NULL) return NGX_CONF_ERROR;
+  ngx_memzero(&ccv, sizeof(ngx_http_compile_complex_value_t));
+  ccv.cf = cf;
+  ccv.value = &value[1];
+  ccv.complex_value = bcf->quality_value;
+  if (ngx_http_compile_complex_value(&ccv) != NGX_OK) return NGX_CONF_ERROR;
+  return NGX_CONF_OK;
+}
+
+static ngx_int_t ngx_http_brotli_quality(ngx_http_request_t* r,
+                                         ngx_http_brotli_conf_t* conf) {
+  ngx_int_t quality;
+  ngx_str_t value;
+
+  if (conf->quality_value == NULL) return conf->quality;
+  if (ngx_http_complex_value(r, conf->quality_value, &value) != NGX_OK) {
+    return conf->quality;
+  }
+  if (value.len == 0) return conf->quality;
+  quality = ngx_atoi(value.data, value.len);
+  if (quality < BROTLI_MIN_QUALITY || quality > BROTLI_MAX_QUALITY) {
+    ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
+                  "invalid brotli_comp_level value \"%V\"", &value);
+    return conf->quality;
+  }
+  return quality;
+}
