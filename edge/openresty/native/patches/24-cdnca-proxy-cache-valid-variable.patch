+/*
+ * CDNCA (patch 24): a time with variables is evaluated per response.  An
+ * empty value means the entry does not apply (the next entry, e.g. a later
+ * "any", is tried; none left = not cached), so one variable per status can
+ * be left unset.  "0" means "do not cache this status".  A malformed value
+ * is logged and means 0, so a routing failure can only make a response
+ * uncacheable, never cache it for a wrong time.
+ */
+
+#define NGX_HTTP_FILE_CACHE_VALID_SKIP  ((time_t) -1)
+
+static time_t
+ngx_http_file_cache_valid_value(ngx_http_request_t *r,
+    ngx_http_cache_valid_t *valid)
 {
+    time_t     time;
+    ngx_str_t  value;
+
+    if (valid->value == NULL) {
+        return valid->valid;
+    }
+
+    if (r == NULL
+        || ngx_http_complex_value(r, valid->value, &value) != NGX_OK)
+    {
+        return 0;
+    }
+
+    if (value.len == 0) {
+        return NGX_HTTP_FILE_CACHE_VALID_SKIP;
+    }
+
+    time = ngx_parse_time(&value, 1);
+
+    if (time == (time_t) NGX_ERROR) {
+        ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
+                      "invalid proxy_cache_valid time \"%V\"", &value);
+        return 0;
+    }
+
+    return time;
+}
