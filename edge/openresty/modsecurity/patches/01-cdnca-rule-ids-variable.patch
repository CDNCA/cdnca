+static ngx_int_t
+ngx_http_modsecurity_add_variables(ngx_conf_t *cf)
+{
+    ngx_http_variable_t  *var, *v;
+
+    for (v = ngx_http_modsecurity_vars; v->name.len; v++) {
+        var = ngx_http_add_variable(cf, &v->name, v->flags);
+        if (var == NULL) {
+            return NGX_ERROR;
+        }
+
+        var->get_handler = v->get_handler;
+        var->data = v->data;
+    }
+
+    return NGX_OK;
+}
+
+
+static ngx_int_t
+ngx_http_modsecurity_rule_ids_variable(ngx_http_request_t *r,
+    ngx_http_variable_value_t *v, uintptr_t data)
+{
+    size_t                       i, n;
+    u_char                      *p;
+    int64_t                     *ids;
+    ngx_http_modsecurity_ctx_t  *ctx;
+
+    ctx = ngx_http_modsecurity_get_module_ctx(r);
+
+    if (ctx == NULL || ctx->modsec_transaction == NULL) {
+        v->not_found = 1;
+        return NGX_OK;
+    }
+
+    n = msc_get_rules_messages_size(ctx->modsec_transaction);
+    ids = NULL;
+
+    if (n > 0) {
+        ids = ngx_palloc(r->pool, n * sizeof(int64_t));
+        if (ids == NULL) {
+            return NGX_ERROR;
+        }
+
+        n = msc_get_rules_messages_rule_ids(ctx->modsec_transaction, ids, n);
+    }
 
+    p = ngx_pnalloc(r->pool, 1 + n * (NGX_INT64_LEN + 1));
+    if (p == NULL) {
+        return NGX_ERROR;
+    }
 
+    v->data = p;
+    *p++ = ',';
+
+    for (i = 0; i < n; i++) {
+        p = ngx_sprintf(p, "%L,", ids[i]);
+    }
+
+    v->len = p - v->data;
+    v->valid = 1;
+    v->no_cacheable = 1;
+    v->not_found = 0;
+
+    return NGX_OK;
+}
+
