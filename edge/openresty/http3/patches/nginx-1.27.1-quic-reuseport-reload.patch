+static char *
+ngx_quic_bpf_init_conf(ngx_cycle_t *cycle, void *conf)
+{
+    ngx_quic_bpf_conf_t *bcf = conf;
+
+    u_char               *p;
+    size_t                len;
+    ngx_quic_bpf_conf_t  *obcf;
